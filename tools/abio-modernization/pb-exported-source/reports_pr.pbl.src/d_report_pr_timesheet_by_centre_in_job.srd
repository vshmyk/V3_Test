 retrieve="SELECT timesheet.job, 
       timesheet.employee, 
       timesheet.work_date, 
       timesheet.timesheet_item, 
       timesheet.area, 
       timesheet.work_order, 
       area.description                                             AS        area_description, 
       dbo.uf_client_po_for_area(area.book, area.job, area.area)    AS        area_client_po, 
       timesheet.centre, 
       centre.description                                           AS        centre_description, 
       timesheet.trade_union, 
       timesheet.occupation, 
       Isnull(occupation.description, tm_employee_rate.description) AS        occupation_description, 
       timesheet.employment_type, 
       timesheet.shift, 
       timesheet.reg_hour, 
       timesheet.tah_hour, 
       timesheet.ovr_hour, 
       timesheet.travel_hour, 
       timesheet.loa_hour, 
       timesheet.mileage_hour, 
       (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.reg_earn ELSE 0 END) AS reg_earn, 
       (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.tah_earn ELSE 0 END) AS tah_earn, 
       (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.ovr_earn ELSE 0 END) AS ovr_earn, 
       (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.travel_earn ELSE 0 END) AS travel_earn, 
       (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.loa ELSE 0 END) AS loa, 
       (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.mileage ELSE 0 END) AS mileage, 
       (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.turnaround ELSE 0 END) AS turnaround, 
       (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.meal ELSE 0 END) AS meal, 
       (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.taxi ELSE 0 END) AS taxi, 
       (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.retro ELSE 0 END) AS retro, 
       (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.other_taxable_pay ELSE 0 END) AS other_taxable_pay, 
       (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.site_allowance ELSE 0 END) AS site_allowance, 
       timesheet.equipment, 
       timesheet.gl_account,  
       (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.fringe ELSE 0 END) AS fringe, 
       (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.total ELSE 0 END) AS total, 
       (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.gst_amount ELSE 0 END) AS gst_amount, 
       employee.NAME, 
       timesheet.timesheet_status, 
       (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.vehicle_allowance_paid ELSE 0 END) AS vehicle_allowance_paid, 
       (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.pay_in_lieu_of_notice ELSE 0 END) AS pay_in_lieu_of_notice, 
       timesheet.memo, 
       (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.retention_earn ELSE 0 END) AS retention_earn, 
       (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.recruitment_cost ELSE 0 END) AS recruitment_cost,
       employee.badge_no,
       employee.alternate_id,
		 Isnull(region.region, '')                                                                              AS region,
		 Isnull(region.description, '')                                                                         AS region_description,
		 Isnull(parent_region.region, '')                                                                       AS parent_region,
		 Isnull(parent_region.description, '')                                                                  AS parent_region_description,
       IsNull(job.client, '') AS client,
       IsNull(job.province, '') AS job_province
FROM   timesheet WITH (NOLOCK)
       INNER JOIN job WITH (NOLOCK)
               ON job.book = timesheet.book 
                  AND job.job = timesheet.job 
		 LEFT OUTER JOIN region
						  ON job.region = region.region
		 LEFT OUTER JOIN region parent_region
						  ON region.parent_region = parent_region.region
       LEFT OUTER JOIN tm_employee_rate 
                    ON tm_employee_rate.book = job.book 
                       AND tm_employee_rate.labour_rate_type = 
                           job.labour_rate_type 
                       AND ( tm_employee_rate.shift = timesheet.shift 
                              OR tm_employee_rate.shift = 'A' ) 
                       AND tm_employee_rate.employee = timesheet.employee 
                       AND tm_employee_rate.effective_date <= 
                           timesheet.work_date 
                       AND tm_employee_rate.expiry_date >= timesheet.work_date, 
       employee WITH (NOLOCK), 
       area WITH (NOLOCK), 
       centre WITH (NOLOCK), 
       occupation WITH (NOLOCK) 
WHERE  employee.book = timesheet.book 
       AND employee.employee = timesheet.employee 
       AND area.book = timesheet.book 
       AND area.job = timesheet.job 
       AND area.area = timesheet.area 
       AND centre.book = timesheet.book 
       AND centre.job = timesheet.job 
       AND centre.area = timesheet.area 
       AND centre.centre = timesheet.centre 
       AND occupation.book = timesheet.book 
       AND occupation.trade_union = timesheet.trade_union 
       AND occupation.occupation = timesheet.occupation 
       AND ( timesheet.book = :as_company ) 
       AND ( timesheet.file_type IN ( :as_file_type1, :as_file_type2 ) ) 
       AND ( timesheet.job BETWEEN :as_from_job AND :as_to_job ) 
       AND ( timesheet.area BETWEEN :as_from_area AND :as_to_area ) 
       AND ( timesheet.centre BETWEEN :as_from_centre AND :as_to_centre ) 
       AND ( timesheet.pr_yyyymm BETWEEN :as_from_yyyymm AND :as_to_yyyymm ) 
       AND ( client BETWEEN :as_from_client AND :as_to_client ) 
       AND ( timesheet.trade_union BETWEEN 
             :as_from_trade_union AND :as_to_trade_union 
           ) 
       AND ( ( :as_date_type = 'A' 
               AND timesheet.work_date BETWEEN :adt_date_from AND :adt_date_to ) 
              OR ( :as_date_type = 'C' 
                   AND timesheet.transact_datetime >= :adt_date_from 
                   AND timesheet.transact_datetime < 
                       Dateadd(day, 1, :adt_date_to) ) 
              OR ( :as_date_type = 'E' 
                   AND timesheet.add_datetime >= :adt_date_from 
                   AND timesheet.add_datetime < Dateadd(day, 1, :adt_date_to) 
                 ) ) 
       AND ( :as_shift = 'A' 
              OR timesheet.shift = :as_shift ) 
       AND ( :as_employment_type = 'A' 
              OR timesheet.employment_type = :as_employment_type ) 
       AND ( ( :as_employed = 'A' ) 
              OR ( :as_employed = 'Y' 
                   AND employee.termination_date IS NULL ) 
              OR ( :as_employed = 'N' 
                   AND employee.termination_date IS NOT NULL ) ) 
       AND ( :as_status = 'ALL' 
              OR ( :as_status = 'OFF' 
                   AND timesheet.timesheet_status != 'W' ) 
              OR timesheet.timesheet_status = :as_status )   " arguments=(("as_company", string),("as_file_type1", string),("as_file_type2", string),("as_from_job", string),("as_to_job", string),("as_from_area", string),("as_to_area", string),("as_from_centre", string),("as_to_centre", string),("as_from_yyyymm", string),("as_to_yyyymm", string),("as_from_trade_union", string),("as_to_trade_union", string),("adt_date_from", datetime),("adt_date_to", datetime),("as_date_type", string),("as_employment_type", string),("as_shift", string),("as_employed", string),("as_status", string),("as_from_client", string),("as_to_client", string),("as_user_access_restricted", string))  sort="timesheet_job A timesheet_area A timesheet_centre A timesheet_trade_union A timesheet_occupation A timesheet_work_date A timesheet_employee A timesheet_timesheet_item A " )
