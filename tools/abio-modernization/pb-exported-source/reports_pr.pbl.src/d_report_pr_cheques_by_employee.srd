 retrieve="SELECT pr_cheque.cheque_no,
       pr_cheque.employee,
       pr_cheque.reg_earn + pr_cheque.tah_earn
       + pr_cheque.ovr_earn + pr_cheque.travel_earn
       + pr_cheque.turnaround + pr_cheque.taxi
       + pr_cheque.taxable_loa
       + pr_cheque.taxable_mileage
       + pr_cheque.other_taxable_pay
       + pr_cheque.meal + pr_cheque.retro
       + pr_cheque.nontaxable_loa
       + pr_cheque.nontaxable_mileage
       + pr_cheque.taxable_site_allow
       + pr_cheque.nontaxable_site_allow
       + pr_cheque.vehicle_allowance_paid AS total_earnings,
       pr_cheque.vacation_paid
       + pr_cheque.statutory_paid         
       + pr_cheque.paid_sick_leave         AS stat_pay,
       pr_cheque.admin_fee
       + pr_cheque.personal_safety_paid
       + pr_cheque.group_safety_paid
       + pr_cheque.staff_safety_paid
       + pr_cheque.smtc_paid
       + pr_cheque.retention_paid
       + pr_cheque.production_bonus_paid
       + pr_cheque.incentive_paid
       + pr_cheque.employee_rrsp
       + pr_cheque.misc_deduction
       + pr_cheque.advance_repay
       + pr_cheque.pay_in_lieu_of_notice
       + pr_cheque.province_payroll_tax   AS other,
       pr_cheque.admin_fee,
       pr_cheque.paid_sick_leave,
       pr_cheque.security_deposit,
       pr_cheque.training,
       pr_cheque.advance_repay,
       pr_cheque.vacation_owed,
       pr_cheque.statutory_owed,
       pr_cheque.vacation_earn,
       pr_cheque.statutory_earn,
       pr_cheque.personal_safety_earn,
       pr_cheque.group_safety_earn,
       pr_cheque.staff_safety_earn,
       pr_cheque.cpp_earn,
       pr_cheque.cpp2_earn,
       pr_cheque.ei_earn,
       pr_cheque.taxable_earn,
       pr_cheque.reg_hour,
       pr_cheque.tah_hour,
       pr_cheque.ovr_hour,
       pr_cheque.travel_hour,
       pr_cheque.reg_earn,
       pr_cheque.tah_earn,
       pr_cheque.ovr_earn,
       pr_cheque.travel_earn,
       pr_cheque.taxable_loa,
       pr_cheque.nontaxable_loa,
       pr_cheque.taxable_mileage,
       pr_cheque.nontaxable_mileage,
       pr_cheque.turnaround,
       pr_cheque.taxable_site_allow,
       pr_cheque.nontaxable_site_allow,
       pr_cheque.taxi,
       pr_cheque.meal,
       pr_cheque.retro,
       pr_cheque.other_taxable_pay,
       pr_cheque.personal_safety_paid,
       pr_cheque.group_safety_paid,
       pr_cheque.staff_safety_paid,
       pr_cheque.smtc_paid,
       pr_cheque.retention_paid,
       pr_cheque.production_bonus_paid,
       pr_cheque.incentive_paid,
       pr_cheque.vacation_paid,
       pr_cheque.statutory_paid,
       pr_cheque.vacation_paid_to_union,
       pr_cheque.statutory_paid_to_union,
       pr_cheque.vehicle_allowance_paid,
       pr_cheque.cpp_contribution,
       pr_cheque.cpp2_contribution,
       pr_cheque.ei_premium,
       pr_cheque.qpip_premium,
       pr_cheque.income_tax,
       pr_cheque.union_dues,
       pr_cheque.insurance,
       pr_cheque.misc_deduction,
       pr_cheque.charity,
       pr_cheque.incentive_paid_to_rrsp,
       pr_cheque.employee_rrsp,
       pr_cheque.employee_pension,
       pr_cheque.gross_pay,
       pr_cheque.net_pay,
       pr_cheque.wcb_remittance,
       pr_cheque.union_remittance,
       pr_cheque.employer_rrsp,
       pr_cheque.union_rrsp,
       pr_cheque.union_pension,
       pr_cheque.taxable_benefit,
       pr_cheque.personal_safety_lost,
       pr_cheque.group_safety_lost,
       pr_cheque.staff_safety_lost,
       pr_cheque.smtc_lost,
       pr_cheque.all_hr_reg_earn,
       pr_cheque.all_hr_base_earn,
       pr_cheque.reg_fringe,
       pr_cheque.tah_premium,
       pr_cheque.ovr_premium,
       pr_cheque.tah_premium_fringe,
       pr_cheque.ovr_premium_fringe,
       pr_cheque.gst_amount,
       pr_cheque.monthly_dues,
       pr_cheque.last_month_with_dues,
       pr_cheque.last_daily_dues_date,
       pr_cheque.pay_period_start_date,
       pr_cheque.issue_date,
       pr_cheque.cheque_status,
       pr_cheque.form_no,
       pr_cheque.pr_yyyymm,
       pr_cheque.transact_flag,
       pr_cheque.trade_union,
       pr_cheque.tax_province,
       pr_cheque.void_cheque_no,
       pr_cheque.transact_datetime,
       pr_cheque.employment_type,
       pr_cheque.restrict_flag,
       pr_cheque.file_type,
       pr_cheque.reconcile_date,
       pr_cheque.pay_in_lieu_of_notice,
       person.NAME,
       pr_cheque.province_payroll_tax,
       federal_tax.ei_employer_multiplier,
       federal_tax.qpip_employer_multiplier,
       (CASE pr_cheque.employment_type WHEN 'U' THEN person.ssn ELSE person.sin END) as sin_ssn
FROM   person,
       pr_cheque WITH (nolock)
       LEFT OUTER JOIN federal_tax
                    ON pr_cheque.issue_date BETWEEN federal_tax.effective_date AND federal_tax.expiry_date
WHERE  ( person.employee = pr_cheque.employee )
       AND ( pr_cheque.book = :as_book )
       AND ( ( pr_cheque.file_type = :as_file_type1 )
              OR ( pr_cheque.file_type = :as_file_type2 ) )
       AND ( pr_cheque.restrict_flag = 'N'
              OR :as_user_access_restricted = 'Y' )
       AND ( pr_cheque.employee BETWEEN :an_from_employee AND :an_to_employee )
       AND ( pr_cheque.pr_yyyymm BETWEEN :as_from_yyyymm AND :as_to_yyyymm )
       AND ( :as_cheque_status = '*'
              OR pr_cheque.cheque_status = :as_cheque_status )
       AND ( :as_emp_type = 'A'
              OR pr_cheque.employment_type = :as_emp_type )
       AND ( ( :as_date_type = 'C'
               AND pr_cheque.transact_datetime >= :adt_from_date
               AND pr_cheque.transact_datetime < Dateadd(day, 1, :adt_to_date)
               AND ( RIGHT('0' + Cast(Datepart(hh, pr_cheque.transact_datetime) AS VARCHAR), 2)
                     + ':'
                     + RIGHT('0' + Cast(Datepart(mi, pr_cheque.transact_datetime) AS VARCHAR), 2)
                     + ':'
                     + RIGHT('0' + Cast(Datepart(ss, pr_cheque.transact_datetime) AS VARCHAR), 2) BETWEEN :as_from_time AND :as_to_time ) )
              OR ( :as_date_type = 'I'
                   AND ( pr_cheque.issue_date >= :adt_from_date
                         AND pr_cheque.issue_date < Dateadd(day, 1, :adt_to_date) ) )
              OR ( :as_date_type = 'N'
                   AND pr_cheque.issue_date >= :adt_from_date
                   AND pr_cheque.issue_date < Dateadd(day, 1, :adt_to_date) )
              OR ( :as_date_type = 'R'
                   AND pr_cheque.reconcile_date >= :adt_from_date
                   AND pr_cheque.reconcile_date < Dateadd(day, 1, :adt_to_date) ) )
       AND ( :as_eft = 'A'
              OR ( :as_eft = 'Y'
                   AND Isnull(pr_cheque.eft_institution, '') <> '' )
              OR ( :as_eft = 'N'
                   AND Isnull(pr_cheque.eft_institution, '') = '' ) ) " arguments=(("as_file_type1", string),("as_file_type2", string),("as_book", string),("an_from_employee", number),("an_to_employee", number),("as_from_yyyymm", string),("as_to_yyyymm", string),("adt_from_date", datetime),("adt_to_date", datetime),("as_cheque_status", string),("as_date_type", string),("as_emp_type", string),("as_user_access_restricted", string),("as_from_time", string),("as_to_time", string),("as_eft", string))  sort="pr_cheque_employee A employee_name A pr_cheque_issue_date A pr_cheque_cheque_no A " )
group(level=1 header.height=0 trailer.height=0 trailer.height.autosize=yes by=("pr_cheque_employee" ) header.color="536870912" header.transparency="0" header.gradient.color="8421504" header.gradient.transparency="0" header.gradient.angle="0" header.brushmode="0" header.gradient.repetition.mode="0" header.gradient.repetition.count="0" header.gradient.repetition.length="100" header.gradient.focus="0" header.gradient.scale="100" header.gradient.spread="100" trailer.color="536870912" trailer.transparency="0" trailer.gradient.color="8421504" trailer.gradient.transparency="0" trailer.gradient.angle="0" trailer.brushmode="0" trailer.gradient.repetition.mode="0" trailer.gradient.repetition.count="0" trailer.gradient.repetition.length="100" trailer.gradient.focus="0" trailer.gradient.scale="100" trailer.gradient.spread="100" )
