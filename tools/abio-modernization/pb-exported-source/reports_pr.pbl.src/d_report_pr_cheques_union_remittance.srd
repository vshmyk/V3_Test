 retrieve=" SELECT cks.employee,
       Min(cks.sin)                    AS sin,
       Min(cks.employment_type)        AS employment_type,
       Min(cks.NAME)                   AS NAME,
       Min(cks.phone)                  AS phone,
       Min(cks.address)                AS address,
       Min(cks.mailing_address_1)      AS mailing_address_1,
       Min(cks.mailing_address_2)      AS mailing_address_2,
       Min(cks.mailing_city)           AS mailing_city,
       Min(cks.mailing_province)       AS mailing_province,
       Min(cks.mailing_postal)         AS mailing_postal,
       Min(cks.province)               AS province,
       Min(cks.occupation_description) AS occupation_description,
       Min(cks.hire_date)              AS hire_date,
       Min(cks.termination_date)       AS termination_date,
       Min(cks.roe_reason_code)        AS roe_reason_code,
       Sum(cks.reg_hour)               AS reg_hour,
       Sum(cks.tah_hour)               AS tah_hour,
       Sum(cks.ovr_hour)               AS ovr_hour,
       Sum(cks.sched_hour)             AS sched_hour,
       Sum(cks.worked_hour)            AS worked_hour,
       Sum(cks.earned_hour)            AS earned_hour,
       Sum(cks.hourly_earn)            AS hourly_earn,
       Sum(cks.base_earn)              AS base_earn,
       Sum(cks.vacation_and_statutory) AS vacation_and_statutory,
       Sum(cks.admin_fee)              AS admin_fee,
       Sum(cks.other_dues)             AS other_dues,
       Sum(cks.union_dues)             AS union_dues,
       Sum(cks.incentive_paid_to_rrsp) AS incentive_paid_to_rrsp,
       Sum(cks.employee_rrsp)          AS employee_rrsp,
       Sum(cks.union_remittance)       AS union_remittance,
       Sum(cks.union_pension)          AS union_pension,
       Sum(cks.employee_pension)       AS employee_pension,
       Min(0.00)                       AS benefit_1,
       Min(0.00)                       AS benefit_2,
       Min(0.00)                       AS benefit_3,
       Min(0.00)                       AS benefit_4,
       Min(0.00)                       AS benefit_5,
       Min(0.00)                       AS benefit_6,
       Min(0.00)                       AS benefit_7,
       Min(0.00)                       AS benefit_8,
       Min(0.00)                       AS benefit_9,
       Min(0.00)                       AS benefit_10,
       Min(0.00)                       AS benefit_11,
       Min(0.00)                       AS benefit_12,
       Min(0.00)                       AS benefit_13,
       Min(0.00)                       AS benefit_14,
       Min(0.00)                       AS benefit_15,
       Min(0.00)                       AS benefit_16,
       Min(0.00)                       AS benefit_17,
       Min(0.00)                       AS benefit_18,
       Min(0.00)                       AS benefit_19,
       Min(0.00)                       AS benefit_20,
       Min(cks.union_description)      AS union_description
FROM   (SELECT person.employee,
               Min((case employee.employment_type WHEN 'U' THEN person.ssn ELSE person.sin END)) AS sin,
					Min(employee.employment_type)               AS employment_type,
               Min(person.NAME)                            AS NAME,
               Min(person.phone)                           AS phone,
               Min(Isnull(person.mailing_address_1, '') + ' '
                   + Isnull( person.mailing_address_2, '') + ' '
                   + person.mailing_city + ' '
                   + person.mailing_province + ' '
                   + person.mailing_postal)                AS address,
               Min(person.mailing_address_1)               AS mailing_address_1,
               Min(person.mailing_address_2)               AS mailing_address_2,
               Min(person.mailing_city)                    AS mailing_city,
               Min(person.mailing_province)                AS mailing_province,
               Min(person.mailing_postal)                  AS mailing_postal,
               Min(person.mailing_province)                AS province,
               Min(occupation.description)                 AS occupation_description,
               Min(employee.hire_date)                     AS hire_date,
               Min(employee.termination_date)              AS termination_date,
               Min(employee.roe_reason_code)               AS roe_reason_code,
               Sum(prck_tu.reg_hour)                       AS reg_hour,
               Sum(prck_tu.tah_hour)                       AS tah_hour,
               Sum(prck_tu.ovr_hour)                       AS ovr_hour,
               Sum(prck_tu.sched_hour)                     AS sched_hour,
               Sum(prck_tu.worked_hour)                    AS worked_hour,
               Sum(prck_tu.earned_hour)                    AS earned_hour,
               Sum(prck_tu.hourly_earn)                    AS hourly_earn,
               Sum(prck_tu.base_earn)                      AS base_earn,
               Sum(prck_tu.vacation_and_statutory)         AS vacation_and_statutory,
               Max(prck.admin_fee)                         AS admin_fee,
               Max(prck.daily_dues + prck.back_dues
                   + prck.weekly_dues + prck.monthly_dues) AS other_dues,
               Max(prck_tu.union_dues)                     AS union_dues,
               Max(prck.incentive_paid_to_rrsp)            AS incentive_paid_to_rrsp,
               Sum(prck_tu.employee_rrsp)                  AS employee_rrsp,
               Sum(prck_tu.union_remittance)               AS union_remittance,
               Sum(prck_tu.union_pension)                  AS union_pension,
               Sum(prck_tu.employee_pension)               AS employee_pension,
               Min(prck_tu.union_description)              AS union_description
        FROM   (SELECT pctu.book,
                       pctu.cheque_no,
                       pctu.trade_union                                                                                            AS trade_union,
                       Min(tu.description)                                                                                         AS union_description,
                       Sum(pctu.reg_hour + CASE tur.include_travel_flag WHEN 'Y' THEN pctu.travel_hour ELSE 0 END)                 AS reg_hour,
                       Sum(pctu.tah_hour)                                                                                          AS tah_hour,
                       Sum(pctu.ovr_hour)                                                                                          AS ovr_hour,
                       Sum(pctu.reg_hour + CASE tur.include_travel_flag WHEN 'Y' THEN pctu.travel_hour ELSE 0 END + pctu.tah_hour) AS sched_hour,
                       Sum(pctu.reg_hour + CASE tur.include_travel_flag WHEN 'Y' THEN pctu.travel_hour ELSE 0 END + pctu.tah_hour
                           + pctu.ovr_hour)                                                                                        AS worked_hour,
                       Sum(pctu.reg_hour + CASE tur.include_travel_flag WHEN 'Y' THEN pctu.travel_hour ELSE 0 END
                           + Round( pctu.tah_hour * tu.tah_multiplier, 2 )
                           + Round( pctu.ovr_hour * tu.ovr_multiplier, 2 ))                                                        AS earned_hour,
                       Sum(pctu.reg_earn + CASE tur.include_travel_flag WHEN 'Y' THEN pctu.travel_earn ELSE 0 END + pctu.tah_earn
                           + pctu.ovr_earn)                                                                                        AS hourly_earn,
                       Sum(pctu.all_hr_base_earn)                                                                                  AS base_earn,
                       Sum(pctu.vacation_earn + pctu.statutory_earn)                                                               AS vacation_and_statutory,
                       Sum(pctu.union_dues)                                                                                        AS union_dues,
                       Sum(pctu.employee_rrsp)                                                                                     AS employee_rrsp,
                       Sum(pctu.union_remittance)                                                                                  AS union_remittance,
                       Sum(pctu.employee_pension)                                                                                  AS employee_pension,
                       Sum(pctu.union_pension)                                                                                     AS union_pension
                FROM   pr_cheque_trade_union pctu
                       LEFT OUTER JOIN pr_cheque
                                    ON PCTU.book = pr_cheque.book
                                       AND PCTU.cheque_no = pr_cheque.cheque_no
                       LEFT OUTER JOIN trade_union tu
                                    ON pctu.book = tu.book
                                       AND pctu.trade_union = tu.trade_union
                       LEFT OUTER JOIN trade_union_rate tur
                                    ON pctu.book = tur.book
                                       AND pctu.trade_union = tur.trade_union
                                       AND pr_cheque.issue_date BETWEEN tur.effective_date AND tur.expiry_date
                GROUP  BY pctu.book,
                          pctu.cheque_no,
                          pctu.trade_union) prck_tu
               LEFT OUTER JOIN (SELECT pr_cheque.book                   AS book,
                                       pr_cheque.cheque_no              AS cheque_no,
                                       pr_cheque.employee               AS employee,
                                       pr_cheque.issue_date             AS issue_date,
                                       pr_cheque.pr_yyyymm              AS pr_yyyymm,
                                       pr_cheque.employment_type        AS employment_type,
                                       pr_cheque.restrict_flag          AS restrict_flag,
                                       pr_cheque.admin_fee              AS admin_fee,
                                       pr_cheque.monthly_dues           AS monthly_dues,
                                       pr_cheque.back_dues              AS back_dues,
                                       pr_cheque.weekly_dues            AS weekly_dues,
                                       pr_cheque.daily_dues             AS daily_dues,
                                       pr_cheque.union_dues             AS union_dues,
                                       pr_cheque.incentive_paid_to_rrsp AS incentive_paid_to_rrsp,
                                       pr_cheque.employee_rrsp          AS employee_rrsp,
                                       pr_cheque.union_remittance       AS union_remittance,
                                       pr_cheque.employee_pension       AS employee_pension,
                                       pr_cheque.union_pension          AS union_pension,
                                       pr_cheque.file_type              AS file_type
                                FROM   pr_cheque) prck
                            ON prck_tu.book = prck.book
                               AND prck_tu.cheque_no = prck.cheque_no
               LEFT OUTER JOIN employee
                            ON prck.book = employee.book
                               AND prck.employee = employee.employee
               LEFT OUTER JOIN occupation
                            ON employee.book = occupation.book
                               AND employee.trade_union = occupation.trade_union
                               AND employee.occupation = occupation.occupation
               LEFT OUTER JOIN person
                            ON employee.employee = person.employee
        WHERE  prck.book = :as_company
               AND prck.file_type IN ( :as_file_type1, :as_file_type2, :as_file_type3 )
               AND prck.pr_yyyymm BETWEEN :as_from_yyyymm AND :as_to_yyyymm
               AND prck.issue_date BETWEEN :adt_from_date AND :adt_to_date
               AND prck_tu.trade_union IN ( :as_trade_unions )
               AND ( :as_employment_type = 'A'
                      OR prck.employment_type = :as_employment_type )
               AND ( prck.restrict_flag = 'N'
                      OR :as_access_user_restrict = 'Y' )
        GROUP  BY person.employee,
                  prck.cheque_no) cks
GROUP  BY cks.employee  " arguments=(("as_company", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_yyyymm", string),("as_to_yyyymm", string),("adt_from_date", datetime),("adt_to_date", datetime),("as_remittance_type", string),("as_trade_unions", stringlist),("as_employment_type", string),("as_access_user_restrict", string))  sort="name A " )
