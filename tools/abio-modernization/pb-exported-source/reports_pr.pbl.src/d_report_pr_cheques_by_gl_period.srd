table(column=(type=char(8) updatewhereclause=yes name=pr_cheque_book dbname="book" )
 column=(type=long updatewhereclause=yes name=pr_cheque_cheque_no dbname="cheque_no" )
 column=(type=long updatewhereclause=yes name=pr_cheque_employee dbname="employee" )
 column=(type=decimal(2) updatewhereclause=yes name=total_earnings dbname="total_earnings" )
 column=(type=decimal(2) updatewhereclause=yes name=stat_pay dbname="stat_pay" )
 column=(type=decimal(2) updatewhereclause=yes name=other dbname="other" )
 column=(type=decimal(2) updatewhereclause=yes name=union_total dbname="union_total" )
 column=(type=decimal(2) updatewhereclause=yes name=pr_cheque_cpp_contribution dbname="cpp_contribution" )
 column=(type=decimal(2) updatewhereclause=yes name=pr_cheque_ei_premium dbname="ei_premium" )
 column=(type=decimal(2) updatewhereclause=yes name=pr_cheque_income_tax dbname="income_tax" )
 column=(type=decimal(2) updatewhereclause=yes name=pr_cheque_union_dues dbname="union_dues" )
 column=(type=decimal(2) updatewhereclause=yes name=pr_cheque_insurance dbname="insurance" )
 column=(type=decimal(2) updatewhereclause=yes name=pr_cheque_net_pay dbname="net_pay" )
 column=(type=datetime updatewhereclause=yes name=pr_cheque_issue_date dbname="issue_date" )
 column=(type=char(1) updatewhereclause=yes name=pr_cheque_cheque_status dbname="cheque_status" )
 column=(type=char(6) updatewhereclause=yes name=pr_cheque_pr_yyyymm dbname="pr_yyyymm" )
 column=(type=decimal(2) updatewhereclause=yes name=pr_cheque_pay_in_lieu_of_notice dbname="pay_in_lieu_of_notice" )
 column=(type=char(25) updatewhereclause=yes name=employee_name dbname="name" )
 column=(type=decimal(2) updatewhereclause=yes name=pr_cheque_province_payroll_tax dbname="province_payroll_tax" )
 retrieve="  SELECT  pr_cheque.book,   
         pr_cheque.cheque_no,   
         pr_cheque.employee,   
			pr_cheque.reg_earn
				+ pr_cheque.tah_earn
				+ pr_cheque.ovr_earn
				+ pr_cheque.travel_earn
				+ pr_cheque.turnaround
				+ pr_cheque.nontaxable_site_allow
				+ pr_cheque.taxable_site_allow
				+ pr_cheque.taxi
				+ pr_cheque.taxable_loa
				+ pr_cheque.taxable_mileage
				+ pr_cheque.other_taxable_pay
				+ pr_cheque.meal
				+ pr_cheque.retro
				+ pr_cheque.nontaxable_loa
				+ pr_cheque.nontaxable_mileage
				+ pr_cheque.personal_safety_paid
				+ pr_cheque.group_safety_paid
				+ pr_cheque.staff_safety_paid
				+ pr_cheque.smtc_paid
				+ pr_cheque.retention_paid
				+ pr_cheque.production_bonus_paid
				+ pr_cheque.incentive_paid
			   + pr_cheque.vehicle_allowance_paid
			as total_earnings,
			pr_cheque.vacation_paid + pr_cheque.statutory_paid + pr_cheque.paid_sick_leave  AS stat_pay,
			pr_cheque.insurance
				+ pr_cheque.misc_deduction
				+ pr_cheque.advance_repay
				+ pr_cheque.security_deposit
				+ pr_cheque.admin_fee
				+ pr_cheque.pay_in_lieu_of_notice
			 	+ pr_cheque.province_payroll_tax
			as other,
			pr_cheque.union_dues + pr_cheque.monthly_dues  + pr_cheque.back_dues  + pr_cheque.weekly_dues +  pr_cheque.daily_dues   AS union_total,
         pr_cheque.cpp_contribution + pr_cheque.cpp2_contribution as pr_cheque_cpp_contribution,   
         pr_cheque.ei_premium,   
         pr_cheque.income_tax,   
         pr_cheque.union_dues,   
         pr_cheque.insurance,   
         pr_cheque.net_pay,   
         pr_cheque.issue_date,   
         pr_cheque.cheque_status,   
         pr_cheque.pr_yyyymm,   
 			pr_cheque.pay_in_lieu_of_notice,
         person.name,
			pr_cheque.province_payroll_tax
    FROM person,   
         pr_cheque  
   WHERE ( person.employee = pr_cheque.employee ) AND  
         ( pr_cheque.book = :as_book ) AND
			(( pr_cheque.file_type = :as_file_type1 ) OR  
         ( pr_cheque.file_type = :as_file_type2 )) AND
			( pr_cheque.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' ) and
			( pr_cheque.pr_yyyymm between :as_from_yyyymm and :as_to_yyyymm ) AND
			( :as_cheque_status = '*' or pr_cheque.cheque_status = :as_cheque_status ) AND
			( :as_emp_type = 'A' or pr_cheque.employment_type = :as_emp_type ) 
" arguments=(("as_file_type1", string),("as_file_type2", string),("as_book", string),("as_from_yyyymm", string),("as_to_yyyymm", string),("as_cheque_status", string),("as_emp_type", string),("as_user_access_restricted", string))  sort="pr_cheque_pr_yyyymm A pr_cheque_issue_date A pr_cheque_cheque_no A " )
