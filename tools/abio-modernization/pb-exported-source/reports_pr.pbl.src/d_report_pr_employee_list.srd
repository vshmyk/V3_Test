table(column=(type=long updatewhereclause=yes name=employee dbname="employee" )
 column=(type=char(25) updatewhereclause=yes name=name dbname="NAME" )
 column=(type=char(25) updatewhereclause=yes name=address_1 dbname="mailing_address_1" )
 column=(type=char(25) updatewhereclause=yes name=address_2 dbname="mailing_address_2" )
 column=(type=char(10) updatewhereclause=yes name=phone dbname="phone" )
 column=(type=char(5) updatewhereclause=yes name=trade_union dbname="trade_union" )
 column=(type=char(5) updatewhereclause=yes name=occupation dbname="occupation" )
 column=(type=datetime updatewhereclause=yes name=hire_date dbname="hire_date" )
 column=(type=datetime updatewhereclause=yes name=termination_date dbname="termination_date" )
 column=(type=datetime updatewhereclause=yes name=last_pay_date dbname="last_pay_date" )
 column=(type=char(1) updatewhereclause=yes name=income_tax_exempt_flag dbname="income_tax_exempt_flag" )
 column=(type=char(1) updatewhereclause=yes name=ei_exempt_flag dbname="ei_exempt_flag" )
 column=(type=char(1) updatewhereclause=yes name=cpp_exempt_flag dbname="cpp_exempt_flag" )
 column=(type=datetime updatewhereclause=yes name=birth_date dbname="birth_date" )
 column=(type=char(20) updatewhereclause=yes name=city dbname="mailing_city" )
 column=(type=char(2) updatewhereclause=yes name=province dbname="mailing_province" )
 column=(type=char(10) updatewhereclause=yes name=postal dbname="mailing_postal" )
 column=(type=char(3) updatewhereclause=yes name=shift_cycle dbname="shift_cycle" )
 column=(type=char(6) updatewhereclause=yes name=job dbname="job" )
 column=(type=datetime updatewhereclause=yes name=reminder_date dbname="reminder_date" )
 column=(type=datetime updatewhereclause=yes name=loa_change_date dbname="loa_change_date" )
 column=(type=char(50) updatewhereclause=yes name=message dbname="message" )
 column=(type=char(1) updatewhereclause=yes name=employment_type dbname="employment_type" )
 column=(type=char(6) updatewhereclause=yes name=vendor dbname="vendor" )
 column=(type=char(50) updatewhereclause=yes name=eft_email_address dbname="eft_email_address" )
 retrieve="SELECT person.employee,
       person.NAME,
       person.mailing_address_1,
       person.mailing_address_2,
       person.phone,
       employee.trade_union,
       employee.occupation,
       employee.hire_date,
       employee.termination_date,
       last_pay_date,
       income_tax_exempt_flag,
       ei_exempt_flag,
       cpp_exempt_flag,
       person.birth_date,
       person.mailing_city,
       person.mailing_province,
       person.mailing_postal,
       employee.shift_cycle,
       employee.job,
       employee.reminder_date,
       employee.loa_change_date,
       employee.message,
       employee.employment_type,
       CASE employee.employment_type
         WHEN 'S' THEN employee.subcontractor_vendor
         ELSE employee.rrsp_vendor
       END AS vendor,
       employee.eft_email_address
FROM   employee,
       person
WHERE  employee.book = :as_company
       AND employee.employee = person.employee
       AND ( 'A' IN ( :as_file_type1, :as_file_type2, :as_file_type3 )
              OR employee.file_type IN ( :as_file_type1, :as_file_type2, :as_file_type3 ) )
       AND ( ( :as_active = 'Y'
               AND employee.termination_date IS NULL )
              OR ( :as_active = 'N'
                   AND employee.termination_date IS NOT NULL )
              OR ( :as_active = 'A' ) )
       AND ( :as_job = 'ALL'
              OR employee.job = :as_job )
       AND ( :as_shift_cycle = 'ALL'
              OR employee.shift_cycle = :as_shift_cycle )
       AND ( :as_trade_union = 'ALL'
              OR employee.trade_union = :as_trade_union )
       AND ( employee.restrict_flag = 'N'
              OR :as_user_access_restricted = 'Y' ) " arguments=(("as_company", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_active", string),("as_job", string),("as_shift_cycle", string),("as_trade_union", string),("as_user_access_restricted", string))  sort="name A employee A phone A hire_date A termination_date A trade_union A occupation A " )
