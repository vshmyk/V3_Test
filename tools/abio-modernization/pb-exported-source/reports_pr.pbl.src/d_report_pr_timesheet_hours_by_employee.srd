table(column=(type=char(8) updatewhereclause=yes name=timesheet_book dbname="timesheet.book" )
 column=(type=long updatewhereclause=yes name=timesheet_employee dbname="timesheet.employee" )
 column=(type=datetime updatewhereclause=yes name=timesheet_work_date dbname="timesheet.work_date" )
 column=(type=long updatewhereclause=yes name=timesheet_timesheet_item dbname="timesheet.timesheet_item" )
 column=(type=char(6) updatewhereclause=yes name=timesheet_job dbname="timesheet.job" )
 column=(type=char(5) updatewhereclause=yes name=timesheet_area dbname="timesheet.area" )
 column=(type=char(6) updatewhereclause=yes name=timesheet_centre dbname="timesheet.centre" )
 column=(type=char(8) updatewhereclause=yes name=timesheet_equipment dbname="timesheet.equipment" )
 column=(type=char(6) updatewhereclause=yes name=timesheet_gl_account dbname="timesheet.gl_account" )
 column=(type=char(1) updatewhereclause=yes name=timesheet_shift dbname="timesheet.shift" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_reg_hour dbname="timesheet.reg_hour" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_tah_hour dbname="timesheet.tah_hour" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_ovr_hour dbname="timesheet.ovr_hour" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_travel_hour dbname="timesheet.travel_hour" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_loa_hour dbname="timesheet.loa_hour" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_mileage_hour dbname="timesheet.mileage_hour" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_reg_rate dbname="timesheet.reg_rate" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_tah_rate dbname="timesheet.tah_rate" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_ovr_rate dbname="timesheet.ovr_rate" )
 column=(type=char(1) updatewhereclause=yes name=timesheet_employment_type dbname="timesheet.employment_type" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_total dbname="timesheet.total" )
 column=(type=char(1) updatewhereclause=yes name=timesheet_file_type dbname="timesheet.file_type" )
 column=(type=char(1) updatewhereclause=yes name=timesheet_timesheet_status dbname="timesheet.timesheet_status" )
 column=(type=char(5) updatewhereclause=yes name=trade_union dbname="timesheet.trade_union" )
 column=(type=char(1) updatewhereclause=yes name=staff_flag dbname="trade_union.staff_flag" )
 column=(type=char(25) updatewhereclause=yes name=employee_name dbname="employee.name" )
 column=(type=char(35) updatewhereclause=yes name=timesheet_memo dbname="timesheet.memo" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_meal dbname="timesheet.meal" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_turnaround dbname="timesheet.turnaround" )
 column=(type=decimal(2) updatewhereclause=yes name=retention_earn dbname="timesheet.retention_earn" )
 column=(type=decimal(2) updatewhereclause=yes name=recruitment_cost dbname="timesheet.recruitment_cost" )
 column=(type=char(5) updatewhereclause=yes name=timesheet_occupation dbname="timesheet.occupation" )
 column=(type=char(35) updatewhereclause=yes name=trade_union_description dbname="trade_union.description" )
 column=(type=char(35) updatewhereclause=yes name=occupation_description dbname="occupation.description" )
 retrieve="  SELECT timesheet.book,   
         timesheet.employee,   // column id  = 2 is used to open w_prtent, if column order changes opening of entry window settings should change too
         timesheet.work_date,  // column id  = 3 
         timesheet.timesheet_item, // column id  = 4
         timesheet.job,   
         timesheet.area,   
         timesheet.centre,   
         timesheet.equipment,   
         timesheet.gl_account,   
         timesheet.shift,   
         timesheet.reg_hour,   
         timesheet.tah_hour,   
         timesheet.ovr_hour,   
         timesheet.travel_hour,   
         timesheet.loa_hour,   
         timesheet.mileage_hour,   
         timesheet.reg_rate,  
         timesheet.tah_rate,
         timesheet.ovr_rate,
         timesheet.employment_type,
			timesheet.total,
         timesheet.file_type,
			timesheet.timesheet_status,
			timesheet.trade_union,
		   trade_union.staff_flag as staff_flag,
			employee.name,
			timesheet.memo,
			timesheet.meal,
			timesheet.turnaround, 
			timesheet.retention_earn,
			timesheet.recruitment_cost,
         timesheet.occupation,
         trade_union.description,
         occupation.description
    FROM employee,
         timesheet LEFT OUTER JOIN trade_union 	ON timesheet.book = trade_union.book 	AND timesheet.trade_union = trade_union.trade_union
			          LEFT OUTER JOIN occupation 	ON timesheet.book = occupation.book 	AND timesheet.trade_union = occupation.trade_union AND timesheet.occupation = occupation.occupation
   WHERE	timesheet.book = :as_company
			AND ( timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' ) 
			and timesheet.file_type IN ( :as_file_type1, :as_file_type2 )
			and timesheet.employee between :an_from_employee and :an_to_employee
			and timesheet.pr_yyyymm between :as_from_yyyymm and :as_to_yyyymm
			and timesheet.trade_union between :as_from_trade_union and :as_to_trade_union
			and (		(	:as_date_type = 'A'
							and timesheet.work_date between :adt_from_date and :adt_to_date )
					or	(	:as_date_type = 'C'
							and timesheet.transact_datetime >= :adt_from_date and timesheet.transact_datetime < DateAdd(day, 1, :adt_to_date)
												 AND (RIGHT('0' + CAST(datepart(HH, timesheet.transact_datetime) AS VARCHAR), 2) + ':' + 
														RIGHT('0' + CAST(datepart(MI, timesheet.transact_datetime) AS VARCHAR), 2) + ':' + 
														RIGHT('0' + CAST(datepart(SS, timesheet.transact_datetime) AS VARCHAR), 2) BETWEEN :as_from_time AND :as_to_time) )
					or	(	:as_date_type = 'E'
							and timesheet.add_datetime >= :adt_from_date and timesheet.add_datetime < DateAdd(day, 1, :adt_to_date) ) )
			and ( :as_shift = 'A' OR timesheet.shift = :as_shift )
			and (	:as_active = 'A'
					or ( :as_active = 'Y' and employee.termination_date IS NULL )
					or ( :as_active = 'N' and employee.termination_date IS NOT NULL ) )
			and ( :as_employment_type = 'A' OR timesheet.employment_type = :as_employment_type )
			and (	:as_status = 'ALL'
					OR ( :as_status = 'OFF' and timesheet.timesheet_status != 'W' )
					OR timesheet.timesheet_status = :as_status )
         and employee.book = timesheet.book
			and employee.employee = timesheet.employee
" arguments=(("as_company", string),("as_file_type1", string),("as_file_type2", string),("an_from_employee", number),("an_to_employee", number),("as_from_yyyymm", string),("as_to_yyyymm", string),("as_from_trade_union", string),("as_to_trade_union", string),("adt_from_date", datetime),("adt_to_date", datetime),("as_date_type", string),("as_active", string),("as_shift", string),("as_employment_type", string),("as_status", string),("as_user_access_restricted", string),("as_from_time", string),("as_to_time", string))  sort="timesheet_employee A timesheet_work_date A timesheet_timesheet_item A timesheet_job A timesheet_area A timesheet_centre A timesheet_shift A timesheet_employment_type A timesheet_timesheet_status A timesheet_ovr_rate A timesheet_reg_rate A " )
