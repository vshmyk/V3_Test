table(column=(type=long updatewhereclause=yes name=subreport dbname="subreport" )
 column=(type=long updatewhereclause=yes name=employee dbname="employee" )
 column=(type=char(25) updatewhereclause=yes name=name dbname="name" )
 column=(type=char(9) updatewhereclause=yes name=sin dbname="sin" )
 column=(type=datetime updatewhereclause=yes name=birth_date dbname="birth_date" )
 column=(type=datetime updatewhereclause=yes name=hire_date dbname="hire_date" )
 column=(type=datetime updatewhereclause=yes name=termination_date dbname="termination_date" )
 column=(type=char(5) updatewhereclause=yes name=trade_union dbname="trade_union" )
 column=(type=char(5) updatewhereclause=yes name=occupation dbname="occupation" )
 column=(type=decimal(0) updatewhereclause=yes name=federal_td1_claim dbname="federal_td1_claim" )
 column=(type=char(1) updatewhereclause=yes name=ei_exempt_flag dbname="ei_exempt_flag" )
 column=(type=char(1) updatewhereclause=yes name=cpp_exempt_flag dbname="cpp_exempt_flag" )
 column=(type=decimal(2) updatewhereclause=yes name=vacation_percent dbname="vacation_percent" )
 column=(type=decimal(2) updatewhereclause=yes name=statutory_percent dbname="statutory_percent" )
 column=(type=char(1) updatewhereclause=yes name=loa_taxable_flag dbname="loa_taxable_flag" )
 column=(type=char(1) updatewhereclause=yes name=mileage_taxable_flag dbname="mileage_taxable_flag" )
