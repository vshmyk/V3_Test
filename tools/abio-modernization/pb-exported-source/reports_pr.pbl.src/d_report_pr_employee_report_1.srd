 column=(type=decimal(2) updatewhereclause=yes name=mileage_rate dbname="mileage_rate" )
 column=(type=char(2) updatewhereclause=yes name=tax_province dbname="tax_province" )
 column=(type=char(3) updatewhereclause=yes name=wcb_class dbname="wcb_class" )
 column=(type=decimal(2) updatewhereclause=yes name=deposit_advance_repay dbname="deposit_advance_repay" )
 column=(type=decimal(2) updatewhereclause=yes name=vacation_owed dbname="vacation_owed" )
 column=(type=decimal(2) updatewhereclause=yes name=statutory_owed dbname="statutory_owed" )
 column=(type=decimal(2) updatewhereclause=yes name=hourly_earnings dbname="hourly_earnings" )
 column=(type=decimal(2) updatewhereclause=yes name=incentives dbname="incentives" )
 column=(type=decimal(2) updatewhereclause=yes name=meals_taxi_turnaround dbname="meals_taxi_turnaround" )
 column=(type=decimal(2) updatewhereclause=yes name=living_out dbname="living_out" )
 column=(type=decimal(2) updatewhereclause=yes name=mileage dbname="mileage" )
 column=(type=decimal(2) updatewhereclause=yes name=retro_other dbname="retro_other" )
 column=(type=decimal(2) updatewhereclause=yes name=vacation_statutory_paid dbname="vacation_statutory_paid" )
 column=(type=decimal(2) updatewhereclause=yes name=gross_pay dbname="gross_pay" )
 column=(type=decimal(2) updatewhereclause=yes name=cpp_contribution dbname="cpp_contribution" )
 column=(type=decimal(2) updatewhereclause=yes name=cpp_earn dbname="cpp_earn" )
 column=(type=decimal(2) updatewhereclause=yes name=ei_premium dbname="ei_premium" )
 column=(type=decimal(2) updatewhereclause=yes name=union_initiation dbname="union_initiation" )
 column=(type=decimal(2) updatewhereclause=yes name=income_tax dbname="income_tax" )
 column=(type=decimal(2) updatewhereclause=yes name=insurance_deduction dbname="insurance_deduction" )
 column=(type=decimal(2) updatewhereclause=yes name=net_pay dbname="net_pay" )
 column=(type=decimal(2) updatewhereclause=yes name=export_meals_taxi_turnaround dbname="export_meals_taxi_turnaround" )
 column=(type=decimal(2) updatewhereclause=yes name=taxable_earn dbname="taxable_earn" )
 column=(type=datetime updatewhereclause=yes name=last_pay_date dbname="last_pay_date" )
 column=(type=decimal(2) updatewhereclause=yes name=province_payroll_tax dbname="province_payroll_tax" )
 retrieve="select	1 as subreport,
			person.employee,
			person.name,
			person.sin,
			person.birth_date,
			hire_date,
			termination_date,
			trade_union,
			occupation,
			federal_td1_claim,
			employee_earning.ei_exempt_flag,
			employee_earning.cpp_exempt_flag,
			vacation_percent,
			statutory_percent,
			loa_taxable_flag,
			mileage_taxable_flag,
			loa_rate,
			mileage_rate,
			employee_earning.tax_province,
			wcb_class,
			advance_repay + security_deposit as deposit_advance_repay,
			vacation_owed,
			statutory_owed,
			reg_earn + tah_earn + ovr_earn + travel_earn as hourly_earnings,
			personal_safety_paid
				+ group_safety_paid
				+ staff_safety_paid
				+ smtc_paid
				+ retention_paid
				+ production_bonus_paid
				+ incentive_paid
			as incentives,
			turnaround
				+ meal
				+ taxi
				+ taxable_site_allow
				+ nontaxable_site_allow
			as meals_taxi_turnaround,
			taxable_loa + nontaxable_loa as living_out,
			taxable_mileage + nontaxable_mileage as mileage,
			retro + other_taxable_pay + pay_in_lieu_of_notice as retro_other,
			vacation_paid + statutory_paid + paid_sick_leave as vacation_statutory_paid,
			gross_pay,
			cpp_contribution,
			cpp_earn,
			ei_premium,
			union_dues + admin_fee as union_initiation,
			income_tax,
			insurance + misc_deduction + province_payroll_tax as insurance_deduction,
			net_pay,
			turnaround + meal + taxi as export_meals_taxi_turnaround,
			taxable_earn,
			last_pay_date,
			employee_earning.province_payroll_tax
	from	employee,	
			employee_earning,
			person
	where	person.employee = employee.employee
			and employee.employee = employee_earning.employee
			and employee.book = employee_earning.book
			AND ( employee.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' )
			and employee.book = :as_company
			and employee.file_type in ( :as_file_type1, :as_file_type2, :as_file_type3 )
			and (	employee_earning.tax_year = :as_year )
" arguments=(("as_company", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_year", string),("as_user_access_restricted", string))  sort="subreport A name A employee A " )
