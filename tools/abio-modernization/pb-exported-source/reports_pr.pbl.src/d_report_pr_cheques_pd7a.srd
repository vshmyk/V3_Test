table(column=(type=decimal(2) updatewhereclause=yes identity=yes name=taxable_earn dbname="taxable_earn" )
 column=(type=decimal(3) updatewhereclause=yes identity=yes name=cpp dbname="cpp" )
 column=(type=decimal(3) updatewhereclause=yes identity=yes name=ei dbname="ei" )
 column=(type=decimal(3) updatewhereclause=yes identity=yes name=income_tax dbname="income_tax" )
 column=(type=long updatewhereclause=yes identity=yes name=employee_count dbname="employee_count" )
 column=(type=char(40) updatewhereclause=yes name=name dbname="name" )
 column=(type=char(15) updatewhereclause=yes name=ccra_business_no dbname="ccra_business_no" )
 column=(type=char(40) updatewhereclause=yes name=address dbname="address" )
 column=(type=char(20) updatewhereclause=yes name=city dbname="city" )
 column=(type=char(2) updatewhereclause=yes name=province dbname="province" )
 column=(type=char(10) updatewhereclause=yes name=postal dbname="postal" )
 retrieve="  SELECT sum(pr_cheque.taxable_earn) as taxable_earn,

         sum(2.0 * IsNull(pr_cheque.cpp_contribution,0)) as cpp,   

         sum(Round((1.0 + :n_ei_contribution_rate) * IsNull(pr_cheque.ei_premium,0), 2)) as ei,   

         sum(1.0 * IsNull(pr_cheque.income_tax,0)) as income_tax,

         count(distinct employee) as employee_count,
			Min(company.name) as name,
			Min(company.ccra_business_no) as ccra_business_no,
			Min(company.address) as address,
			Min(company.city) as city,
			Min(company.province) as province,
			Min(company.postal) as postal

    FROM pr_cheque left outer join company on company.book = pr_cheque.book  
   WHERE pr_cheque.book = :as_book
     AND pr_cheque.issue_date BETWEEN :adt_from AND :adt_to    
" arguments=(("as_book", string),("n_ei_contribution_rate", decimal),("adt_from", datetime),("adt_to", datetime)) )
