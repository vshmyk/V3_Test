 column=(type=datetime updatewhereclause=yes name=employee_hire_date dbname="hire_date" )
 column=(type=char(35) updatewhereclause=yes name=trade_union_description dbname="trade_union_description" )
 retrieve="WITH prck_tu
     AS (SELECT pctu.book,
                pctu.cheque_no,
                pctu.trade_union           AS trade_union,
                Min(tu.description)        AS union_description,
                Sum(pctu.reg_hour)         AS reg_hour,
                Sum(pctu.travel_hour)      AS travel_hour,
                Sum(pctu.tah_hour)         AS tah_hour,
                Sum(pctu.ovr_hour)         AS ovr_hour,
                Sum(pctu.reg_earn)         AS reg_earn,
                Sum(pctu.travel_earn)      AS travel_earn,
                Sum(pctu.tah_earn)         AS tah_earn,
                Sum(pctu.ovr_earn)         AS ovr_earn,
                Sum(pctu.paid_sick_leave)  AS paid_sick_leave,
                Sum(pctu.all_hr_base_earn) AS all_hr_base_earn,
                Sum(pctu.all_hr_reg_earn)  AS all_hr_reg_earn,
                Sum(pctu.vacation_earn)    AS vacation_earn,
                Sum(pctu.statutory_earn)   AS statutory_earn,
                Sum(pctu.union_dues)       AS union_dues,
                Sum(pctu.employee_rrsp)    AS employee_rrsp,
                Sum(pctu.union_remittance) AS union_remittance,
                Sum(pctu.employee_pension) AS employee_pension,
                Sum(pctu.union_pension)    AS union_pension,
                Sum(pctu.union_rrsp)       AS union_rrsp
         FROM   pr_cheque_trade_union pctu
                LEFT OUTER JOIN pr_cheque
                             ON PCTU.book = pr_cheque.book
                                AND PCTU.cheque_no = pr_cheque.cheque_no
                LEFT OUTER JOIN trade_union tu
                             ON pctu.book = tu.book
                                AND pctu.trade_union = tu.trade_union
                LEFT OUTER JOIN trade_union_rate tur
                             ON pctu.book = tur.book
                                AND pctu.trade_union = tur.trade_union
                                AND pr_cheque.issue_date BETWEEN tur.effective_date AND tur.expiry_date
         GROUP  BY pctu.book,
                   pctu.cheque_no,
                   pctu.trade_union),
     prck
     AS (SELECT pr_cheque.book                   AS book,
                pr_cheque.cheque_no              AS cheque_no,
                pr_cheque.employee               AS employee,
                pr_cheque.issue_date             AS issue_date,
                pr_cheque.pay_period_start_date  AS pay_period_start_date,
                pr_cheque.pr_yyyymm              AS pr_yyyymm,
                pr_cheque.employment_type        AS employment_type,
                pr_cheque.restrict_flag          AS restrict_flag,
                pr_cheque.admin_fee              AS admin_fee,
                pr_cheque.last_month_with_dues   AS last_month_with_dues,
                pr_cheque.last_daily_dues_date   AS last_daily_dues_date,
                pr_cheque.monthly_dues           AS monthly_dues,
                pr_cheque.back_dues              AS back_dues,
                pr_cheque.weekly_dues            AS weekly_dues,
                pr_cheque.daily_dues             AS daily_dues,
                pr_cheque.union_dues             AS union_dues,
                pr_cheque.incentive_paid_to_rrsp AS incentive_paid_to_rrsp,
                pr_cheque.employee_rrsp          AS employee_rrsp,
                pr_cheque.union_remittance       AS union_remittance,
                pr_cheque.employee_pension       AS employee_pension,
                pr_cheque.union_pension          AS union_pension,
                pr_cheque.employer_rrsp          AS employer_rrsp,
                pr_cheque.personal_safety_earn   AS personal_safety_earn,
                pr_cheque.group_safety_earn      AS group_safety_earn,
                pr_cheque.staff_safety_earn      AS staff_safety_earn,
                pr_cheque.smtc_earn              AS smtc_earn,
                pr_cheque.taxable_loa            AS taxable_loa,
                pr_cheque.nontaxable_loa         AS nontaxable_loa,
                pr_cheque.taxable_mileage        AS taxable_mileage,
                pr_cheque.nontaxable_mileage     AS nontaxable_mileage,
                pr_cheque.taxable_site_allow     AS taxable_site_allow,
                pr_cheque.nontaxable_site_allow  AS nontaxable_site_allow,
                pr_cheque.taxi                   AS taxi,
                pr_cheque.meal                   AS meal,
                pr_cheque.retro                  AS retro,
                pr_cheque.turnaround             AS turnaround,
                pr_cheque.file_type              AS file_type
         FROM   pr_cheque),
     prck_tu_count
     AS (SELECT pctu.book,
                pctu.cheque_no,
                Count(1) AS RecordsPerGroup
         FROM   pr_cheque_trade_union pctu
         GROUP  BY pctu.book,
                   pctu.cheque_no)
SELECT prck.book,
       prck.cheque_no,
       prck.employee,
       Round((prck.union_dues + prck.monthly_dues)/prck_tu_count.RecordsPerGroup, 2)    AS union_total,
       prck_tu.reg_hour + prck_tu.travel_hour AS regular_hours,
       prck.admin_fee + prck.monthly_dues
       + prck.incentive_paid_to_rrsp
       + prck.back_dues + prck.daily_dues
       + prck.weekly_dues                     AS due_fees_safe,
       prck.admin_fee,
       prck_tu.vacation_earn,
       prck_tu.statutory_earn,
       prck.personal_safety_earn,
       prck.group_safety_earn,
       prck.staff_safety_earn,
       prck.smtc_earn,
       prck_tu.reg_hour,
       prck_tu.tah_hour,
       prck_tu.ovr_hour,
       prck_tu.travel_hour,
       prck_tu.reg_earn,
       prck_tu.tah_earn,
       prck_tu.ovr_earn,
       prck_tu.travel_earn,
       prck_tu.paid_sick_leave,
       prck.taxable_loa,
       prck.nontaxable_loa,
       prck.taxable_mileage,
       prck.nontaxable_mileage,
       prck.turnaround,
       prck.taxable_site_allow,
       prck.nontaxable_site_allow,
       prck.taxi,
       prck.meal,
       prck.retro,
       prck_tu.union_dues,
       prck.incentive_paid_to_rrsp,
       prck_tu.employee_rrsp,
       prck_tu.employee_pension,
       prck_tu.union_remittance,
       prck.employer_rrsp,
       prck_tu.union_rrsp,
       prck_tu.union_pension,
       prck_tu.all_hr_reg_earn,
       prck_tu.all_hr_base_earn,
       Round(prck.monthly_dues/prck_tu_count.RecordsPerGroup, 2) as monthly_dues,
       prck.last_month_with_dues,
       prck.last_daily_dues_date,
       prck.pay_period_start_date,
       prck.issue_date,
       prck_tu.trade_union,
       person.NAME,
       person.mailing_address_1,
       person.mailing_address_2,
       person.mailing_city,
       person.mailing_province,
       person.mailing_postal,
       person.sin,
       person.ssn,
       employee.hire_date,
       employee.termination_date,
       employee.hire_date,
       Rtrim(union_description)               AS trade_union_description
FROM   prck_tu
       LEFT OUTER JOIN prck
                    ON prck_tu.book = prck.book
                       AND prck_tu.cheque_no = prck.cheque_no
       LEFT OUTER JOIN prck_tu_count
                    ON prck_tu.book = prck_tu_count.book
                       AND prck_tu.cheque_no = prck_tu_count.cheque_no
       LEFT OUTER JOIN employee
                    ON prck.book = employee.book
                       AND prck.employee = employee.employee
       LEFT OUTER JOIN person
                    ON employee.employee = person.employee
WHERE  employee.book = prck.book
       AND employee.employee = prck.employee
       AND person.employee = prck.employee
       AND ( prck.book = :as_book )
       AND ( ( prck.file_type = :as_file_type1 )
              OR ( prck.file_type = :as_file_type2 ) )
       AND ( prck.restrict_flag = 'N'
              OR :as_user_access_restricted = 'Y' )
       AND ( prck.pr_yyyymm BETWEEN :as_from_yyyymm AND :as_to_yyyymm )
       AND ( prck.issue_date BETWEEN :adt_from_date AND :adt_to_date )
       AND ( :as_emp_group = 'ALL'
              OR prck_tu.trade_union = :as_emp_group )
       AND ( :as_emp = 'A'
              OR prck.employment_type = :as_emp ) " arguments=(("as_file_type1", string),("as_file_type2", string),("as_book", string),("as_from_yyyymm", string),("as_to_yyyymm", string),("adt_from_date", datetime),("adt_to_date", datetime),("as_emp_group", string),("as_emp", string),("as_user_access_restricted", string))  sort="pr_cheque_trade_union A employee_name A pr_cheque_employee A pr_cheque_cheque_no A " )
