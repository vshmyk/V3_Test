table(column=(type=long updatewhereclause=yes name=timesheet_employee dbname="employee" )
 column=(type=long updatewhereclause=yes name=timesheet_cheque_no dbname="cheque_no" )
 column=(type=char(6) updatewhereclause=yes name=timesheet_job dbname="job" )
 column=(type=datetime updatewhereclause=yes name=timesheet_work_date dbname="work_date" )
 column=(type=long updatewhereclause=yes name=timesheet_timesheet_item dbname="timesheet_item" )
 column=(type=char(5) updatewhereclause=yes name=timesheet_area dbname="area" )
 column=(type=char(6) updatewhereclause=yes name=timesheet_centre dbname="centre" )
 column=(type=char(5) updatewhereclause=yes name=timesheet_trade_union dbname="trade_union" )
 column=(type=char(5) updatewhereclause=yes name=timesheet_occupation dbname="occupation" )
 column=(type=char(3) updatewhereclause=yes name=timesheet_wcb_class dbname="wcb_class" )
 column=(type=char(1) updatewhereclause=yes name=timesheet_employment_type dbname="employment_type" )
 column=(type=char(1) updatewhereclause=yes name=timesheet_shift dbname="shift" )
 column=(type=char(6) updatewhereclause=yes name=timesheet_pr_yyyymm dbname="pr_yyyymm" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_reg_hour dbname="reg_hour" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_tah_hour dbname="tah_hour" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_ovr_hour dbname="ovr_hour" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_travel_hour dbname="travel_hour" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_loa_hour dbname="loa_hour" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_mileage_hour dbname="mileage_hour" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_reg_earn dbname="reg_earn" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_tah_earn dbname="tah_earn" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_ovr_earn dbname="ovr_earn" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_travel_earn dbname="travel_earn" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_loa dbname="loa" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_mileage dbname="mileage" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_turnaround dbname="turnaround" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_meal dbname="meal" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_taxi dbname="taxi" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_retro dbname="retro" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_other_taxable_pay dbname="other_taxable_pay" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_site_allowance dbname="site_allowance" )
 column=(type=char(8) updatewhereclause=yes name=timesheet_equipment dbname="equipment" )
 column=(type=char(6) updatewhereclause=yes name=timesheet_gl_account dbname="gl_account" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_fringe dbname="fringe" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_total dbname="total" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_gst_amount dbname="gst_amount" )
 column=(type=char(25) updatewhereclause=yes name=employee_name dbname="name" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_vehicle_allowance_paid dbname="vehicle_allowance_paid" )
 column=(type=decimal(2) updatewhereclause=yes name=pay_in_lieu_of_notice dbname="pay_in_lieu_of_notice" )
 column=(type=decimal(2) updatewhereclause=yes name=retention_earn dbname="retention_earn" )
 column=(type=decimal(2) updatewhereclause=yes name=recruitment_cost dbname="recruitment_cost" )
 retrieve="  SELECT timesheet.employee,
			timesheet.cheque_no,
         timesheet.job,
         timesheet.work_date,   
         timesheet.timesheet_item,   
         timesheet.area,   
         timesheet.centre,
         timesheet.trade_union,
         timesheet.occupation,
			timesheet.wcb_class,
			timesheet.employment_type,
         timesheet.shift,
			timesheet.pr_yyyymm,
         timesheet.reg_hour,
         timesheet.tah_hour,
         timesheet.ovr_hour,
         timesheet.travel_hour,
         timesheet.loa_hour,
         timesheet.mileage_hour,
         (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.reg_earn ELSE 0 END) AS reg_earn, 
         (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.tah_earn ELSE 0 END) AS tah_earn, 
         (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.ovr_earn ELSE 0 END) AS ovr_earn, 
         (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.travel_earn ELSE 0 END) AS travel_earn, 
         (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.loa ELSE 0 END) AS loa, 
         (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.mileage ELSE 0 END) AS mileage, 
         (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.turnaround ELSE 0 END) AS turnaround, 
         (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.meal ELSE 0 END) AS meal, 
         (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.taxi ELSE 0 END) AS taxi, 
         (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.retro ELSE 0 END) AS retro, 
         (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.other_taxable_pay ELSE 0 END) AS other_taxable_pay, 
         (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.site_allowance ELSE 0 END) AS site_allowance, 
         timesheet.equipment,   
         timesheet.gl_account,   
         (CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.fringe ELSE 0 END) AS fringe,    
 			(CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.total ELSE 0 END) AS total, 
			(CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.gst_amount ELSE 0 END) AS gst_amount, 
			employee.name,
			(CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.vehicle_allowance_paid ELSE 0 END) AS vehicle_allowance_paid,  
			(CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.pay_in_lieu_of_notice ELSE 0 END) AS pay_in_lieu_of_notice, 
			(CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.retention_earn ELSE 0 END) AS retention_earn, 
			(CASE WHEN timesheet.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' THEN timesheet.recruitment_cost ELSE 0 END) AS recruitment_cost 
    FROM timesheet,   
         employee  
   WHERE ( employee.book = timesheet.book ) and 
			( employee.employee = timesheet.employee ) AND
			( timesheet.book = :as_company ) AND
         ( timesheet.file_type IN ( :as_file_type1, :as_file_type2 ) ) AND
			( timesheet.employee between :an_from_employee and :an_to_employee )  AND 
			( timesheet.cheque_no between :an_from_cheque_no and :an_to_cheque_no )  AND 
			( timesheet.trade_union between :as_from_trade_union and :as_to_trade_union )  AND
         ( ( :as_date_type = 'A' AND  
         timesheet.work_date between :adt_date_from and :adt_date_to ) OR  
         ( :as_date_type = 'C' AND  
         timesheet.transact_datetime >= :adt_date_from and timesheet.transact_datetime < DateAdd(day, 1, :adt_date_to) ) OR  
         ( :as_date_type = 'E' AND  
         timesheet.add_datetime >= :adt_date_from and timesheet.add_datetime < DateAdd(day, 1, :adt_date_to) )  ) AND  
         ( :as_shift = 'A' OR timesheet.shift = :as_shift ) AND  
         (:as_employment_type = 'A' OR timesheet.employment_type = :as_employment_type) AND  
         ((:as_employed = 'A') or (:as_employed = 'Y' and employee.termination_date IS NULL) or (:as_employed = 'N' and employee.termination_date IS NOT NULL)   ) 
ORDER BY timesheet.employee,
			timesheet.cheque_no,
         timesheet.work_date" arguments=(("as_company", string),("as_file_type1", string),("as_file_type2", string),("an_from_employee", number),("an_to_employee", number),("an_from_cheque_no", number),("an_to_cheque_no", number),("as_from_trade_union", string),("as_to_trade_union", string),("adt_date_from", datetime),("adt_date_to", datetime),("as_date_type", string),("as_employment_type", string),("as_shift", string),("as_employed", string),("as_user_access_restricted", string))  sort="timesheet_employee A timesheet_cheque_no A timesheet_work_date A timesheet_timesheet_item A " )
