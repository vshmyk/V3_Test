table(column=(type=char(8) update=yes updatewhereclause=yes key=yes name=book dbname="trade_union_benefit.book" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=trade_union dbname="trade_union_benefit.trade_union" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=effective_date dbname="trade_union_benefit.effective_date" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=benefit_type dbname="trade_union_benefit.benefit_type" )
 column=(type=char(50) updatewhereclause=yes name=description dbname="trade_union_benefit_type.description" )
 column=(type=datetime update=yes updatewhereclause=yes name=expiry_date dbname="trade_union_benefit.expiry_date" )
 column=(type=char(6) update=yes updatewhereclause=yes name=vendor dbname="trade_union_benefit.vendor" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=regular_rate dbname="trade_union_benefit.regular_rate" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=time_and_half_rate dbname="trade_union_benefit.time_and_half_rate" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=overtime_rate dbname="trade_union_benefit.overtime_rate" )
 column=(type=char(8) update=yes updatewhereclause=yes name=add_user_id dbname="trade_union_benefit.add_user_id" )
 column=(type=datetime update=yes updatewhereclause=yes name=add_datetime dbname="trade_union_benefit.add_datetime" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=base_rate dbname="trade_union_benefit.base_rate" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=sched_base_rate dbname="trade_union_benefit.sched_base_rate" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=all_hr_reg_rate dbname="trade_union_benefit.all_hr_reg_rate" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tax_type dbname="trade_union_benefit.tax_type" )
 column=(type=char(1) updatewhereclause=yes name=benefit_source dbname="trade_union_benefit_type.benefit_source" )
 column=(type=char(1) updatewhereclause=yes name=employer_pays_flag dbname="trade_union_benefit_type.employer_pays_flag" )
 column=(type=char(1) updatewhereclause=yes name=pension_or_rrsp dbname="trade_union_benefit_type.pension_or_rrsp" )
 column=(type=char(1) updatewhereclause=yes name=include_holiday_earning_flag dbname="trade_union_benefit_type.include_holiday_earning_flag" )
 column=(type=char(1) updatewhereclause=yes name=employee_must_contribute_flag dbname="trade_union_benefit_type.employee_must_contribute_flag" )
 column=(type=char(3) updatewhereclause=yes name=benefit_source_code dbname="benefit_source_code" )
 column=(type=decimal(4) updatewhereclause=yes name=c_regular_rate dbname="trade_union_benefit.c_regular_rate" )
 column=(type=decimal(4) updatewhereclause=yes name=c_time_and_half_rate dbname="trade_union_benefit.c_time_and_half_rate" )
 column=(type=decimal(4) updatewhereclause=yes name=c_overtime_rate dbname="trade_union_benefit.c_overtime_rate" )
 column=(type=decimal(4) updatewhereclause=yes name=c_base_rate dbname="c_base_rate" )
 column=(type=long updatewhereclause=yes name=rollover_bit dbname="rollover_bit" )
 retrieve="  SELECT trade_union_benefit.book,   
         trade_union_benefit.trade_union,   
         trade_union_benefit.effective_date,   
         trade_union_benefit.benefit_type,   
         trade_union_benefit_type.description,   
         trade_union_benefit.expiry_date,   
         trade_union_benefit.vendor,   
         trade_union_benefit.regular_rate,   
         trade_union_benefit.time_and_half_rate,   
         trade_union_benefit.overtime_rate,   
         trade_union_benefit.add_user_id,   
         trade_union_benefit.add_datetime,   
         trade_union_benefit.base_rate,   
         trade_union_benefit.sched_base_rate,   
         trade_union_benefit.all_hr_reg_rate,
         trade_union_benefit.tax_type,
			trade_union_benefit_type.benefit_source,
			trade_union_benefit_type.employer_pays_flag,
			trade_union_benefit_type.pension_or_rrsp,
			trade_union_benefit_type.include_holiday_earning_flag,
         trade_union_benefit_type.employee_must_contribute_flag ,  
			benefit_source + employer_pays_flag + pension_or_rrsp as benefit_source_code, 
			regular_rate AS c_regular_rate,   
			time_and_half_rate AS c_time_and_half_rate,   
			overtime_rate AS c_overtime_rate,   
			(CASE 
				WHEN base_rate <> 0 THEN base_rate 
			 	WHEN sched_base_rate <> 0 THEN sched_base_rate
			 	ELSE all_hr_reg_rate 
			END )  AS c_base_rate, CONVERT(INT,0) AS rollover_bit  
    FROM trade_union_benefit,   
         trade_union_benefit_type  
   WHERE ( trade_union_benefit.benefit_type = trade_union_benefit_type.benefit_type )    
" update="trade_union_benefit" updatewhere=0 updatekeyinplace=no  sort="employer_pays_flag A IF(benefit_source = 'B', 0, 
IF(pension_or_rrsp = 'P', 1, 
IF(pension_or_rrsp = 'R', 2, 
IF(pension_or_rrsp = 'N', 3, 99))))
 A benefit_type A " )
