compute(band=trailer.2 alignment="1" expression="CASE ( c_benefit_source_code
WHEN 'YN' THEN 'Employer dues'
WHEN 'YP' THEN 'Employer pension'
WHEN 'YR' THEN 'Employer RRSP'
WHEN 'NN' THEN 'Employee dues'
WHEN 'NP' THEN 'Employee pension'
WHEN 'NR' THEN 'Employee RRSP'
ELSE '')

