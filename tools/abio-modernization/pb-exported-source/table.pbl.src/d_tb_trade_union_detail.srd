 retrieve="  SELECT 'I' as action,   
         dbo.trade_union.trade_union,   
         dbo.trade_union.description,   
         dbo.trade_union.pay_period_type,   
         dbo.trade_union.staff_flag,   
         dbo.trade_union.tah_multiplier,   
         dbo.trade_union.ovr_multiplier,   
         dbo.trade_union.dues_on_t4_flag,   
         dbo.trade_union.hours_on_ck_flag,   
         dbo.trade_union.gl_account,   
         dbo.trade_union.active_flag,   
         dbo.trade_union.book,   
         dbo.trade_union.add_user_id,   
         dbo.trade_union.add_datetime,   
         dbo.trade_union.track_vacation_hours_owed_flag,   
         dbo.trade_union.vacation_owed_at_current_rate_flag,   
         dbo.trade_union.include_site_allow_in_empr_rrsp_flag,   
         dbo.trade_union.change_allowed_on_ck_empr_rrsp_flag,   
         dbo.trade_union.trade,   
         dbo.trade_union.province,   
         dbo.trade_union.standard_email_flag,   
         dbo.trade_union.paystubs_email,   
         dbo.trade_union.paystubs_attachment_1,   
         dbo.trade_union.paystubs_attachment_2,   
         dbo.trade_union.trade_union_group  
    FROM dbo.trade_union   
" update="dbo.trade_union" updatewhere=0 updatekeyinplace=no )
