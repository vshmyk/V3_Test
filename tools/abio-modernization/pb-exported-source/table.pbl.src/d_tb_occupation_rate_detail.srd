 retrieve="  SELECT 'I' action, 
			~"occupation_rate~".~"book~",   
         ~"occupation_rate~".~"trade_union~",   
         ~"occupation_rate~".~"occupation~",   
         ~"occupation_rate~".~"effective_date~",   
         ~"occupation_rate~".~"reg_rate~",   
         ~"occupation_rate~".~"tah_rate~",   
         ~"occupation_rate~".~"ovr_rate~",   
         ~"occupation_rate~".~"base_rate~",   
         ~"occupation_rate~".~"file_type~",   
         ~"occupation_rate~".~"add_user_id~",   
         ~"occupation_rate~".~"add_datetime~",   
         ~"occupation_rate~".~"expiry_date~"
    FROM ~"occupation_rate~"   
" update="occupation_rate" updatewhere=1 updatekeyinplace=yes )
