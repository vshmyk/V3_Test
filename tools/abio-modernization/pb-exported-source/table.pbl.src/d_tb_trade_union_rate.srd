         dbo.trade_union_rate.add_datetime,   
         dbo.trade_union_rate.book,   
         dbo.trade_union_rate.employer_monthly_remit,   
         dbo.trade_union_rate.production_bonus_rate,   
         dbo.trade_union_rate.max_monthly_dues,   
         dbo.trade_union_rate.max_monthly_employer_dues,   
         dbo.trade_union_rate.union_vacation_pay_flag,   
         dbo.trade_union_rate.union_statutory_pay_flag,   
         dbo.trade_union_rate.vacation_percent,   
         dbo.trade_union_rate.statutory_percent,   
         dbo.trade_union_rate.remit_vacation_pay_flag,   
         dbo.trade_union_rate.remit_statutory_pay_flag,   
         dbo.trade_union_rate.period_dues_vendor,   
         dbo.trade_union_rate.monthly_remit_vendor,   
         dbo.trade_union_rate.dues_rrsp_reg_hr,   
         dbo.trade_union_rate.dues_rrsp_tah_hr,   
         dbo.trade_union_rate.dues_rrsp_ovr_hr,   
         dbo.trade_union_rate.remit_rrsp_reg_hr,   
         dbo.trade_union_rate.remit_rrsp_tah_hr,   
