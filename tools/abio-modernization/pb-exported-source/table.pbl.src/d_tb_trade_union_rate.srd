         dbo.trade_union_rate.remit_pen_tah_hr,   
         dbo.trade_union_rate.remit_pen_ovr_hr,   
         dbo.trade_union_rate.personal_safety_rate,   
         dbo.trade_union_rate.group_safety_rate,   
         dbo.trade_union_rate.file_type,   
         dbo.trade_union_rate.vacation_pay_type,   
         dbo.trade_union_rate.statutory_pay_type,   
         dbo.trade_union_rate.employer_pension_or_rrsp,   
         dbo.trade_union_rate.employee_pension_or_rrsp,   
         dbo.trade_union_rate.pension_plan_no,   
         dbo.trade_union_rate.dues_type,   
         dbo.trade_union_rate.dues_on_holiday_pay_flag,   
