         dbo.trade_union_rate.include_travel_flag,   
         dbo.trade_union_rate.base_employer_pension_percent,   
         dbo.trade_union_rate.matching_employer_pension_percent,   
         dbo.trade_union_rate.base_employer_rrsp_percent,   
         dbo.trade_union_rate.matching_employer_rrsp_percent,
         dbo.trade_union_rate.remit_earning_type,
         dbo.trade_union_rate.vacation_pay_vendor,
         dbo.trade_union_rate.statutory_pay_vendor,
         dbo.trade_union_rate.weekly_dues,
         dbo.trade_union.pay_period_type,
         dbo.trade_union_rate.note,
         dbo.trade_union_rate.paid_sick_type,
         dbo.trade_union_rate.paid_sick_reg_earn,
         dbo.trade_union_rate.paid_sick_tah_earn,
         dbo.trade_union_rate.paid_sick_ovr_earn,
         dbo.trade_union_rate.paid_sick_reg_hr,
         dbo.trade_union_rate.paid_sick_tah_hr,
         dbo.trade_union_rate.paid_sick_ovr_hr,
         dbo.trade_union_rate.paid_sick_on_holiday_pay_flag,
         dbo.trade_union_rate.sick_pay_in_holiday_earning_flag,
         dbo.trade_union_rate.report_monthly_dues_as,
         dbo.trade_union_rate.dental_plan_access
    FROM dbo.trade_union_rate,   
         dbo.trade_union  
   WHERE ( dbo.trade_union.book = dbo.trade_union_rate.book ) and  
         ( dbo.trade_union.trade_union = dbo.trade_union_rate.trade_union )    
" update="dbo.trade_union_rate" updatewhere=0 updatekeyinplace=no )
