         dbo.federal_tax.a_min_3,   
         dbo.federal_tax.a_min_4,   
         dbo.federal_tax.a_min_5,   
         dbo.federal_tax.r_1,   
         dbo.federal_tax.r_2,   
         dbo.federal_tax.r_3,   
         dbo.federal_tax.r_4,   
         dbo.federal_tax.r_5,   
         dbo.federal_tax.k_1,   
         dbo.federal_tax.k_2,   
         dbo.federal_tax.k_3,   
         dbo.federal_tax.k_4,   
         dbo.federal_tax.k_5,   
         dbo.federal_tax.file_type,   
         dbo.federal_tax.expiry_date,   
         dbo.federal_tax.add_user_id,   
         dbo.federal_tax.add_datetime,   
         dbo.federal_tax.canada_employment_credit,   
         dbo.federal_tax.index_factor_percent,   
         dbo.federal_tax.bpaf_n1_1,   
         dbo.federal_tax.bpaf_n1_2,   
         dbo.federal_tax.bpaf_td_1,   
         dbo.federal_tax.bpaf_td_2,   
         dbo.federal_tax.qpp_annual_allowance,   
         dbo.federal_tax.qpp_multiplier,   
         dbo.federal_tax.qpp_annual_maximum,   
         dbo.federal_tax.qpp_annual_max_earning,   
         dbo.federal_tax.qei_annual_max_premium,   
         dbo.federal_tax.qei_annual_max_earning,   
         dbo.federal_tax.qei_employer_multiplier,   
         dbo.federal_tax.qei_employee_rate,   
         dbo.federal_tax.qpip_annual_max_premium,   
         dbo.federal_tax.qpip_annual_max_earning,   
         dbo.federal_tax.qpip_employer_multiplier,   
         dbo.federal_tax.qpip_employee_rate,   
         dbo.federal_tax.cpp_base_rate,   
         dbo.federal_tax.qpp_base_rate,   
         dbo.federal_tax.cpp_base_maximum,   
         dbo.federal_tax.qpp_base_maximum,   
         dbo.federal_tax.cpp_first_rate,   
         dbo.federal_tax.qpp_first_rate ,   
         dbo.federal_tax.cpp_second_maximum,   
         dbo.federal_tax.qpp_second_maximum,   
         dbo.federal_tax.cpp_second_rate,   
         dbo.federal_tax.qpp_second_rate  
    FROM dbo.federal_tax   
" update="dbo.federal_tax" updatewhere=0 updatekeyinplace=yes )
