 retrieve="  SELECT 'I' as action,   
		   timesheet.book,
         timesheet.employee,   
         timesheet.work_date,   
         timesheet.timesheet_item,   
         timesheet.job,   
         timesheet.area,   
         timesheet.centre,   
         timesheet.equipment,   
         timesheet.gl_account,   
         timesheet.division,   
         timesheet.trade_union,   
         timesheet.occupation,   
         timesheet.wcb_class,   
         timesheet.gst_rule,   
         timesheet.shift,   
         timesheet.use_tm_daily_rate_flag,   
         timesheet.memo,   
         timesheet.pr_yyyymm,   
         timesheet.transact_flag,   
         timesheet.reg_hour,   
         timesheet.tah_hour,   
         timesheet.ovr_hour,   
         timesheet.travel_hour,   
         timesheet.loa_hour,   
         timesheet.mileage_hour,   
         timesheet.base_rate,   
         timesheet.reg_rate,   
         timesheet.tah_rate,   
         timesheet.ovr_rate,   
         timesheet.loa_rate,   
         timesheet.mileage_rate,   
         timesheet.travel_rate,   
         timesheet.reg_earn,   
         timesheet.tah_earn,   
         timesheet.ovr_earn,   
         timesheet.travel_earn,   
         timesheet.loa,   
         timesheet.mileage,   
         timesheet.turnaround,   
         timesheet.site_allowance,   
         timesheet.taxi,   
         timesheet.meal,   
         timesheet.retro,   
         timesheet.other_taxable_pay,   
         timesheet.total,   
         timesheet.fringe,   
         timesheet.gst_amount,   
         timesheet.cheque_no,   
         timesheet.transact_datetime,   
         timesheet.employment_type,   
         timesheet.restrict_flag,   
         timesheet.file_type,   
         timesheet.add_user_id,   
         timesheet.add_datetime,   
         timesheet.timesheet_status,   
         timesheet.vehicle_allowance_paid,   
         timesheet.pay_in_lieu_of_notice,   
         timesheet.tah_spot_flag,   
         timesheet.ovr_spot_flag,   
         timesheet.client_approver,   
         timesheet.invoice_no,   
         timesheet.invoice_date,   
         timesheet.invoice_amount,   
         timesheet.recruitment_cost,   
         timesheet.retention_earn  ,   
         timesheet.crew  ,   
         timesheet.ticket_no,  
         timesheet.field_timesheet_item,  
         IsNull(timesheet.billing_no, labour_dispersion.billing_no) as billing_no,  
         '            ' as cc_reg_hour_total,   
         '            ' as cc_tah_hour_total,   
         '            ' as cc_ovr_hour_total,   
         '            ' as cc_travel_hour_total,   
         '            ' as cc_loa_hour_total,   
         '            ' as cc_mileage_hour_total,   
         '            ' as cc_reg_earn_total,   
         '            ' as cc_tah_earn_total,   
         '            ' as cc_ovr_earn_total,   
         '            ' as cc_travel_earn_total,   
         '            ' as cc_loa_total,   
         '            ' as cc_mileage_total,   
         '            ' as cc_turnaround_total,   
         '            ' as cc_meal_total,   
         '            ' as cc_taxi_total,   
         '            ' as cc_retro_total,   
         '            ' as cc_vehicle_allowance_paid_total,   
         '            ' as cc_other_taxable_pay_total,   
         '            ' as cc_total_total,   
         '            ' as cc_fringe_total,   
         '            ' as cc_site_allowance_total,   
         '            ' as cc_gst_amount_total,   
         '            ' as cc_pay_in_lieu_of_notice_total,   
         0.00 as cc_tah_multiplier,
         0.00 as cc_ovr_multiplier,
         0.00 as cc_premium_total,
         0 as cc_area_group_client_approver_count,
         0 as cc_crew_count,
         0 as cc_equipment_count,
         0 as cc_last_ticket,
         '            ' as work_date_hold,   
         'N' as division_editable,
         'N' as cc_allow_mixed_case_flag,
			'' as cc_name,
			'' as cc_job,
			'' as cc_area,
			'' as cc_centre,
			'' as cc_gl,
			'' as cc_trade_union,
			'' as cc_occupation,
			'' as cc_crew,
			'' as cc_gst_rule,
			'' as cc_division,
			'' as cc_employee_msg,
			'' as cc_equipment,
			'' as cc_client_approver,
			'' as cc_timesheet_status
    FROM timesheet LEFT OUTER JOIN labour_dispersion 
                            ON timesheet.book = labour_dispersion.book 
                               AND timesheet.employee = labour_dispersion.employee 
                               AND timesheet.work_date = labour_dispersion.work_date 
                               AND timesheet.timesheet_item = labour_dispersion.timesheet_item 

" update="timesheet" updatewhere=0 updatekeyinplace=no )
