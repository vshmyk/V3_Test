table(column=(type=char(8) updatewhereclause=yes key=yes name=book dbname="job.book" )
 column=(type=char(6) update=yes updatewhereclause=yes key=yes name=job dbname="job.job" )
 column=(type=char(35) update=yes updatewhereclause=yes name=description dbname="job.description" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=to_date_cost dbname="job.to_date_cost" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=to_date_revenue dbname="job.to_date_revenue" )
 column=(type=decimal(15) update=yes updatewhereclause=yes name=apnet dbname="job.apnet" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=aphbk dbname="job.aphbk" )
 column=(type=decimal(15) update=yes updatewhereclause=yes name=arnet dbname="job.arnet" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=arhbk dbname="job.arhbk" )
 retrieve="  SELECT job.book,
			job.job,
         job.description,
         job.to_date_cost,
         job.to_date_revenue,
         apjob.apnet,
         apjob.aphbk,
         arnet,
         arhbk
    FROM job,
         (  SELECT ap_invoice.job,
                   Sum(ap_invoice.net_out - (
                           CASE WHEN ap_invoice.gst_amount IS NULL OR 
                                     ap_invoice.net_purchase IS NULL OR 
                                     ap_invoice.net_purchase = 0 THEN 0
                                ELSE Round(ap_invoice.gst_amount * ap_invoice.net_out / ap_invoice.net_purchase,2)
                           END)) AS apnet,
                   Sum(ap_invoice.hbk_out) AS aphbk
              FROM ap_invoice
             WHERE ap_invoice.book = :as_book AND
                   ap_invoice.file_type = 'C' AND 
                   ap_invoice.job BETWEEN :as_from_job AND :as_to_job
          GROUP BY job) AS apjob,
         (  SELECT ar_invoice.job,
                   Sum(ar_invoice.net_out - (
                           CASE WHEN ar_invoice.gst_amount IS NULL OR 
                                     ar_invoice.net_purchase IS NULL OR 
                                     ar_invoice.net_purchase = 0 THEN 0
                                ELSE Round(ar_invoice.gst_amount * ar_invoice.net_out / ar_invoice.net_purchase,2)
                           END)) AS arnet,
                   Sum(ar_invoice.hbk_out) AS arhbk
              FROM ar_invoice
             WHERE ar_invoice.book = :as_book AND
                   ar_invoice.file_type = 'C' AND 
                   ar_invoice.job BETWEEN :as_from_job AND :as_to_job
          GROUP BY job) AS arjob
   WHERE arjob.job=job.job AND 
         apjob.job=job.job AND 
         job.book = :as_book AND
         (job.file_type = :as_file_type1 OR  
         job.file_type = :as_file_type2 OR  
         job.file_type = :as_file_type3) AND  
         job.job BETWEEN :as_from_job AND :as_to_job
" update="job" updatewhere=0 updatekeyinplace=no arguments=(("as_book", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string))  sort="job_sort A " )
