table(column=(type=char(6) updatewhereclause=yes name=job dbname="centre.job" dbalias=".job" )
 column=(type=char(5) updatewhereclause=yes name=area dbname="centre.area" dbalias=".area" )
 column=(type=char(5) updatewhereclause=yes name=group_area_ceiling dbname="centre.group_area_ceiling" dbalias=".group_area_ceiling" )
 column=(type=char(6) updatewhereclause=yes name=centre dbname="centre.centre" dbalias=".centre" )
 column=(type=char(6) updatewhereclause=yes name=group_centre_ceiling dbname="centre.group_centre_ceiling" dbalias=".group_centre_ceiling" )
 column=(type=char(50) updatewhereclause=yes name=description dbname="centre.description" dbalias=".description" )
 column=(type=char(7) updatewhereclause=yes name=cost_type dbname="centre.cost_type" dbalias=".cost_type" )
 column=(type=char(20) updatewhereclause=yes name=client_po dbname="centre.client_po" dbalias=".client_po" )
 column=(type=decimal(2) updatewhereclause=yes name=hr_to_date_cost dbname="hr_to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=lab_to_date_cost dbname="lab_to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=adm_hr_to_date_cost dbname="adm_hr_to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=adm_to_date_cost dbname="adm_to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=mtl_to_date_cost dbname="mtl_to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=equ_to_date_cost dbname="equ_to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=own_to_date_cost dbname="own_to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=sub_to_date_cost dbname="sub_to_date_cost" )
 column=(type=char(1) updatewhereclause=yes name=active_flag dbname="centre.active_flag" dbalias=".active_flag" )
 column=(type=char(35) updatewhereclause=yes name=job_description dbname="job.description" dbalias=".description" )
 retrieve="  SELECT centre.job,   
         centre.area,   
         centre.group_area_ceiling,   
         centre.centre,   
         centre.group_centre_ceiling,   
         centre.description,   
         centre.cost_type,   
         centre.client_po,   
         (CASE :as_actual_forecast WHEN 'A' THEN centre.hr_to_date_cost ELSE centre.hr_forecast_amt END) AS hr_to_date_cost,
         (CASE :as_actual_forecast WHEN 'A' THEN centre.lab_to_date_cost ELSE centre.lab_forecast_amt END) AS lab_to_date_cost,
         (CASE :as_actual_forecast WHEN 'A' THEN centre.adm_hr_to_date_cost ELSE centre.adm_hr_forecast_amt END) AS adm_hr_to_date_cost,
         (CASE :as_actual_forecast WHEN 'A' THEN centre.adm_to_date_cost ELSE centre.adm_forecast_amt END) AS adm_to_date_cost,
         (CASE :as_actual_forecast WHEN 'A' THEN centre.mtl_to_date_cost ELSE centre.mtl_forecast_amt END) AS mtl_to_date_cost,
         (CASE :as_actual_forecast WHEN 'A' THEN centre.equ_to_date_cost ELSE centre.equ_forecast_amt END) AS equ_to_date_cost,
         (CASE :as_actual_forecast WHEN 'A' THEN centre.own_to_date_cost ELSE centre.own_forecast_amt END) AS own_to_date_cost,
         (CASE :as_actual_forecast WHEN 'A' THEN centre.sub_to_date_cost ELSE centre.sub_forecast_amt END) AS sub_to_date_cost,
         centre.active_flag,   
         job.description  
    FROM centre,   
         job LEFT OUTER JOIN region ON 
			job.region = region.region 
   WHERE centre.job = job.job AND
         centre.book = :as_book AND
         job.book = :as_book AND
         (centre.file_type = :as_file_type1 OR  
         centre.file_type = :as_file_type2 OR  
         centre.file_type = :as_file_type3) AND  
         centre.job BETWEEN :as_from_job AND :as_to_job AND
         centre.area BETWEEN :as_from_area AND :as_to_area AND
         centre.centre BETWEEN :as_from_centre AND :as_to_centre AND
         ((:as_access_restricted_data = 'N' AND centre.restrict_flag = 'N') OR :as_access_restricted_data = 'Y') AND 
			((:as_region_type = 'A' AND (:as_region = 'ALL' OR job.region = :as_region)) OR ( :as_region_type = 'P' AND (:as_region = 'ALL' OR region.parent_region = :as_region)))
ORDER BY centre.job ASC,   
         centre.area ASC,   
         centre.centre ASC   
" arguments=(("as_book", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string),("as_from_area", string),("as_to_area", string),("as_from_centre", string),("as_to_centre", string),("as_actual_forecast", string),("as_access_restricted_data", string),("as_region", string),("as_region_type", string))  sort="job A area A centre A client_po A " )
