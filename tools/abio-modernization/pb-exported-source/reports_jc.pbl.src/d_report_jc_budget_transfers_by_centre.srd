table(column=(type=long updatewhereclause=yes name=transfer_no dbname="budget_transfer.transfer_no" )
 column=(type=long updatewhereclause=yes name=transfer_item dbname="budget_transfer.transfer_item" )
 column=(type=datetime updatewhereclause=yes name=transfer_date dbname="budget_transfer.transfer_date" )
 column=(type=char(35) updatewhereclause=yes name=reason dbname="budget_transfer.reason" )
 column=(type=char(6) updatewhereclause=yes name=job dbname="budget_transfer.job" )
 column=(type=char(5) updatewhereclause=yes name=area dbname="budget_transfer.area" )
 column=(type=char(6) updatewhereclause=yes name=centre dbname="budget_transfer.centre" )
 column=(type=char(1) updatewhereclause=yes name=cost_type dbname="budget_transfer.cost_type" )
 column=(type=char(20) updatewhereclause=yes name=client_po dbname="budget_transfer.client_po" )
 column=(type=char(6) updatewhereclause=yes name=po_item dbname="budget_transfer.po_item" )
 column=(type=char(50) updatewhereclause=yes name=description dbname="budget_transfer.description" )
 column=(type=decimal(2) updatewhereclause=yes name=change_hours dbname="budget_transfer.change_hours" )
 column=(type=decimal(2) updatewhereclause=yes name=change_quantity dbname="budget_transfer.change_quantity" )
 column=(type=decimal(2) updatewhereclause=yes name=change_amount dbname="budget_transfer.change_amount" )
 column=(type=char(4) updatewhereclause=yes name=unit dbname="budget_transfer.unit" )
 column=(type=char(1) updatewhereclause=yes name=applied_flag dbname="budget_transfer.applied_flag" )
 column=(type=char(1) updatewhereclause=yes name=budget_type dbname="budget_transfer.budget_type" )
 column=(type=char(1) updatewhereclause=yes name=file_type dbname="budget_transfer.file_type" )
 column=(type=char(50) updatewhereclause=yes name=centre_description dbname="centre.description" )
 retrieve="select	budget_transfer.transfer_no,
			budget_transfer.transfer_item,
			budget_transfer.transfer_date,
			budget_transfer.reason,
			budget_transfer.job,
			budget_transfer.area,
			budget_transfer.centre,
			budget_transfer.cost_type,
			budget_transfer.client_po,
			budget_transfer.po_item,
			budget_transfer.description,
			budget_transfer.change_hours,
			budget_transfer.change_quantity,
			budget_transfer.change_amount,
			budget_transfer.unit,
			budget_transfer.applied_flag,
			budget_transfer.budget_type,
			budget_transfer.file_type,
			centre.description 
	from	budget_transfer, centre
	where	budget_transfer.book = :as_company
			and budget_transfer.book = centre.book  
			and budget_transfer.job = centre.job 
			and budget_transfer.area = centre.area 
			and budget_transfer.centre = centre.centre 
			and budget_transfer.job between :as_from_job and :as_to_job
			and budget_transfer.area between :as_from_area and :as_to_area
			and budget_transfer.centre between :as_from_centre and :as_to_centre
			and budget_transfer.transfer_date between :adt_from_date and :adt_to_date
			and budget_transfer.transfer_no between :an_from_transfer_no and :an_to_transfer_no
			and ( :as_budget_type = 'A' or budget_transfer.budget_type = :as_budget_type )
			and ( :as_applied_flag = 'A' or budget_transfer.applied_flag = :as_applied_flag )
			and budget_transfer.file_type in ( :as_file_type1, :as_file_type2 )
ORDER BY budget_transfer.book, 	  budget_transfer.job,	  budget_transfer.area,	  budget_transfer.centre" arguments=(("as_company", string),("as_from_job", string),("as_to_job", string),("as_from_area", string),("as_to_area", string),("as_from_centre", string),("as_to_centre", string),("adt_from_date", datetime),("adt_to_date", datetime),("an_from_transfer_no", number),("an_to_transfer_no", number),("as_budget_type", string),("as_applied_flag", string),("as_file_type1", string),("as_file_type2", string))  sort="job A area A centre A transfer_date A transfer_no A transfer_item A " )
