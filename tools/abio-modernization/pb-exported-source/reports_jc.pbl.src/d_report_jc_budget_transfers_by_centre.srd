compute(band=header alignment="2" expression="f_mixed_case(f_budget_transfer_no( an_from_transfer_no, an_to_transfer_no )                           + ', ' + f_job( as_from_job, as_to_job )
+ ', ' + f_area( as_from_area, as_to_area )
+ ', ' + f_centre( as_from_centre, as_to_centre )
+ ', ' + f_date( adt_from_date, adt_to_date )                                                             + case(  as_applied_flag  when 'A' then '' when 'Y' then ', applied' else ', not applied')
 + case(as_budget_type when 'A' then '' when 'O' then ', only original budget' else ', only current budget') 
