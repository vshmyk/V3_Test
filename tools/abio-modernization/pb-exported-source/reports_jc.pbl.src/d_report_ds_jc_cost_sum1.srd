table(column=(type=decimal(2) update=yes updatewhereclause=yes name=tamth dbname="tamth" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=tamtl dbname="tamtl" )
 column=(type=decimal(2) updatewhereclause=yes name=tamth_adm dbname="tamth_adm" )
 column=(type=decimal(2) updatewhereclause=yes name=tamtl_adm dbname="tamtl_adm" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=tamtm dbname="tamtm" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=tamte dbname="tamte" )
 column=(type=decimal(2) updatewhereclause=yes name=tamte_own dbname="tamte_own" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=tamts dbname="tamts" )
 retrieve="  SELECT Sum(centre.hr_to_date_cost) AS tamth,   
         Sum(centre.lab_to_date_cost) AS tamtl,   
         Sum(centre.adm_hr_to_date_cost) AS tamth_adm,   
         Sum(centre.adm_to_date_cost) AS tamtl_adm,   
         Sum(centre.mtl_to_date_cost) AS tamtm,   
         Sum(centre.equ_to_date_cost) AS tamte,   
         Sum(centre.own_to_date_cost) AS tamte_own,   
         Sum(centre.sub_to_date_cost) AS tamts
    FROM centre  
   WHERE centre.book = :as_book AND 
         centre.job = :as_job AND  
         centre.area BETWEEN :as_from_area AND :as_to_area AND  
         centre.centre BETWEEN :as_from_centre AND :as_to_centre
" arguments=(("as_book", string),("as_job", string),("as_from_area", string),("as_to_area", string),("as_from_centre", string),("as_to_centre", string)) )
