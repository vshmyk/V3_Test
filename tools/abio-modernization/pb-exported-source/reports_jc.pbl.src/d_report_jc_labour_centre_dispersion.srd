compute(band=header alignment="2" expression="f_mixed_case(IF(as_from_job = '0' AND as_to_job = 'ZZZZZZ', ~"All jobs~", 
f_job( as_from_job, as_to_job ))
+ ', ' + f_area( as_from_area, as_to_area )
+ ', ' + f_centre( as_from_centre, as_to_centre )
+ ', ' + f_ref(  as_from_reference, as_to_reference )
+ ', ' + f_trade_union( as_from_trade_union, as_to_trade_union )
+ ', ' + f_yyyydd( as_from_yyyymm, as_to_yyyymm )
+ ', ' + f_date_type( as_date_type, adt_from_date, adt_to_date )
+ ', ' + If( as_source = 'ALL', '', 'source ' + as_source )
