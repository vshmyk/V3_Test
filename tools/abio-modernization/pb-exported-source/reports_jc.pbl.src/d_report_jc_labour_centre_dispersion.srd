 column=(type=decimal(2) updatewhereclause=yes name=retention dbname="labour_dispersion.retention" )
 column=(type=char(12) updatewhereclause=yes name=ticket_no dbname="timesheet.ticket_no" )
 column=(type=char(35) updatewhereclause=yes name=job_description dbname="job.description" )
 retrieve="  SELECT labour_dispersion.book,   
         labour_dispersion.employee,   
         labour_dispersion.work_date,   
         labour_dispersion.dispersion_item,   
         labour_dispersion.job,   
         labour_dispersion.area,   
         labour_dispersion.centre,   
         labour_dispersion.timesheet_item,   
         labour_dispersion.timesheet_job,   
         labour_dispersion.timesheet_area,   
         labour_dispersion.timesheet_centre,   
         labour_dispersion.source,   
         labour_dispersion.trade_union,   
         labour_dispersion.occupation,   
         labour_dispersion.shift,   
         labour_dispersion.gl_yyyymm,   
         labour_dispersion.reg_hour,   
         labour_dispersion.tah_hour,   
         labour_dispersion.ovr_hour,   
         labour_dispersion.loa_hour,   
         labour_dispersion.sched_premium_hour,   
         labour_dispersion.spot_premium_hour,   
         labour_dispersion.shut_premium_hour,   
         labour_dispersion.meal,   
         labour_dispersion.subsistence,   
         labour_dispersion.rotation,   
         labour_dispersion.site_allowance,   
         labour_dispersion.retro,   
         labour_dispersion.fringe,   
         labour_dispersion.overhead,   
         labour_dispersion.cost,   
         labour_dispersion.reg_rate,   
         labour_dispersion.tah_rate,   
         labour_dispersion.ovr_rate,   
         labour_dispersion.loa_rate,   
         labour_dispersion.extract_date,   
         labour_dispersion.extract_reference,   
         labour_dispersion.snapshot_date,   
         labour_dispersion.file_type,
			employee.name as employee_name,
         centre.description,
         labour_dispersion.recruitment,
         labour_dispersion.retention, 
			timesheet.ticket_no,
			job.description
	FROM	labour_dispersion 
			INNER JOIN centre ON
								 centre.book = labour_dispersion.book
								and centre.job = labour_dispersion.job
								and centre.area = labour_dispersion.area
								and centre.centre = labour_dispersion.centre
								AND ( centre.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' ) 
			INNER JOIN employee ON
								 employee.book = labour_dispersion.book
								and employee.employee = labour_dispersion.employee
								AND ( employee.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' ),
			timesheet, job 
   WHERE	labour_dispersion.book = job.book 
			and labour_dispersion.job = job.job
			and labour_dispersion.book = :as_company
			and labour_dispersion.book = timesheet.book 
			and labour_dispersion.employee = timesheet.employee 
			and labour_dispersion.work_date = timesheet.work_date 
			and labour_dispersion.timesheet_item = timesheet.timesheet_item 
			and labour_dispersion.file_type in ( :as_file_type1, :as_file_type2 )
			and labour_dispersion.job between :as_from_job and :as_to_job
			and labour_dispersion.area between :as_from_area and :as_to_area
			and labour_dispersion.centre between :as_from_centre and :as_to_centre
			and UPPER( labour_dispersion.extract_reference ) between :as_from_reference and :as_to_reference
			and labour_dispersion.trade_union between :as_from_trade_union and :as_to_trade_union
			and labour_dispersion.gl_yyyymm between :as_from_yyyymm and :as_to_yyyymm
         and (		( :as_date_type = 'A' AND labour_dispersion.work_date >= :adt_from_date  AND labour_dispersion.work_date < DATEADD( day, 1, :adt_to_date ) )
					OR ( :as_date_type = 'S' AND labour_dispersion.snapshot_date >= :adt_from_date AND labour_dispersion.snapshot_date < DATEADD( day, 1, :adt_to_date ))
					OR ( :as_date_type = 'E' 
							AND labour_dispersion.add_datetime >= :adt_from_date 
							AND labour_dispersion.add_datetime < DATEADD( day, 1, :adt_to_date )
							AND (RIGHT('0' + CAST(datepart(HH, labour_dispersion.add_datetime) AS VARCHAR), 2) + ':' + 
								  RIGHT('0' + CAST(datepart(MI, labour_dispersion.add_datetime) AS VARCHAR), 2) + ':' + 
								  RIGHT('0' + CAST(datepart(SS, labour_dispersion.add_datetime) AS VARCHAR), 2) BETWEEN :as_from_time AND :as_to_time))
					OR (	:as_date_type = 'X'
							AND labour_dispersion.extract_date >= :adt_from_date
							AND labour_dispersion.extract_date < DATEADD( day, 1, :adt_to_date ) )
					OR	(	:as_date_type = 'N'
							AND labour_dispersion.extract_date IS NULL
							and labour_dispersion.work_date between :adt_from_date and :adt_to_date ) )
			and ( :as_source = 'ALL' or labour_dispersion.source = REPLACE( :as_source, '/', '' ) )
" arguments=(("as_company", string),("as_file_type1", string),("as_file_type2", string),("as_from_job", string),("as_to_job", string),("as_from_area", string),("as_to_area", string),("as_from_centre", string),("as_to_centre", string),("as_from_reference", string),("as_to_reference", string),("as_from_trade_union", string),("as_to_trade_union", string),("as_from_yyyymm", string),("as_to_yyyymm", string),("adt_from_date", datetime),("adt_to_date", datetime),("as_date_type", string),("as_source", string),("as_user_access_restricted", string),("as_from_time", string),("as_to_time", string))  sort="labour_dispersion_job A labour_dispersion_area A labour_dispersion_centre A labour_dispersion_trade_union A labour_dispersion_occupation A labour_dispersion_work_date A labour_dispersion_timesheet_job A labour_dispersion_timesheet_area A labour_dispersion_timesheet_centre A labour_dispersion_employee A labour_dispersion_timesheet_item A " )
