table(column=(type=char(8) updatewhereclause=yes name=book dbname="book" )
 column=(type=char(2) updatewhereclause=yes name=source dbname="source" )
 column=(type=char(30) updatewhereclause=yes name=entity dbname="entity" )
 column=(type=char(30) updatewhereclause=yes name=inv_or_date dbname="inv_or_date" )
 column=(type=long updatewhereclause=yes name=item dbname="item" )
 column=(type=char(6) updatewhereclause=yes name=job dbname="job" )
 column=(type=char(35) updatewhereclause=yes name=job_description dbname="job_description" )
 column=(type=char(5) updatewhereclause=yes name=area dbname="area" )
 column=(type=char(35) updatewhereclause=yes name=area_description dbname="area_description" )
 column=(type=char(6) updatewhereclause=yes name=centre dbname="centre" )
 column=(type=char(50) updatewhereclause=yes name=centre_description dbname="centre_description" )
 column=(type=char(6) updatewhereclause=yes name=client dbname="client" )
 column=(type=char(35) updatewhereclause=yes name=name dbname="NAME" )
 column=(type=char(6) updatewhereclause=yes name=region dbname="region" )
 column=(type=char(25) updatewhereclause=yes name=region_description dbname="region_description" )
 column=(type=char(6) updatewhereclause=yes name=parent_region dbname="parent_region" )
 column=(type=char(25) updatewhereclause=yes name=parent_region_description dbname="parent_region_description" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=revenue dbname="revenue" )
 column=(type=decimal(2) updatewhereclause=yes name=revenue_hrs dbname="revenue_hrs" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=revenue_lab dbname="revenue_lab" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=revenue_mtl dbname="revenue_mtl" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=revenue_equ dbname="revenue_equ" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=revenue_sub dbname="revenue_sub" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=costs dbname="costs" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=costs_hrs dbname="costs_hrs" )
 column=(type=decimal(6) updatewhereclause=yes identity=yes name=costs_lab dbname="costs_lab" )
 column=(type=decimal(6) updatewhereclause=yes identity=yes name=costs_mtl dbname="costs_mtl" )
 column=(type=decimal(6) updatewhereclause=yes identity=yes name=costs_equ dbname="costs_equ" )
 column=(type=decimal(6) updatewhereclause=yes identity=yes name=costs_sub dbname="costs_sub" )
 retrieve="SELECT job_cost_revenue.book,
       source,
       entity,
       inv_or_date,
       item,
       job.job,
       job.description           AS job_description,
       area.area,
       area.description          AS area_description,
       centre.centre,
       centre.description        AS centre_description,
       client.client,
       client.NAME,
       region.region,
       region.description        AS region_description,
       region.parent_region,
       parent_region.description AS parent_region_description,
       revenue              AS revenue,
       revenue_hrs          AS revenue_hrs,
       revenue_lab          AS revenue_lab,
       revenue_mtl          AS revenue_mtl,
       revenue_equ          AS revenue_equ,
       revenue_sub          AS revenue_sub,
       costs                AS costs,
       costs_hrs            AS costs_hrs,
       costs_lab            AS costs_lab,
       costs_mtl            AS costs_mtl,
       costs_equ            AS costs_equ,
       costs_sub            AS costs_sub
FROM   (/* A/R invoices are revenue */
       SELECT ar_invoice.book                                                                                   AS book,
              'AR'                                                                                              AS source,
              ar_invoice.client                                                                                 AS entity,
              ar_invoice.invoice_no                                                                             AS inv_or_date,
              ar_invoice.invoice_item                                                                           AS item,
              ar_invoice.ar_yyyymm                                                                              AS gl_yyyymm,
              ar_invoice.job                                                                                    AS job,
              ar_invoice.area                                                                                   AS area,
              ar_invoice.centre                                                                                 AS centre,
              ar_invoice.net_purchase
              + ar_invoice.hbk_purchase - ar_invoice.gst_amount - ar_invoice.pst_amount - ar_invoice.hst_amount AS revenue,
              ar_invoice.reg_hour + ar_invoice.tah_hour
              + ar_invoice.ovr_hour                                                                             AS revenue_hrs,
              ar_invoice.lab_amount                                                                             AS revenue_lab,
              ar_invoice.mtl_amount                                                                             AS revenue_mtl,
              ar_invoice.equ_amount                                                                             AS revenue_equ,
              ar_invoice.sub_amount                                                                             AS revenue_sub,
              0.00                                                                                              AS costs,
              0.00                                                                                              AS costs_hrs,
              0.00                                                                                              AS costs_lab,
              0.00                                                                                              AS costs_mtl,
              0.00                                                                                              AS costs_equ,
              0.00                                                                                              AS costs_sub
       FROM   ar_invoice WITH (nolock)
       UNION ALL
       /* A/P invoices are costs */
       SELECT ap_invoice.book,
              'AP'                                                                      AS source,
              ap_invoice.vendor                                                         AS entity,
              ap_invoice.invoice_no                                                     AS inv_or_date,
              ap_invoice.invoice_item                                                   AS item,
              ap_invoice.ap_yyyymm                                                      AS gl_yyyymm,
              ap_invoice.job,
              ap_invoice.area,
              ap_invoice.centre,
              0.00                                                                      AS revenue,
              0.00                                                                      AS revenue_hrs,
              0.00                                                                      AS revenue_lab,
              0.00                                                                      AS revenue_mtl,
              0.00                                                                      AS revenue_equ,
              0.00                                                                      AS revenue_sub,
              ap_invoice.net_purchase
              + ap_invoice.hbk_purchase - ap_invoice.gst_amount - ap_invoice.hst_amount AS costs,
              0.00                                                                      AS costs_hrs,
              CASE
                WHEN ap_invoice.gl_account = sca.jc_lab_cost THEN ( ap_invoice.quantity * ap_invoice.rate ) + ap_invoice.pst_amount
                ELSE 0.00
              END                                                                       AS costs_lab,
              CASE
                WHEN ap_invoice.gl_account = sca.jc_mtl_cost
                      OR ap_invoice.gl_account = sca.jc_mtl_cost_rent
                      OR ap_invoice.gl_account = sca.jc_mtl_cost_lease THEN ( ap_invoice.quantity * ap_invoice.rate ) + ap_invoice.pst_amount
                ELSE 0.00
              END                                                                       AS costs_mtl,
              CASE
                WHEN ap_invoice.gl_account = sca.jc_equ_cost THEN ( ap_invoice.quantity * ap_invoice.rate ) + ap_invoice.pst_amount
                ELSE 0.00
              END                                                                       AS costs_equ,
              CASE
                WHEN ap_invoice.gl_account = sca.jc_sub_cost THEN ( ap_invoice.quantity * ap_invoice.rate ) + ap_invoice.pst_amount
                ELSE 0.00
              END                                                                       AS costs_sub
       FROM   standard_control_account sca,
              ap_invoice WITH (nolock)
       WHERE  ( ( :as_user_access_restricted = 'N'
                  AND ap_invoice.restrict_flag = 'N' )
                 OR :as_user_access_restricted = 'Y' )
        UNION ALL
        /* Payroll costs */
        SELECT labour_dispersion.book,
               'PR'                                               AS source,
               Cast(labour_dispersion.employee AS VARCHAR)        AS entity,
               CONVERT(VARCHAR, labour_dispersion.work_date, 102) AS inv_or_date,
               labour_dispersion.dispersion_item                  AS item,
               labour_dispersion.gl_yyyymm  AS gl_yyyymm,
               labour_dispersion.job        AS job,
               labour_dispersion.area       AS area,
               labour_dispersion.centre     AS centre,
               0.00                         AS revenue,
               0.00                         AS revenue_hrs,
               0.00                         AS revenue_lab,
               0.00                         AS revenue_mtl,
               0.00                         AS revenue_equ,
               0.00                         AS revenue_sub,
               labour_dispersion.cost       AS costs,
               labour_dispersion.reg_hour
               + labour_dispersion.tah_hour
               + labour_dispersion.ovr_hour AS costs_hrs,
               labour_dispersion.cost       AS costs_lab,
               0.00                         AS costs_mtl,
               0.00                         AS costs_equ,
               0.00                         AS costs_sub
        FROM   labour_dispersion WITH (nolock)) job_cost_revenue
       LEFT OUTER JOIN job
                    ON job.book = job_cost_revenue.book
                       AND job.job = job_cost_revenue.job
       LEFT OUTER JOIN area
                    ON area.book = job_cost_revenue.book
                       AND area.job = job_cost_revenue.job
                       AND area.area = job_cost_revenue.area
       LEFT OUTER JOIN centre
                    ON centre.book = job_cost_revenue.book
                       AND centre.job = job_cost_revenue.job
                       AND centre.area = job_cost_revenue.area
                       AND centre.centre = job_cost_revenue.centre
       LEFT OUTER JOIN client
                    ON job.book = client.book
                       AND job.client = client.client
       LEFT OUTER JOIN region
                    ON job.region = region.region
       LEFT OUTER JOIN region parent_region
                    ON region.parent_region = parent_region.region
WHERE  job_cost_revenue.book = :as_company
       AND ( job.file_type = :as_file_type1
              OR job.file_type = :as_file_type2
              OR job.file_type = :as_file_type3 )
       AND job_cost_revenue.job BETWEEN :as_from_job AND :as_to_job
       AND job_cost_revenue.area BETWEEN :as_from_area AND :as_to_area
       AND job_cost_revenue.centre BETWEEN :as_from_centre AND :as_to_centre
       AND job_cost_revenue.gl_yyyymm BETWEEN :as_from_YYYYMM AND :as_to_YYYYMM
       AND ( ( :as_region_type = 'A'
               AND ( :as_region = 'ALL'
                      OR Isnull(job.region, '') = :as_region ) )
              OR ( :as_region_type = 'P'
                   AND ( :as_region = 'ALL'
                          OR Isnull(region.parent_region, '') = :as_region ) ) )
" retrieve.asneeded=yes arguments=(("as_company", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string),("as_from_area", string),("as_to_area", string),("as_from_centre", string),("as_to_centre", string),("as_from_YYYYMM", string),("as_to_YYYYMM", string),("as_region", string),("as_region_type", string),("as_user_access_restricted", string))  sort="source A inv_or_date A " )
