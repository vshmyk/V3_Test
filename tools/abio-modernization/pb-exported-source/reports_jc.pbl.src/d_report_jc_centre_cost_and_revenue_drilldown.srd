compute(band=detail alignment="0" expression=" case( source 
when 'JE' 
then  'J/E # ' + entity + ' , item  ' + String(item)
when 'AP' 
then 'A/P inv: ' + entity + ' / ' + inv_or_date + ' / ' + String(item)
when 'AR' 
then 'A/R inv: ' + entity + ' / ' + inv_or_date + ' / ' + String(item)
else  'P/R: ' + entity + ' / ' + inv_or_date + ' / ' + String(item))
