 retrieve="SELECT Sum(centre.hr_orig_budget_amt) AS cbamth,
       Sum(centre.lab_orig_budget_amt) AS cbamtl,
       Sum(centre.mtl_orig_budget_amt) AS cbamtm,
       Sum(centre.equ_orig_budget_amt) AS cbamte,
       Sum(centre.sub_orig_budget_amt) AS cbamts,
       Sum(centre.adm_hr_orig_budget_amt) as adm_cbamth,
       sum(centre.adm_orig_budget_amt) as adm_cbamtl,
       sum(centre.own_orig_budget_amt) as own_cbamte,

       Sum(centre.hr_snapshot_forecast) AS famth,
       Sum(centre.lab_snapshot_forecast) AS famtl,
       Sum(centre.mtl_snapshot_forecast) AS famtm,
       Sum(centre.equ_snapshot_forecast) AS famte,
       Sum(centre.sub_snapshot_forecast) AS famts,
       sum(centre.adm_hr_snapshot_forecast) as adm_famth,
       sum(centre.adm_snapshot_forecast) as adm_famtl,
       sum(centre.own_snapshot_forecast) as own_famte,

       Sum(centre.hr_snapshot_cost) AS tamth,
       Sum(centre.lab_snapshot_cost) AS tamtl,
       Sum(centre.mtl_snapshot_cost) AS tamtm,
       Sum(centre.equ_snapshot_cost) AS tamte,
       Sum(centre.sub_snapshot_cost) AS tamts,
       sum(centre.adm_hr_snapshot_cost) as adm_tamth,
       sum(centre.adm_snapshot_cost) as adm_tamtl,
       sum(centre.own_snapshot_cost) as own_tamte,

       Sum(centre.lab_snapshot_commit) AS camtl,
       Sum(centre.mtl_snapshot_commit) AS camtm,
       Sum(centre.equ_snapshot_commit) AS camte,
       Sum(centre.sub_snapshot_commit) AS camts,
       Sum(centre.sub_snapshot_commit) AS camts,
       sum(centre.adm_snapshot_commit) as adm_camtl,
       sum(centre.own_snapshot_commit) as own_camte,

       Sum(centre.sched_premium_hour) AS prem,
       Sum(centre.shut_premium_hour) AS shut,
       Sum(centre.spot_premium_hour) AS spot,
       sum(centre.adm_sched_premium_hour) as adm_prem,
       sum(centre.adm_shut_premium_hour) as adm_shut,
       sum(centre.adm_spot_premium_hour) as adm_spot

  FROM centre    WITH (NOLOCK)
 WHERE centre.book = :as_book AND
       centre.job = :as_job AND
       centre.area BETWEEN :as_from_area AND :as_to_area AND
       centre.centre BETWEEN :as_from_centre AND :as_to_centre
" arguments=(("as_book", string),("as_job", string),("as_from_area", string),("as_to_area", string),("as_from_centre", string),("as_to_centre", string)) )
