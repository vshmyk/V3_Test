table(column=(type=char(6) updatewhereclause=yes name=job dbname="area.job" )
 column=(type=char(35) updatewhereclause=yes name=job_desc dbname="job.job_desc" )
 column=(type=char(5) updatewhereclause=yes name=area dbname="area.area" )
 column=(type=char(35) updatewhereclause=yes name=area_desc dbname="area.area_desc" )
 column=(type=char(5) updatewhereclause=yes name=dispersion_type dbname="area.dispersion_type" )
 column=(type=char(1) updatewhereclause=yes name=file_type dbname="area.file_type" )
 column=(type=char(5) updatewhereclause=yes name=area_area_group dbname="area.area_group" )
 column=(type=char(1) updatewhereclause=yes name=area_active_flag dbname="area.active_flag" )
 retrieve="  SELECT area.job,
         job.description AS job_desc,
         area.area,
         area.description AS area_desc,
         area.dispersion_type,
         area.file_type,
         area.area_group,
         area.active_flag
    FROM job,
         area
   WHERE area.job = job.job AND
         area.book = :as_book AND
         job.book = :as_book AND
         (area.file_type = :as_file_type1 OR  
         area.file_type = :as_file_type2 OR  
         area.file_type = :as_file_type3) AND  
         area.job BETWEEN :as_from_job AND :as_to_job AND
         area.area BETWEEN :as_from_area AND :as_to_area
" arguments=(("as_book", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string),("as_from_area", string),("as_to_area", string))  sort="job_sort A area_sort A " )
group(level=1 header.height=0 header.height.autosize=yes trailer.height=0 by=("job" ) header.color="536870912" header.transparency="0" header.gradient.color="8421504" header.gradient.transparency="0" header.gradient.angle="0" header.brushmode="0" header.gradient.repetition.mode="0" header.gradient.repetition.count="0" header.gradient.repetition.length="100" header.gradient.focus="0" header.gradient.scale="100" header.gradient.spread="100" trailer.color="536870912" trailer.transparency="0" trailer.gradient.color="8421504" trailer.gradient.transparency="0" trailer.gradient.angle="0" trailer.brushmode="0" trailer.gradient.repetition.mode="0" trailer.gradient.repetition.count="0" trailer.gradient.repetition.length="100" trailer.gradient.focus="0" trailer.gradient.scale="100" trailer.gradient.spread="100" )
