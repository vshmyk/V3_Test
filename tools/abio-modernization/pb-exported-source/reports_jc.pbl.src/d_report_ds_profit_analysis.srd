$PBExportHeader$d_report_ds_profit_analysis.srd
release 11;
datawindow(units=0 timer_interval=0 color=67108864 processing=0 HTMLDW=no print.printername="" print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.canusedefaultprinter=yes print.prompt=no print.buttons=no print.preview.buttons=no print.cliptext=no print.overrideprintjob=no print.collate=yes print.preview.outline=yes hidegrayline=no showbackcoloronxp=no )
header(height=120 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=char(6) updatewhereclause=yes name=job dbname="centre.job" dbalias=".job" )
 column=(type=char(5) updatewhereclause=yes name=area dbname="centre.area" dbalias=".area" )
 column=(type=char(5) updatewhereclause=yes name=group_area_ceiling dbname="centre.group_area_ceiling" dbalias=".group_area_ceiling" )
 column=(type=char(6) updatewhereclause=yes name=centre dbname="centre.centre" dbalias=".centre" )
 column=(type=char(6) updatewhereclause=yes name=group_centre_ceiling dbname="centre.group_centre_ceiling" dbalias=".group_centre_ceiling" )
 column=(type=char(50) updatewhereclause=yes name=description dbname="centre.description" dbalias=".description" )
 column=(type=char(5) updatewhereclause=yes name=cost_type dbname="centre.cost_type" dbalias=".cost_type" )
 column=(type=char(35) updatewhereclause=yes name=job_description dbname="job.description" dbalias=".description" )
 retrieve="  SELECT centre.job,   
         centre.area,   
         centre.group_area_ceiling,   
         centre.centre,   
         centre.group_centre_ceiling,   
         centre.description,   
         centre.cost_type,   
         job.description  
    FROM centre WITH (NOLOCK),   
         job  
   WHERE centre.job = job.job AND
         centre.book = :as_book AND
         job.book = :as_book AND
         (centre.file_type = :as_file_type1 OR  
         centre.file_type = :as_file_type2 OR  
         centre.file_type = :as_file_type3) AND  
         centre.job BETWEEN :as_from_job AND :as_to_job AND
         centre.area BETWEEN :as_from_area AND :as_to_area AND
         centre.centre BETWEEN :as_from_centre AND :as_to_centre AND
         Right(centre.centre,4) = '0000' AND
         centre.cost_type = 'G' AND
         ((:as_access_restricted_data = 'N' AND centre.restrict_flag = 'N') OR :as_access_restricted_data = 'Y')
ORDER BY centre.job ASC,   
         centre.area ASC,   
         centre.centre ASC   
" arguments=(("as_book", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string),("as_from_area", string),("as_to_area", string),("as_from_centre", string),("as_to_centre", string),("as_access_restricted_data", string))  sort="job A area A centre A " )
