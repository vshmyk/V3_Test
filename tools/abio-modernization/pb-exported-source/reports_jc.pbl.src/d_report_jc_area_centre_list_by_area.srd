table(column=(type=char(6) updatewhereclause=yes name=job dbname="centre.job" )
 column=(type=char(35) updatewhereclause=yes name=job_desc dbname="job.job_desc" )
 column=(type=char(5) updatewhereclause=yes name=area dbname="centre.area" )
 column=(type=char(35) updatewhereclause=yes name=area_desc dbname="area.area_desc" )
 column=(type=char(6) updatewhereclause=yes name=centre dbname="centre.centre" )
 column=(type=char(20) updatewhereclause=yes name=client_po dbname="centre.client_po" )
 column=(type=char(40) updatewhereclause=yes name=po_desc dbname="client_po.po_desc" )
 column=(type=char(6) updatewhereclause=yes name=po_item dbname="centre.po_item" )
 column=(type=char(6) updatewhereclause=yes name=type dbname="type" )
 column=(type=char(50) updatewhereclause=yes name=description dbname="centre.description" )
 column=(type=char(1) updatewhereclause=yes name=centre_active_flag dbname="centre.active_flag" )
 column=(type=long updatewhereclause=yes name=sort dbname="sort" )
 retrieve="  SELECT centre.job,
         job.description AS job_desc,
         centre.area,
         area.description AS area_desc,
         centre.centre,
         centre.client_po,
         client_po.description AS po_desc,
         centre.lab_po_item AS po_item,
         Left(Replace(Replace(centre.cost_type, 'R', ''), 'G', ''), 6) AS type,
         centre.description,
         centre.active_flag,
         1 AS sort
    FROM centre LEFT OUTER JOIN client_po 
					 ON client_po.job = centre.job
                AND client_po.client_po = centre.client_po,
         job,
         area
   WHERE centre.book = job.book AND
         centre.job = job.job AND
         centre.book = area.book AND
         centre.job = area.job AND
         centre.area = area.area AND
         centre.book = :as_book AND
        ((:as_access_restricted_data = 'N' AND centre.restrict_flag = 'N') OR :as_access_restricted_data = 'Y') AND
         centre.file_type in ( :as_file_type1, :as_file_type2, :as_file_type3) AND  
         centre.job BETWEEN :as_from_job AND :as_to_job AND
         centre.area BETWEEN :as_from_area AND :as_to_area AND
			Replace(Replace(centre.cost_type, 'R', ''), 'G', '') <> '' AND 
			((:as_file_type1 = 'Y' AND centre.active_flag = 'Y') OR :as_file_type1 <> 'Y')
" arguments=(("as_book", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string),("as_from_area", string),("as_to_area", string),("as_access_restricted_data", string))  sort="job A job_sort A area A area_sort A centre A centre_sort A client_po A sort A po_item A " )
