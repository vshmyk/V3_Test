table(column=(type=char(20) updatewhereclause=yes name=client_po dbname="centre.client_po" dbalias=".client_po" )
 column=(type=char(6) updatewhereclause=yes name=job dbname="centre.job" dbalias=".job" )
 column=(type=char(5) updatewhereclause=yes name=area dbname="centre.area" dbalias=".area" )
