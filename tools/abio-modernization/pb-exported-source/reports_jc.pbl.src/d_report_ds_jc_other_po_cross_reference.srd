 column=(type=char(6) updatewhereclause=yes name=sub_po_item dbname="centre.sub_po_item" dbalias=".sub_po_item" )
 column=(type=decimal(2) updatewhereclause=yes name=lab_to_date_cost dbname="centre.lab_to_date_cost" dbalias=".lab_to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=adm_to_date_cost dbname="centre.adm_to_date_cost" dbalias=".adm_to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=mtl_to_date_cost dbname="centre.mtl_to_date_cost" dbalias=".mtl_to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=equ_to_date_cost dbname="centre.equ_to_date_cost" dbalias=".equ_to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=own_to_date_cost dbname="centre.own_to_date_cost" dbalias=".own_to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=sub_to_date_cost dbname="centre.sub_to_date_cost" dbalias=".sub_to_date_cost" )
 column=(type=decimal(4) updatewhereclause=yes name=lab_commit_cost dbname="centre.lab_commit_cost" dbalias=".lab_commit_cost" )
 column=(type=decimal(4) updatewhereclause=yes name=adm_commit_cost dbname="centre.adm_commit_cost" dbalias=".adm_commit_cost" )
 column=(type=decimal(4) updatewhereclause=yes name=mtl_commit_cost dbname="centre.mtl_commit_cost" dbalias=".mtl_commit_cost" )
 column=(type=decimal(4) updatewhereclause=yes name=equ_commit_cost dbname="centre.equ_commit_cost" dbalias=".equ_commit_cost" )
 column=(type=decimal(4) updatewhereclause=yes name=own_commit_cost dbname="centre.own_commit_cost" dbalias=".own_commit_cost" )
 column=(type=decimal(4) updatewhereclause=yes name=sub_commit_cost dbname="centre.sub_commit_cost" dbalias=".sub_commit_cost" )
 column=(type=char(35) updatewhereclause=yes name=job_description dbname="job.description" dbalias=".description" )
 column=(type=char(40) updatewhereclause=yes name=po_description dbname="po_description" )
 retrieve="  SELECT centre.client_po,
         centre.job,   
         centre.area,   
         centre.centre,   
         centre.description,   
         centre.cost_type,   

         centre.lab_po_item,
         centre.adm_po_item,
         centre.mtl_po_item,
         centre.equ_po_item,
         centre.own_po_item,
         centre.sub_po_item,

         centre.lab_to_date_cost,
         centre.adm_to_date_cost,
         centre.mtl_to_date_cost,
         centre.equ_to_date_cost,
         centre.own_to_date_cost,
         centre.sub_to_date_cost,

         centre.lab_commit_cost,
         centre.adm_commit_cost,
         centre.mtl_commit_cost,
         centre.equ_commit_cost,
         centre.own_commit_cost,
         centre.sub_commit_cost,

         job.description,  
         (SELECT client_po.description 
            FROM client_po 
           WHERE client_po.job = centre.job
             AND client_po.client_po = centre.client_po) AS po_description
    FROM centre,   
         job
   WHERE centre.job = job.job AND
         centre.book = :as_book AND
         job.book = :as_book AND
         (centre.file_type = :as_file_type1 OR  
         centre.file_type = :as_file_type2 OR  
         centre.file_type = :as_file_type3) AND  
         centre.job BETWEEN :as_from_job AND :as_to_job AND
         centre.area BETWEEN :as_from_area AND :as_to_area AND
         centre.centre BETWEEN :as_from_centre AND :as_to_centre AND
         ((:as_access_restricted_data = 'N' AND centre.restrict_flag = 'N') OR :as_access_restricted_data = 'Y') 
ORDER BY centre.client_po ASC,
         centre.job ASC,   
         centre.area ASC,   
         centre.centre ASC   
" arguments=(("as_book", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string),("as_from_area", string),("as_to_area", string),("as_from_centre", string),("as_to_centre", string),("as_access_restricted_data", string)) )
