table(column=(type=char(6) updatewhereclause=yes name=job dbname="centre.job" )
 column=(type=char(5) updatewhereclause=yes name=area dbname="centre.area" )
 column=(type=char(6) updatewhereclause=yes name=centre dbname="centre.centre" )
 column=(type=char(50) updatewhereclause=yes name=description dbname="centre.description" )
 column=(type=char(1) updatewhereclause=yes name=cost_type dbname="cost_type" )
 column=(type=char(20) updatewhereclause=yes name=client_po dbname="centre.client_po" )
 column=(type=char(6) updatewhereclause=yes name=lab_po_item dbname="centre.lab_po_item" )
 column=(type=decimal(2) updatewhereclause=yes name=lab_to_date_qnt dbname="lab_to_date_qnt" )
 column=(type=decimal(2) updatewhereclause=yes name=lab_cur_budget_qnt dbname="centre.lab_cur_budget_qnt" )
 column=(type=decimal(2) updatewhereclause=yes name=hr_cur_budget_amt dbname="centre.hr_cur_budget_amt" )
 column=(type=decimal(2) updatewhereclause=yes name=hr_to_date_cost dbname="hr_to_date_cost" )
 column=(type=decimal(15) updatewhereclause=yes name=earned dbname="earned" )
 column=(type=char(1) updatewhereclause=yes name=summary_filter dbname="summary_filter" )
 column=(type=char(1) updatewhereclause=yes name=group_total dbname="group_total" )
 column=(type=char(10) updatewhereclause=yes name=construction_work_package dbname="centre.construction_work_package" )
 retrieve="SELECT centre.job, 
       centre.area, 
       centre.centre, 
       centre.description, 
       'L' as cost_type, 
       centre.client_po, 
       centre.lab_po_item, 
       ( CASE WHEN :as_snapshot = 'L' 
              THEN centre.lab_to_date_qnt 
              ELSE centre.lab_snapshot_qnt 
              END ) AS lab_to_date_qnt, 
       centre.lab_cur_budget_qnt, 
       centre.hr_cur_budget_amt, 
       ( CASE WHEN :as_snapshot = 'L' 
              THEN centre.hr_to_date_cost 
              ELSE centre.hr_snapshot_cost 
              END ) AS hr_to_date_cost, 
       ( CASE WHEN centre.lab_cur_budget_qnt != 0 
              THEN Round(( CASE WHEN :as_snapshot = 'L' 
                                THEN centre.lab_to_date_qnt 
                                ELSE centre.lab_snapshot_qnt 
                                END ) 
                         / centre.lab_cur_budget_qnt * centre.hr_cur_budget_amt, 2) 
              ELSE 0 
              END ) AS earned, 
       'N'    AS summary_filter, 
       '1'    AS group_total, 
       centre.construction_work_package 
FROM   centre 
WHERE  centre.book = :as_book 
       AND ( centre.file_type = :as_file_type1 
              OR centre.file_type = :as_file_type2 
              OR centre.file_type = :as_file_type3 ) 
       AND centre.job BETWEEN :as_from_job AND :as_to_job 
       AND centre.area BETWEEN :as_from_area AND :as_to_area 
       AND centre.centre BETWEEN :as_from_centre AND :as_to_centre 
       AND (( ( :as_active_centres_only = 'Y' 
                AND centre.active_flag = 'Y' ) 
               OR :as_active_centres_only = 'N' )) 
       AND (( :as_access_restricted_data = 'N' 
               AND centre.restrict_flag = 'N' ) 
              OR :as_access_restricted_data = 'Y' ) 
       AND (( Ltrim(Rtrim(Substring(centre.client_po, 6, 4))) >= :as_from_disc 
                OR ( :as_from_disc = '0' 
                     AND Ltrim(Rtrim(Substring(centre.client_po, 6, 4))) <> '' ) 
             ) 
             AND Ltrim(Rtrim(Substring(centre.client_po, 6, 4))) <= :as_to_disc 
           )  
       AND (   (CharIndex('L',centre.cost_type) > 0 AND
             (:as_zero_activity = 'Y' OR (:as_zero_activity = 'N' AND (CASE WHEN :as_snapshot = 'L' THEN centre.hr_to_date_cost ELSE centre.hr_snapshot_cost END) != 0) AND centre.hr_cur_budget_amt != 0) OR ((:as_zero_activity  = 'N') AND ((CASE WHEN :as_snapshot = 'L' THEN centre.hr_to_date_cost ELSE centre.hr_snapshot_cost END) != 0))
         )) AND Len(centre.client_po) > 0 
UNION
SELECT centre.job, 
       centre.area, 
       centre.centre, 
       centre.description, 
       'A' as cost_type, 
       centre.client_po, 
       centre.adm_po_item, 
       ( CASE WHEN :as_snapshot = 'L' 
              THEN centre.adm_to_date_qnt 
              ELSE centre.adm_snapshot_qnt 
              END ) AS adm_to_date_qnt, 
       centre.adm_cur_budget_qnt, 
       centre.adm_hr_cur_budget_amt, 
       ( CASE WHEN :as_snapshot = 'L' 
              THEN centre.adm_hr_to_date_cost 
              ELSE centre.adm_hr_snapshot_cost 
              END ) AS adm_hr_to_date_cost, 
       ( CASE WHEN centre.adm_cur_budget_qnt != 0 
              THEN Round(( CASE WHEN :as_snapshot = 'L' 
                                THEN centre.adm_to_date_qnt 
                                ELSE centre.adm_snapshot_qnt 
                                END ) 
                         / centre.adm_cur_budget_qnt * centre.adm_hr_cur_budget_amt, 2) 
              ELSE 0 
              END ) AS earned, 
       'N'    AS summary_filter, 
       '1'    AS group_total, 
       centre.construction_work_package 
FROM   centre 
WHERE  centre.book = :as_book 
       AND ( centre.file_type = :as_file_type1 
              OR centre.file_type = :as_file_type2 
              OR centre.file_type = :as_file_type3 ) 
       AND centre.job BETWEEN :as_from_job AND :as_to_job 
       AND centre.area BETWEEN :as_from_area AND :as_to_area 
       AND centre.centre BETWEEN :as_from_centre AND :as_to_centre 
       AND (( ( :as_active_centres_only = 'Y' 
                AND centre.active_flag = 'Y' ) 
               OR :as_active_centres_only = 'N' )) 
       AND (( :as_access_restricted_data = 'N' 
               AND centre.restrict_flag = 'N' ) 
              OR :as_access_restricted_data = 'Y' ) 
       AND (( Ltrim(Rtrim(Substring(centre.client_po, 6, 4))) >= :as_from_disc 
                OR ( :as_from_disc = '0' 
                     AND Ltrim(Rtrim(Substring(centre.client_po, 6, 4))) <> '' ) 
             ) 
             AND Ltrim(Rtrim(Substring(centre.client_po, 6, 4))) <= :as_to_disc 
           )  
       AND ((  CharIndex('A',centre.cost_type) > 0 AND
             (:as_zero_activity = 'Y' OR 
                (:as_zero_activity = 'N' AND (CASE WHEN :as_snapshot = 'L' 
														   THEN centre.adm_hr_to_date_cost 
														   ELSE centre.adm_hr_snapshot_cost 
													 END) != 0) 
			                          AND centre.adm_hr_cur_budget_amt != 0
                 ) 
              OR (:as_zero_activity  = 'N' 
			           AND ((CASE WHEN :as_snapshot = 'L' 
                               THEN centre.adm_hr_to_date_cost 
                               ELSE centre.adm_hr_snapshot_cost END) != 0)
                  )
         )) AND Len(centre.client_po) > 0 
" arguments=(("as_book", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string),("as_from_area", string),("as_to_area", string),("as_from_centre", string),("as_to_centre", string),("as_from_disc", string),("as_to_disc", string),("as_active_centres_only", string),("as_snapshot", string),("as_access_restricted_data", string),("as_zero_activity", string))  sort="client_po A lab_po_item A job_sort A area_sort A centre_sort A " )
