table(column=(type=char(8) updatewhereclause=yes name=book dbname="book" )
 column=(type=char(6) update=yes updatewhereclause=yes name=job dbname="job" )
 column=(type=char(1) updatewhereclause=yes name=fixed_price_flag dbname="fixed_price_flag" values="Y	Y/	N/" )
 column=(type=decimal(2) updatewhereclause=yes name=admin_fee_percent dbname="admin_fee_percent" values="Y	1.00/	0/" )
 column=(type=char(35) update=yes updatewhereclause=yes name=description dbname="description" )
 column=(type=char(25) update=yes updatewhereclause=yes name=superintendent dbname="superintendent" )
 column=(type=char(35) update=yes updatewhereclause=yes name=address_1 dbname="address_1" )
 column=(type=char(35) update=yes updatewhereclause=yes name=address_2 dbname="address_2" )
 column=(type=char(20) update=yes updatewhereclause=yes name=city dbname="city" )
 column=(type=char(2) update=yes updatewhereclause=yes name=province dbname="province" )
 column=(type=char(3) update=yes updatewhereclause=yes name=country dbname="country" )
 column=(type=char(10) update=yes updatewhereclause=yes name=postal dbname="postal" )
 column=(type=char(10) update=yes updatewhereclause=yes name=phone dbname="phone" )
 column=(type=char(10) update=yes updatewhereclause=yes name=fax dbname="fax" )
 column=(type=datetime update=yes updatewhereclause=yes name=start_date dbname="start_date" )
 column=(type=datetime updatewhereclause=yes name=complete_date dbname="complete_date" )
 column=(type=datetime update=yes updatewhereclause=yes name=last_update dbname="last_update" )
 column=(type=char(20) updatewhereclause=yes name=client_po dbname="client_po" )
 column=(type=char(6) updatewhereclause=yes name=client dbname="client" )
 column=(type=char(6) updatewhereclause=yes name=region dbname="region" )
 retrieve="SELECT job.book, 
       job.job, 
       job.fixed_price_flag, 
       job.admin_fee_percent, 
       job.description, 
       job.superintendent, 
       job.address_1, 
       job.address_2, 
       job.city, 
       job.province, 
       job.country, 
       job.postal, 
       job.phone, 
       job.fax, 
       job.start_date, 
       job.complete_date, 
       job.last_update, 
       job.client_po , 
       job.client , 
       job.region 
FROM   job 
WHERE  job.book = :as_book 
       AND ( ( :as_active_flag = 'Y' 
               AND active_flag = 'Y' ) 
              OR ( :as_active_flag = 'N' 
                   AND active_flag = 'N' ) 
              OR :as_active_flag = 'A' ) 
       AND ( ( :as_fixed_price_flag = 'Y' 
               AND fixed_price_flag = 'Y' ) 
              OR ( :as_fixed_price_flag = 'N' 
                   AND fixed_price_flag = 'N' ) 
              OR :as_fixed_price_flag = 'A' ) 
       AND ( ( :as_admin_flag = 'Y' 
               AND admin_fee_percent > 0 ) 
              OR ( :as_admin_flag = 'N' 
                   AND admin_fee_percent = 0 ) 
              OR :as_admin_flag = 'A' ) 
       AND ( job.file_type = :as_file_type1 
              OR job.file_type = :as_file_type2 
              OR job.file_type = :as_file_type3 ) 
       AND job.job BETWEEN :as_from_job AND :as_to_job " arguments=(("as_book", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string),("as_active_flag", string),("as_fixed_price_flag", string),("as_admin_flag", string))  sort="job_sort A " )
text(band=header alignment="2" text="Job List" border="0" color="33554432" x="14" y="8" height="72" width="4594" html.valueishtml="0"  name=t_1 visible="1"  font.face="Arial" font.height="-12" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
compute(band=header alignment="2" expression=" f_mixed_case(IF(as_from_job = '0' AND as_to_job = 'ZZZZZZ', ~"All jobs~", 
f_job( as_from_job, as_to_job ))
+ ', ' + f_active_flag(as_active_flag)
+ ', ' + f_fixed_price_flag (  as_fixed_price_flag  )
+ ', ' + f_admin_flag ( as_admin_flag  )
+ ', ' + f_files(as_file_type1, as_file_type2, as_file_type3), ~"C~") 
