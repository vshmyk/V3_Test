table(column=(type=char(8) updatewhereclause=yes name=centre_book dbname="centre.book" )
 column=(type=char(6) updatewhereclause=yes name=job dbname="centre.job" )
 column=(type=char(5) updatewhereclause=yes name=area dbname="centre.area" )
 column=(type=char(6) updatewhereclause=yes name=centre dbname="centre.centre" )
 column=(type=char(50) updatewhereclause=yes name=description dbname="centre.description" )
 column=(type=char(5) updatewhereclause=yes name=cost_type dbname="centre.cost_type" )
 column=(type=char(35) updatewhereclause=yes name=job_description dbname="job.description" )
 column=(type=char(35) updatewhereclause=yes name=area_description dbname="area.description" )
 column=(type=char(5) updatewhereclause=yes name=dispersion_type dbname="area.dispersion_type" )
 column=(type=char(4) updatewhereclause=yes name=centre_lab_unit dbname="centre.lab_unit" )
 column=(type=char(4) updatewhereclause=yes name=centre_mtl_unit dbname="centre.mtl_unit" )
 column=(type=char(4) updatewhereclause=yes name=centre_equ_unit dbname="centre.equ_unit" )
 column=(type=char(4) updatewhereclause=yes name=centre_sub_unit dbname="centre.sub_unit" )
 column=(type=char(1) updatewhereclause=yes name=centre_active_flag dbname="centre.active_flag" )
 retrieve="  SELECT centre.book,   
         centre.job,   
         centre.area,   
         centre.centre,   
         centre.description,   
         centre.cost_type,   
			job.description,
         area.description,
         area.dispersion_type,
         centre.lab_unit,
         centre.mtl_unit,
         centre.equ_unit,
         centre.sub_unit,
         centre.active_flag
    FROM centre,
         job,
         area
   WHERE centre.job = job.job AND 
         centre.job = area.job AND
         centre.area = area.area AND
         centre.book = :as_book AND
         job.book = :as_book AND
         area.book = :as_book AND
 			(lab_unit = :as_unit OR mtl_unit = :as_unit OR equ_unit = :as_unit OR sub_unit = :as_unit)
ORDER BY centre.job,   
         centre.area,   
         centre.centre
" arguments=(("as_book", string),("as_unit", string))  sort="job A area A If( IsNumber( centre ), 1, 2 ) A If( IsNumber( centre ), Long( centre ), 0 ) A centre A " )
