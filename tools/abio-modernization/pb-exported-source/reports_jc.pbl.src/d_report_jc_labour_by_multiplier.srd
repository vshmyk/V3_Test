table(column=(type=char(6) updatewhereclause=yes name=labour_dispersion_job dbname="labour_dispersion.job" )
 column=(type=char(5) updatewhereclause=yes name=labour_dispersion_area dbname="labour_dispersion.area" )
 column=(type=char(6) updatewhereclause=yes name=labour_dispersion_centre dbname="labour_dispersion.centre" )
 column=(type=long updatewhereclause=yes name=labour_dispersion_employee dbname="labour_dispersion.employee" )
 column=(type=datetime updatewhereclause=yes name=labour_dispersion_work_date dbname="labour_dispersion.work_date" )
 column=(type=long updatewhereclause=yes name=labour_dispersion_dispersion_item dbname="labour_dispersion.dispersion_item" )
 column=(type=char(1) updatewhereclause=yes name=labour_dispersion_shift dbname="labour_dispersion.shift" )
 column=(type=decimal(2) updatewhereclause=yes name=labour_dispersion_reg_hour dbname="labour_dispersion.reg_hour" )
 column=(type=decimal(2) updatewhereclause=yes name=labour_dispersion_tah_hour dbname="labour_dispersion.tah_hour" )
 column=(type=decimal(2) updatewhereclause=yes name=labour_dispersion_ovr_hour dbname="labour_dispersion.ovr_hour" )
 column=(type=decimal(2) updatewhereclause=yes name=labour_dispersion_reg_rate dbname="labour_dispersion.reg_rate" )
 column=(type=decimal(2) updatewhereclause=yes name=labour_dispersion_tah_rate dbname="labour_dispersion.tah_rate" )
 column=(type=decimal(2) updatewhereclause=yes name=labour_dispersion_ovr_rate dbname="labour_dispersion.ovr_rate" )
 column=(type=datetime updatewhereclause=yes name=labour_dispersion_extract_date dbname="labour_dispersion.extract_date" )
 column=(type=char(16) updatewhereclause=yes name=labour_dispersion_extract_reference dbname="labour_dispersion.extract_reference" )
 column=(type=datetime updatewhereclause=yes name=labour_dispersion_snapshot_date dbname="labour_dispersion.snapshot_date" )
 column=(type=char(1) updatewhereclause=yes name=labour_dispersion_file_type dbname="labour_dispersion.file_type" )
 column=(type=decimal(2) updatewhereclause=yes name=labour_dispersion_cost dbname="labour_dispersion.cost" )
 column=(type=char(25) updatewhereclause=yes name=employee_employee_name dbname="employee.employee_name" )
 column=(type=char(5) updatewhereclause=yes name=labour_dispersion_trade_union dbname="labour_dispersion.trade_union" )
 column=(type=char(5) updatewhereclause=yes name=labour_dispersion_occupation dbname="labour_dispersion.occupation" )
 column=(type=char(50) updatewhereclause=yes name=description dbname="centre.description" )
 column=(type=decimal(1) updatewhereclause=yes name=multiplier dbname="multiplier" )
 retrieve="  SELECT labour_dispersion.job,   
         labour_dispersion.area,   
         labour_dispersion.centre,   
         labour_dispersion.employee,   
         labour_dispersion.work_date,   
         labour_dispersion.dispersion_item,   
         labour_dispersion.shift,   
         labour_dispersion.reg_hour,   
         labour_dispersion.tah_hour,   
         labour_dispersion.ovr_hour,   
         labour_dispersion.reg_rate,   
         labour_dispersion.tah_rate,   
         labour_dispersion.ovr_rate,   
         labour_dispersion.extract_date,   
         labour_dispersion.extract_reference,   
         labour_dispersion.snapshot_date,   
         labour_dispersion.file_type,
         labour_dispersion.cost,
			employee.name as employee_name,
			labour_dispersion.trade_union , 
			labour_dispersion.occupation, 
         centre.description, 
			:adc_multiplier*1.0 as multiplier
	FROM	labour_dispersion 
			INNER JOIN centre ON
								 centre.book = labour_dispersion.book
								and centre.job = labour_dispersion.job
								and centre.area = labour_dispersion.area
								and centre.centre = labour_dispersion.centre
								AND ( centre.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' ) 
			INNER JOIN employee ON
								 employee.book = labour_dispersion.book
								and employee.employee = labour_dispersion.employee
								AND ( employee.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' ) 
   WHERE	labour_dispersion.book = :as_company
			and labour_dispersion.file_type in ( :as_file_type1, :as_file_type2 )
			and labour_dispersion.job between :as_from_job and :as_to_job
			and labour_dispersion.area between :as_from_area and :as_to_area
			and labour_dispersion.centre between :as_from_centre and :as_to_centre
			and UPPER( labour_dispersion.extract_reference ) between :as_from_reference and :as_to_reference
			and labour_dispersion.trade_union between :as_from_trade_union and :as_to_trade_union
			and labour_dispersion.gl_yyyymm between :as_from_yyyymm and :as_to_yyyymm
         and (		( :as_date_type = 'A' AND labour_dispersion.work_date >= :adt_from_date  AND labour_dispersion.work_date < DATEADD( day, 1, :adt_to_date ))
					OR ( :as_date_type = 'S' AND labour_dispersion.snapshot_date >= :adt_from_date AND labour_dispersion.snapshot_date < DATEADD( day, 1, :adt_to_date ))
					OR ( :as_date_type = 'E' AND labour_dispersion.add_datetime >= :adt_from_date AND labour_dispersion.add_datetime < DATEADD( day, 1, :adt_to_date ))
					OR (	:as_date_type = 'X'
							AND labour_dispersion.extract_date >= :adt_from_date
							AND labour_dispersion.extract_date < DATEADD( day, 1, :adt_to_date ) )
					OR	(	:as_date_type = 'N'
							AND labour_dispersion.extract_date IS NULL
							and labour_dispersion.work_date between :adt_from_date and :adt_to_date ) )
			and ( :as_source = 'ALL' or labour_dispersion.source = REPLACE( :as_source, '/', '' ) )
" arguments=(("as_company", string),("as_file_type1", string),("as_file_type2", string),("as_from_job", string),("as_to_job", string),("as_from_area", string),("as_to_area", string),("as_from_centre", string),("as_to_centre", string),("as_from_reference", string),("as_to_reference", string),("as_from_trade_union", string),("as_to_trade_union", string),("as_from_yyyymm", string),("as_to_yyyymm", string),("adt_from_date", datetime),("adt_to_date", datetime),("as_date_type", string),("as_source", string),("adc_multiplier", decimal),("as_user_access_restricted", string))  sort="labour_dispersion_job A labour_dispersion_area A labour_dispersion_centre A labour_dispersion_work_date A labour_dispersion_employee A labour_dispersion_work_date A labour_dispersion_dispersion_item A " )
