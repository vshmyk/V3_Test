table(column=(type=char(6) updatewhereclause=yes name=job dbname="job" )
 column=(type=char(5) updatewhereclause=yes name=area dbname="area" )
 column=(type=char(6) updatewhereclause=yes name=centre dbname="centre" )
 column=(type=decimal(2) updatewhereclause=yes name=ld_hour dbname="ld_hour" )
 column=(type=decimal(2) updatewhereclause=yes name=ap_hr_amt dbname="ap_hr_amt" )
 column=(type=decimal(2) updatewhereclause=yes name=hr_to_date_cost dbname="hr_to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=ld_lab_cost dbname="ld_lab_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=ap_lab_amnt dbname="ap_lab_amnt" )
 column=(type=decimal(2) updatewhereclause=yes name=ap_mat_amnt dbname="ap_mat_amnt" )
 column=(type=decimal(2) updatewhereclause=yes name=ap_equ_amnt dbname="ap_equ_amnt" )
 column=(type=decimal(2) updatewhereclause=yes name=ap_sub_amnt dbname="ap_sub_amnt" )
 column=(type=decimal(2) updatewhereclause=yes name=lab_to_date_cost dbname="lab_to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=mtl_to_date_cost dbname="mtl_to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=equ_to_date_cost dbname="equ_to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=sub_to_date_cost dbname="sub_to_date_cost" )
 retrieve="SELECT
job, 
area, 
centre,
ld_hour, 
ap_hr_amt, 
hr_to_date_cost, 
ld_lab_cost,
ap_lab_amnt,
ap_mat_amnt,
ap_equ_amnt,
ap_sub_amnt, 
lab_to_date_cost,
mtl_to_date_cost,
equ_to_date_cost,
sub_to_date_cost
FROM 
(
	SELECT 
	centre.book, 
	centre.job, 
	centre.area, 
	centre.centre,
	IsNUll(ld_hour, 0) ld_hour, 
	IsNUll(ap_hr_amt, 0) ap_hr_amt, 
	IsNUll(hr_to_date_cost, 0) hr_to_date_cost, 
	IsNUll(ld_lab_cost, 0) ld_lab_cost,
	IsNUll(ap_lab_amnt, 0) ap_lab_amnt,
	IsNUll(ap_mat_amnt, 0) ap_mat_amnt,
	IsNUll(ap_equ_amnt, 0) ap_equ_amnt,
	IsNUll(ap_sub_amnt, 0) ap_sub_amnt,
	lab_to_date_cost,
 	mtl_to_date_cost,
	equ_to_date_cost,
	sub_to_date_cost
	FROM job, book, centre LEFT OUTER JOIN 
	(
	 SELECT book, job, area, centre, 
			IsNUll(SUM(reg_hour + tah_hour + ovr_hour), 0) as ld_hour,
			IsNUll(SUM(labour_dispersion.cost), 0) as ld_lab_cost
	 FROM labour_dispersion 
	 WHERE (job BETWEEN :as_from_job AND :as_to_job) AND 
			 (book = :as_book)
	 GROUP BY book, job, area, centre 
	) ld ON	
		  centre.book = ld.book AND
		  centre.job = ld.job AND
		  centre.area = ld.area AND
		  centre.centre = ld.centre
	LEFT OUTER JOIN
	(
		SELECT book, job, area, centre,
		SUM(CASE WHEN cost_type = 'L' AND unit = 'HOUR' THEN quantity ELSE 0 END) ap_hr_amt,
		SUM((CASE cost_type WHEN 'L' THEN (net_purchase + hbk_purchase - gst_amount - hst_amount)
									 ELSE 0 END)) ap_lab_amnt,
		SUM((CASE cost_type WHEN 'M' THEN (net_purchase + hbk_purchase - gst_amount - hst_amount)
									 ELSE 0 END)) ap_mat_amnt,
		SUM((CASE cost_type WHEN 'E' THEN (net_purchase + hbk_purchase - gst_amount - hst_amount)
									 ELSE 0 END)) ap_equ_amnt,
		SUM((CASE cost_type WHEN 'S' THEN (net_purchase + hbk_purchase - gst_amount - hst_amount)
									 ELSE 0 END)) ap_sub_amnt
		FROM ap_invoice
		WHERE (job BETWEEN :as_from_job AND :as_to_job) AND 
			 	(book = :as_book) AND
				(transact_flag = 'Y')
		GROUP BY book, job, area, centre
	) ap ON	
		  centre.book = ap.book AND
		  centre.job = ap.job AND
		  centre.area = ap.area AND
		  centre.centre = ap.centre
	WHERE (book.book = :as_book) AND 	
		   (job.book = book.book) AND
		   (job.book = centre.book) AND 
		   (job.job = centre.job) AND 
	   	(job.job BETWEEN :as_from_job AND :as_to_job) AND 
 	      (:as_job_active = 'N' OR job.active_flag = :as_job_active)  
) cost_data
WHERE (ld_hour + ap_hr_amt) <> hr_to_date_cost  OR
	   (ld_lab_cost + ap_lab_amnt + ap_mat_amnt + ap_equ_amnt + ap_sub_amnt) <> (lab_to_date_cost + mtl_to_date_cost + equ_to_date_cost + sub_to_date_cost)

" arguments=(("as_book", string),("as_from_job", string),("as_to_job", string),("as_job_active", string))  sort="job A area A centre A " )
