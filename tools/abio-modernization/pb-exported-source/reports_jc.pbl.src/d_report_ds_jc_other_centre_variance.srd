 column=(type=char(6) updatewhereclause=yes name=group_centre_ceiling dbname="centre.group_centre_ceiling" dbalias=".group_centre_ceiling" )
 column=(type=char(50) updatewhereclause=yes name=description dbname="centre.description" dbalias=".description" )
 column=(type=char(7) updatewhereclause=yes name=cost_type dbname="centre.cost_type" dbalias=".cost_type" )
 column=(type=decimal(2) updatewhereclause=yes name=lab_cur_month_amt dbname="lab_cur_month_amt" )
