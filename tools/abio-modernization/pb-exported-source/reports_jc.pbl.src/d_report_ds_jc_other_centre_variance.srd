 column=(type=decimal(2) updatewhereclause=yes name=equ_forecast_amt dbname="equ_forecast_amt" )
 column=(type=decimal(2) updatewhereclause=yes name=own_forecast_amt dbname="own_forecast_amt" )
 column=(type=decimal(2) updatewhereclause=yes name=sub_forecast_amt dbname="sub_forecast_amt" )
 column=(type=decimal(2) updatewhereclause=yes name=lab_cur_budget_amt dbname="lab_cur_budget_amt" )
 column=(type=decimal(2) updatewhereclause=yes name=adm_cur_budget_amt dbname="adm_cur_budget_amt" )
 column=(type=decimal(2) updatewhereclause=yes name=mtl_cur_budget_amt dbname="mtl_cur_budget_amt" )
 column=(type=decimal(2) updatewhereclause=yes name=equ_cur_budget_amt dbname="equ_cur_budget_amt" )
 column=(type=decimal(2) updatewhereclause=yes name=own_cur_budget_amt dbname="own_cur_budget_amt" )
 column=(type=decimal(2) updatewhereclause=yes name=sub_cur_budget_amt dbname="sub_cur_budget_amt" )
