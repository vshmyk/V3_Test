 column=(type=decimal(2) updatewhereclause=yes name=adm_variance_amt dbname="adm_variance_amt" )
 column=(type=decimal(2) updatewhereclause=yes name=mtl_variance_amt dbname="mtl_variance_amt" )
 column=(type=decimal(2) updatewhereclause=yes name=equ_variance_amt dbname="equ_variance_amt" )
 column=(type=decimal(2) updatewhereclause=yes name=own_variance_amt dbname="own_variance_amt" )
 column=(type=decimal(2) updatewhereclause=yes name=sub_variance_amt dbname="sub_variance_amt" )
 column=(type=char(35) updatewhereclause=yes name=job_description dbname="job.description" dbalias=".description" )
 column=(type=char(35) updatewhereclause=yes name=area_description dbname="centre.area_description" dbalias=".area_description" )
 retrieve="  SELECT group_data.job,   
         group_data.area,   
         group_data.centre,   
         group_data.group_centre_ceiling,   
         group_data.description,   
         group_data.cost_type,   

         Sum(centre.lab_cur_month_amt) AS lab_cur_month_amt,
         Sum(centre.adm_cur_month_amt) AS adm_cur_month_amt,
         Sum(centre.mtl_cur_month_amt) AS mtl_cur_month_amt,
         Sum(centre.equ_cur_month_amt) AS equ_cur_month_amt,
         Sum(centre.own_cur_month_amt) AS own_cur_month_amt,
         Sum(centre.sub_cur_month_amt) AS sub_cur_month_amt,

         Sum(centre.lab_to_date_cost) AS lab_to_date_cost,
         Sum(centre.adm_to_date_cost) AS adm_to_date_cost,
         Sum(centre.mtl_to_date_cost) AS mtl_to_date_cost,
         Sum(centre.equ_to_date_cost) AS equ_to_date_cost,
         Sum(centre.own_to_date_cost) AS own_to_date_cost,
         Sum(centre.sub_to_date_cost) AS sub_to_date_cost,

         Sum(centre.lab_commit_cost) AS lab_commit_cost,
         Sum(centre.adm_commit_cost) AS adm_commit_cost,
         Sum(centre.mtl_commit_cost) AS mtl_commit_cost,
         Sum(centre.equ_commit_cost) AS equ_commit_cost,
         Sum(centre.own_commit_cost) AS own_commit_cost,
         Sum(centre.sub_commit_cost) AS sub_commit_cost,

         Sum(centre.lab_month_end_commit) AS lab_month_end_commit,
         Sum(centre.adm_month_end_commit) AS adm_month_end_commit,
         Sum(centre.mtl_month_end_commit) AS mtl_month_end_commit,
         Sum(centre.equ_month_end_commit) AS equ_month_end_commit,
         Sum(centre.own_month_end_commit) AS own_month_end_commit,
         Sum(centre.sub_month_end_commit) AS sub_month_end_commit,

         Sum(centre.lab_forecast_amt) AS lab_forecast_amt,
         Sum(centre.adm_forecast_amt) AS adm_forecast_amt,
         Sum(centre.mtl_forecast_amt) AS mtl_forecast_amt,
         Sum(centre.equ_forecast_amt) AS equ_forecast_amt,
         Sum(centre.own_forecast_amt) AS own_forecast_amt,
         Sum(centre.sub_forecast_amt) AS sub_forecast_amt,

         Sum(centre.lab_cur_budget_amt) AS lab_cur_budget_amt,
         Sum(centre.adm_cur_budget_amt) AS adm_cur_budget_amt,
         Sum(centre.mtl_cur_budget_amt) AS mtl_cur_budget_amt,
         Sum(centre.equ_cur_budget_amt) AS equ_cur_budget_amt,
         Sum(centre.own_cur_budget_amt) AS own_cur_budget_amt,
         Sum(centre.sub_cur_budget_amt) AS sub_cur_budget_amt,

         Sum(centre.lab_variance_amt) AS lab_variance_amt,
         Sum(centre.adm_variance_amt) AS adm_variance_amt,
         Sum(centre.mtl_variance_amt) AS mtl_variance_amt,
         Sum(centre.equ_variance_amt) AS equ_variance_amt,
         Sum(centre.own_variance_amt) AS own_variance_amt,
         Sum(centre.sub_variance_amt) AS sub_variance_amt,

         job.description,
         group_data.area_description  
    FROM (  SELECT centre.job,   
                   centre.area,   
                   centre.group_area_ceiling,   
                   centre.centre,   
                   centre.group_centre_ceiling,
                   centre.description,
                   centre.cost_type, 
                   (SELECT area.description 
                      FROM area 
                     WHERE area.book = :as_book AND 
                           area.job = centre.job AND
                           area.area = centre.area) AS area_description
              FROM centre
             WHERE centre.book = :as_book AND
                   (centre.file_type = :as_file_type1 OR  
                   centre.file_type = :as_file_type2 OR  
                   centre.file_type = :as_file_type3) AND  
                   centre.job BETWEEN :as_from_job AND :as_to_job AND
                   centre.area BETWEEN :as_from_area AND :as_to_area AND
                   centre.centre BETWEEN :as_from_centre AND :as_to_centre AND
                   centre.cost_type = 'G' AND
                   ((:as_access_restricted_data = 'N' AND centre.restrict_flag = 'N') OR :as_access_restricted_data = 'Y')) AS group_data,
         centre,
         job
   WHERE group_data.job = centre.job AND
         centre.job = job.job AND
         centre.book = :as_book AND
         job.book = :as_book AND
         Right('     ' + centre.area,5) BETWEEN Right('     ' + group_data.area,5) AND Right('     ' + LTrim(group_data.group_area_ceiling),5) AND
         Right('     ' + centre.centre,6) BETWEEN Right('     ' + group_data.centre,6) AND Right('     ' + LTrim(group_data.group_centre_ceiling),6)
GROUP BY group_data.job,   
         group_data.area,   
         group_data.centre,   
         group_data.group_centre_ceiling,   
         group_data.description,   
         group_data.cost_type,
         job.description,
         group_data.area_description
UNION 
  SELECT centre.job,   
         centre.area,   
         centre.centre,   
         centre.group_centre_ceiling,   
         centre.description,   
         centre.cost_type,   

         centre.lab_cur_month_amt,
         centre.adm_cur_month_amt,
         centre.mtl_cur_month_amt,
         centre.equ_cur_month_amt,
         centre.own_cur_month_amt,
         centre.sub_cur_month_amt,

         centre.lab_to_date_cost,
         centre.adm_to_date_cost,
         centre.mtl_to_date_cost,
         centre.equ_to_date_cost,
         centre.own_to_date_cost,
         centre.sub_to_date_cost,

         centre.lab_commit_cost,
         centre.adm_commit_cost,
         centre.mtl_commit_cost,
         centre.equ_commit_cost,
         centre.own_commit_cost,
         centre.sub_commit_cost,

         centre.lab_month_end_commit,
         centre.adm_month_end_commit,
         centre.mtl_month_end_commit,
         centre.equ_month_end_commit,
         centre.own_month_end_commit,
         centre.sub_month_end_commit,

         centre.lab_forecast_amt,
         centre.adm_forecast_amt,
         centre.mtl_forecast_amt,
         centre.equ_forecast_amt,
         centre.own_forecast_amt,
         centre.sub_forecast_amt,

         centre.lab_cur_budget_amt,
         centre.adm_cur_budget_amt,
         centre.mtl_cur_budget_amt,
         centre.equ_cur_budget_amt,
         centre.own_cur_budget_amt,
         centre.sub_cur_budget_amt,

         centre.lab_variance_amt,
         centre.adm_variance_amt,
         centre.mtl_variance_amt,
         centre.equ_variance_amt,
         centre.own_variance_amt,
         centre.sub_variance_amt,

         job.description,  
         (SELECT area.description 
            FROM area 
           WHERE area.book = :as_book AND 
                 area.job = centre.job AND
                 area.area = centre.area) AS area_description
    FROM centre,   
         job
   WHERE centre.job = job.job AND
         centre.book = :as_book AND
         job.book = :as_book AND
         (centre.file_type = :as_file_type1 OR  
         centre.file_type = :as_file_type2 OR  
         centre.file_type = :as_file_type3) AND  
         centre.job BETWEEN :as_from_job AND :as_to_job AND
         centre.area BETWEEN :as_from_area AND :as_to_area AND
         centre.centre BETWEEN :as_from_centre AND :as_to_centre AND
         centre.cost_type != 'G' AND
         ((:as_access_restricted_data = 'N' AND centre.restrict_flag = 'N') OR :as_access_restricted_data = 'Y')
ORDER BY group_data.job ASC,   
         group_data.area ASC,   
         group_data.centre ASC   
" arguments=(("as_book", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string),("as_from_area", string),("as_to_area", string),("as_from_centre", string),("as_to_centre", string),("as_access_restricted_data", string),("as_job_cost_month_variance_flag", string))  sort="job A area A centre A " )
