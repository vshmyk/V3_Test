 column=(type=char(35) updatewhereclause=yes name=job_description dbname="job.description" dbalias=".description" )
 retrieve="  SELECT centre.job,   
         centre.area,   
         centre.group_area_ceiling,   
         centre.centre,   
         centre.group_centre_ceiling,   
         centre.description,   
         centre.cost_type,   

         centre.sched_premium_hour,
         centre.shut_premium_hour,
         centre.spot_premium_hour,

         centre.sched_premium_hour,
         centre.shut_premium_hour,
         centre.spot_premium_hour,

         centre.override_forecast_flag,

         centre.lab_complete_flag,
         centre.adm_complete_flag,
         centre.mtl_complete_flag,
         centre.equ_complete_flag,
         centre.own_complete_flag,
         centre.sub_complete_flag,

         centre.lab_unit,
         centre.adm_unit,
         centre.mtl_unit,
         centre.equ_unit,
         centre.own_unit,
         centre.sub_unit,

         (CASE :as_budget WHEN 'C' THEN centre.lab_cur_budget_qnt ELSE centre.lab_orig_budget_qnt END) AS lab_cur_budget_qnt,
         (CASE :as_budget WHEN 'C' THEN centre.adm_cur_budget_qnt ELSE centre.adm_orig_budget_qnt END) AS adm_cur_budget_qnt,
         (CASE :as_budget WHEN 'C' THEN centre.mtl_cur_budget_qnt ELSE centre.mtl_orig_budget_qnt END) AS mtl_cur_budget_qnt,
         (CASE :as_budget WHEN 'C' THEN centre.equ_cur_budget_qnt ELSE centre.equ_orig_budget_qnt END) AS equ_cur_budget_qnt,
         (CASE :as_budget WHEN 'C' THEN centre.own_cur_budget_qnt ELSE centre.own_orig_budget_qnt END) AS own_cur_budget_qnt,
         (CASE :as_budget WHEN 'C' THEN centre.sub_cur_budget_qnt ELSE centre.sub_orig_budget_qnt END) AS sub_cur_budget_qnt,

         centre.lab_forecast_qnt,
         centre.adm_forecast_qnt,
         centre.mtl_forecast_qnt,
         centre.equ_forecast_qnt,
         centre.own_forecast_qnt,
         centre.sub_forecast_qnt,

         (CASE :as_budget WHEN 'C' THEN centre.hr_cur_budget_amt ELSE centre.hr_orig_budget_amt END) AS hr_cur_budget_amt,
         (CASE :as_budget WHEN 'C' THEN centre.adm_hr_cur_budget_amt ELSE centre.adm_hr_orig_budget_amt END) AS adm_hr_cur_budget_amt,

         (CASE :as_budget WHEN 'C' THEN centre.lab_cur_budget_amt ELSE centre.lab_orig_budget_amt END) AS lab_cur_budget_amt,
         (CASE :as_budget WHEN 'C' THEN centre.adm_cur_budget_amt ELSE centre.adm_orig_budget_amt END) AS adm_cur_budget_amt,
         (CASE :as_budget WHEN 'C' THEN centre.mtl_cur_budget_amt ELSE centre.mtl_orig_budget_amt END) AS mtl_cur_budget_amt,
         (CASE :as_budget WHEN 'C' THEN centre.equ_cur_budget_amt ELSE centre.equ_orig_budget_amt END) AS equ_cur_budget_amt,
         (CASE :as_budget WHEN 'C' THEN centre.own_cur_budget_amt ELSE centre.own_orig_budget_amt END) AS own_cur_budget_amt,
         (CASE :as_budget WHEN 'C' THEN centre.sub_cur_budget_amt ELSE centre.sub_orig_budget_amt END) AS sub_cur_budget_amt,

         (CASE :as_snapshot WHEN 'L' THEN centre.lab_to_date_qnt ELSE centre.lab_snapshot_qnt END) AS lab_to_date_qnt,
         (CASE :as_snapshot WHEN 'L' THEN centre.adm_to_date_qnt ELSE centre.adm_snapshot_qnt END) AS adm_to_date_qnt,
         (CASE :as_snapshot WHEN 'L' THEN centre.mtl_to_date_qnt ELSE centre.mtl_snapshot_qnt END) AS mtl_to_date_qnt,
         (CASE :as_snapshot WHEN 'L' THEN centre.equ_to_date_qnt ELSE centre.equ_snapshot_qnt END) AS equ_to_date_qnt,
         (CASE :as_snapshot WHEN 'L' THEN centre.own_to_date_qnt ELSE centre.own_snapshot_qnt END) AS own_to_date_qnt,
         (CASE :as_snapshot WHEN 'L' THEN centre.sub_to_date_qnt ELSE centre.sub_snapshot_qnt END) AS sub_to_date_qnt,

         (CASE :as_snapshot WHEN 'L' THEN centre.hr_to_date_cost ELSE centre.hr_snapshot_cost END) AS hr_to_date_cost,
         (CASE :as_snapshot WHEN 'L' THEN centre.adm_hr_to_date_cost ELSE centre.adm_hr_snapshot_cost END) AS adm_hr_to_date_cost,

         (CASE :as_snapshot WHEN 'L' THEN centre.lab_to_date_cost ELSE centre.lab_snapshot_cost END) AS lab_to_date_cost,
         (CASE :as_snapshot WHEN 'L' THEN centre.adm_to_date_cost ELSE centre.adm_snapshot_cost END) AS adm_to_date_cost,
         (CASE :as_snapshot WHEN 'L' THEN centre.mtl_to_date_cost ELSE centre.mtl_snapshot_cost END) AS mtl_to_date_cost,
         (CASE :as_snapshot WHEN 'L' THEN centre.equ_to_date_cost ELSE centre.equ_snapshot_cost END) AS equ_to_date_cost,
         (CASE :as_snapshot WHEN 'L' THEN centre.own_to_date_cost ELSE centre.own_snapshot_cost END) AS own_to_date_cost,
         (CASE :as_snapshot WHEN 'L' THEN centre.sub_to_date_cost ELSE centre.sub_snapshot_cost END) AS sub_to_date_cost,

         (CASE :as_snapshot WHEN 'L' THEN centre.lab_commit_cost ELSE centre.lab_snapshot_commit END) AS lab_commit_cost,
         (CASE :as_snapshot WHEN 'L' THEN centre.adm_commit_cost ELSE centre.adm_snapshot_commit END) AS adm_commit_cost,
         (CASE :as_snapshot WHEN 'L' THEN centre.mtl_commit_cost ELSE centre.mtl_snapshot_commit END) AS mtl_commit_cost,
         (CASE :as_snapshot WHEN 'L' THEN centre.equ_commit_cost ELSE centre.equ_snapshot_commit END) AS equ_commit_cost,
         (CASE :as_snapshot WHEN 'L' THEN centre.own_commit_cost ELSE centre.own_snapshot_commit END) AS own_commit_cost,
         (CASE :as_snapshot WHEN 'L' THEN centre.sub_commit_cost ELSE centre.sub_snapshot_commit END) AS sub_commit_cost,

         (CASE :as_snapshot WHEN 'L' THEN centre.hr_forecast_amt ELSE centre.hr_snapshot_forecast END) AS hr_forecast_amt,
         (CASE :as_snapshot WHEN 'L' THEN centre.adm_hr_forecast_amt ELSE centre.adm_hr_snapshot_forecast END) AS adm_hr_forecast_amt,

         (CASE :as_snapshot WHEN 'L' THEN centre.lab_forecast_amt ELSE centre.lab_snapshot_forecast END) AS lab_forecast_amt,
         (CASE :as_snapshot WHEN 'L' THEN centre.adm_forecast_amt ELSE centre.adm_snapshot_forecast END) AS adm_forecast_amt,
         (CASE :as_snapshot WHEN 'L' THEN centre.mtl_forecast_amt ELSE centre.mtl_snapshot_forecast END) AS mtl_forecast_amt,
         (CASE :as_snapshot WHEN 'L' THEN centre.equ_forecast_amt ELSE centre.equ_snapshot_forecast END) AS equ_forecast_amt,
         (CASE :as_snapshot WHEN 'L' THEN centre.own_forecast_amt ELSE centre.own_snapshot_forecast END) AS own_forecast_amt,
         (CASE :as_snapshot WHEN 'L' THEN centre.sub_forecast_amt ELSE centre.sub_snapshot_forecast END) AS sub_forecast_amt,

         job.description  
    FROM centre,   
         job  
   WHERE centre.job = job.job AND
         centre.book = :as_book AND
         job.book = :as_book AND
         (centre.file_type = :as_file_type1 OR  
         centre.file_type = :as_file_type2 OR  
         centre.file_type = :as_file_type3) AND  
         centre.job BETWEEN :as_from_job AND :as_to_job AND
         centre.area BETWEEN :as_from_area AND :as_to_area AND
         centre.centre BETWEEN :as_from_centre AND :as_to_centre AND
         ((:as_access_restricted_data = 'N' AND centre.restrict_flag = 'N') OR :as_access_restricted_data = 'Y')
ORDER BY centre.job ASC,   
         centre.area ASC,   
         centre.centre ASC   
" arguments=(("as_book", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string),("as_from_area", string),("as_to_area", string),("as_from_centre", string),("as_to_centre", string),("as_budget", string),("as_snapshot", string),("as_access_restricted_data", string))  sort="job A area A centre A " )
