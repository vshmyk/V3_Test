compute(band=header alignment="2" expression="f_mixed_case(IF(as_from_job = '0' AND as_to_job  = 'ZZZZZZ', 'all jobs',  f_job( as_from_job, as_to_job )) + ', ' + 
f_area(as_from_area, as_to_area) + ', ' + 
f_client_po (as_from_client_po, as_to_client_po) + ', ' + 
if(   as_fixed_price_flag = 'Y', ' fixed price only, ', if(   as_fixed_price_flag = 'N', ' not fixed price, ', '')) +
If( an_days = 0, '', 'activity in the last ' + String(  an_days ) + ' days, ') +
If(  adec_percent = 0, '', 'less than ' + String(   adec_percent , '#0.00')  + '% remaining on P/O, ')+ 
f_files(as_file_type1, as_file_type2, as_file_type3), ~"C~")
