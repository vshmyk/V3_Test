table(column=(type=char(20) updatewhereclause=yes name=client_po dbname="client_po" )
 column=(type=char(2000) update=yes updatewhereclause=yes name=po_desc dbname="po_desc" )
 column=(type=char(5) updatewhereclause=yes name=area dbname="area" )
 column=(type=char(35) updatewhereclause=yes name=area_desc dbname="area_desc" )
 column=(type=char(6) updatewhereclause=yes name=job dbname="job" )
 column=(type=decimal(2) updatewhereclause=yes name=order_amount dbname="order_amount" )
 column=(type=decimal(2) updatewhereclause=yes name=invoice_amount dbname="invoice_amount" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=amount dbname="amount" )
 column=(type=datetime updatewhereclause=yes name=latest_work dbname="latest_work" )
 column=(type=datetime updatewhereclause=yes name=latest_invoice dbname="latest_invoice" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=outstanding_amount dbname="outstanding_amount" )
 column=(type=char(35) updatewhereclause=yes name=job_description dbname="description" )
 column=(type=char(1) updatewhereclause=yes name=fixed_price_flag dbname="fixed_price_flag" )
 column=(type=decimal(6) updatewhereclause=yes identity=yes name=percent_remaining dbname="percent_remaining" )
 retrieve="SELECT area_client_po.client_po, 
       client_po.description                            AS po_desc, 
       area.area, 
       area.description                                 AS area_desc, 
       area.job, 
       area_client_po.order_amount, 
       area_client_po.invoice_amount, 
       actual_invoices.amount, 
       actual_timesheets.latest_work, 
       actual_invoices.latest_invoice, 
       area_client_po.order_amount - actual_invoices.amount AS outstanding_amount,
       job.description, 
       job.fixed_price_flag, 
       CASE 
         WHEN area_client_po.order_amount > 0 THEN Round(( area_client_po.order_amount - actual_invoices.amount ) / area_client_po.order_amount * 100, 2)
         ELSE 0 
       END                                              AS percent_remaining
FROM   job, 
       area 
       LEFT OUTER JOIN area_client_po 
                    ON area.book = area_client_po.book 
                    	  AND area.job = area_client_po.job 
                       AND area.area = area_client_po.area 
       LEFT OUTER JOIN client_po 
                    ON area_client_po.job = client_po.job 
                       AND area_client_po.client_po = client_po.client_po 
       LEFT OUTER JOIN (SELECT book, 
                               job, 
                               area, 
                               client_po, 
                               Sum(lab_amount + mtl_amount + sub_amount + equ_amount) AS amount, 
                               Max(invoice_date) AS latest_invoice 
                        FROM   ar_invoice 
                        GROUP  BY book, 
                                  job, 
                                  area, 
                                  client_po) actual_invoices 
                    ON area_client_po.book = actual_invoices.book 
                       AND area_client_po.job = actual_invoices.job 
                       AND area_client_po.area = actual_invoices.area 
                       AND area_client_po.client_po = actual_invoices.client_po 
        LEFT OUTER JOIN (SELECT book, 
                               job, 
                               area, 
							   max(work_date) AS latest_work
                        FROM   timesheet 
                        GROUP  BY book, 
                                  job, 
                                  area) actual_timesheets 
                    ON area.book = actual_timesheets.book 
                       AND area.job = actual_timesheets.job 
                       AND area.area = actual_timesheets.area 
WHERE  area.book = :as_book 
       AND area.book = job.book 
       AND area.job = job.job 
       AND ( area.file_type = :as_file_type1 
              OR area.file_type = :as_file_type2 
              OR area.file_type = :as_file_type3 ) 
       AND area.job BETWEEN :as_from_job AND :as_to_job 
       AND area.area BETWEEN :as_from_area AND :as_to_area 
       AND area_client_po.client_po BETWEEN :as_from_client_po AND :as_to_client_po 
       AND ( :as_fixed_price_flag = 'A' 
              OR :as_fixed_price_flag = job.fixed_price_flag ) 
       AND ( :an_days = 0 
              OR Datediff(day, (CASE WHEN actual_timesheets.latest_work > actual_invoices.latest_invoice 
                                     THEN actual_timesheets.latest_work 
                                     ELSE actual_invoices.latest_invoice 
                                END ), Getdate()) <= :an_days )
		 AND ( :adec_percent = 0 OR area_client_po.order_amount  <> 0)
       AND ( :adec_percent = 0 
              OR ( CASE 
                     WHEN area_client_po.order_amount  = 0 THEN 0 
                     ELSE Round(( area_client_po.order_amount  - actual_invoices.amount ) / area_client_po.order_amount  * 100, 2)
                   END ) <= :adec_percent ) " arguments=(("as_book", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string),("as_from_area", string),("as_to_area", string),("as_from_client_po", string),("as_to_client_po", string),("as_fixed_price_flag", string),("an_days", number),("adec_percent", number))  sort="job_sort A area_sort A " )
