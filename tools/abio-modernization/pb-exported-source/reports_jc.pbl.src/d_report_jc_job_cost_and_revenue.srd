table(column=(type=char(8) updatewhereclause=yes name=book dbname="book" )
 column=(type=char(11) updatewhereclause=yes name=job dbname="job" )
 column=(type=char(35) updatewhereclause=yes name=description dbname="description" )
 column=(type=char(6) updatewhereclause=yes name=client dbname="client" )
 column=(type=char(35) updatewhereclause=yes name=client_name dbname="client_name" )
 column=(type=char(6) updatewhereclause=yes name=region dbname="region" )
 column=(type=char(25) updatewhereclause=yes name=region_description dbname="region_description" )
 column=(type=char(6) updatewhereclause=yes name=parent_region dbname="parent_region" )
 column=(type=char(25) updatewhereclause=yes name=parent_region_description dbname="parent_region_description" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=revenue dbname="revenue" )
 column=(type=decimal(2) updatewhereclause=yes name=revenue_hrs dbname="revenue_hrs" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=revenue_lab dbname="revenue_lab" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=revenue_mtl dbname="revenue_mtl" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=revenue_equ dbname="revenue_equ" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=revenue_sub dbname="revenue_sub" )
 column=(type=decimal(3) updatewhereclause=yes identity=yes name=revenue_je dbname="revenue_je" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=costs dbname="costs" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=costs_hrs dbname="costs_hrs" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=costs_lab dbname="costs_lab" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=costs_mtl dbname="costs_mtl" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=costs_equ dbname="costs_equ" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=costs_sub dbname="costs_sub" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=costs_je dbname="costs_je" )
 retrieve="SELECT book,
       job,
       description,
       client,
       client_name,
       region,
       region_description,
       parent_region,
       parent_region_description,
       Sum(revenue)     AS revenue,
       Sum(revenue_hrs) AS revenue_hrs,
       Sum(revenue_lab) AS revenue_lab,
       Sum(revenue_mtl) AS revenue_mtl,
       Sum(revenue_equ) AS revenue_equ,
       Sum(revenue_sub) AS revenue_sub,
       Sum(revenue_je)  AS revenue_je,
       Sum(costs)       AS costs,
       Sum(costs_hrs)   AS costs_hrs,
       Sum(costs_lab)   AS costs_lab,
       Sum(costs_mtl)   AS costs_mtl,
       Sum(costs_equ)   AS costs_equ,
       Sum(costs_sub)   AS costs_sub,
       Sum(costs_je)    AS costs_je
FROM   (
       /* A/R invoices are revenue */
       SELECT ar_invoice.book                                                                                        AS book,
              Isnull(ar_invoice.job, 'A/R w/o job')                                                                  AS job,
              Isnull(job.description, '')                                                                            AS description,
              Isnull(job.client, '')                                                                                 AS client,
              Isnull(client.NAME, '')                                                                                AS client_name,
              Isnull(region.region, '')                                                                              AS region,
              Isnull(region.description, '')                                                                         AS region_description,
              Isnull(parent_region.region, '')                                                                       AS parent_region,
              Isnull(parent_region.description, '')                                                                  AS parent_region_description,
              'AR'                                                                                                   AS source,
              Sum(ar_invoice.net_purchase
                  + ar_invoice.hbk_purchase - ar_invoice.gst_amount - ar_invoice.pst_amount - ar_invoice.hst_amount) AS revenue,
              Sum(ar_invoice.reg_hour + ar_invoice.tah_hour
                  + ar_invoice.ovr_hour)                                                                             AS revenue_hrs,
              Sum(ar_invoice.lab_amount)                                                                             AS revenue_lab,
              Sum(ar_invoice.mtl_amount)                                                                             AS revenue_mtl,
              Sum(ar_invoice.equ_amount)                                                                             AS revenue_equ,
              Sum(ar_invoice.sub_amount)                                                                             AS revenue_sub,
              0.00                                                                                                   AS revenue_je,
              0.00                                                                                                   AS costs,
              0.00                                                                                                   AS costs_hrs,
              0.00                                                                                                   AS costs_lab,
              0.00                                                                                                   AS costs_mtl,
              0.00                                                                                                   AS costs_equ,
              0.00                                                                                                   AS costs_sub,
              0.00                                                                                                   AS costs_je
       FROM   ar_invoice WITH (nolock)
              LEFT OUTER JOIN job
                           ON job.book = ar_invoice.book
                              AND job.job = ar_invoice.job
              LEFT OUTER JOIN client
                           ON job.book = client.book
                              AND job.client = client.client
              LEFT OUTER JOIN region
                           ON job.region = region.region
              LEFT OUTER JOIN region parent_region
                           ON region.parent_region = parent_region.region
       WHERE  ar_invoice.book = :as_company
              AND ( job.file_type = :as_file_type1
                     OR job.file_type = :as_file_type2
                     OR job.file_type = :as_file_type3 )
              AND Isnull(ar_invoice.job, NULL) BETWEEN :as_from_job AND :as_to_job /* NULL jobs would skew the report */
              AND ar_invoice.ar_yyyymm BETWEEN :as_from_YYYYMM AND :as_to_YYYYMM
              AND ( ( :as_region_type = 'A'
                      AND ( :as_region = 'ALL'
                             OR Isnull(job.region, '') = :as_region ) )
                     OR ( :as_region_type = 'P'
                          AND ( :as_region = 'ALL'
                                 OR Isnull(region.parent_region, '') = :as_region ) ) )
       GROUP  BY ar_invoice.book,
                 Isnull(ar_invoice.job, 'A/R w/o job'),
                 Isnull(job.description, ''),
                 Isnull(job.client, ''),
                 Isnull(client.NAME, ''),
                 Isnull(region.region, ''),
                 Isnull(region.description, ''),
                 Isnull(parent_region.region, ''),
                 Isnull(parent_region.description, '')
       UNION ALL
       /* A/P invoices are costs */
       SELECT ap_invoice.book,
              ( CASE
                  WHEN Len(ap_invoice.job) > 0 THEN ap_invoice.job
                  ELSE ''
                END )                                                                        AS job,
              ( CASE
                  WHEN Len(job.description) > 0 THEN job.description
                  ELSE 'A/P Not Posted to a Job'
                END )                                                                        AS description,
              Isnull(job.client, '')                                                         AS client,
              Isnull(client.NAME, '')                                                        AS client_name,
              Isnull(region.region, '')                                                      AS region,
              Isnull(region.description, '')                                                 AS region_description,
              Isnull(parent_region.region, '')                                               AS parent_region,
              Isnull(parent_region.description, '')                                          AS parent_region_description,
              'AP'                                                                           AS source,
              0.00                                                                           AS revenue,
              0.00                                                                           AS revenue_hrs,
              0.00                                                                           AS revenue_lab,
              0.00                                                                           AS revenue_mtl,
              0.00                                                                           AS revenue_equ,
              0.00                                                                           AS revenue_sub,
              0.00                                                                           AS revenue_je,
              Sum(ap_invoice.net_purchase
                  + ap_invoice.hbk_purchase - ap_invoice.gst_amount - ap_invoice.hst_amount) AS costs,
              0.00                                                                           AS costs_hrs,
              Sum(CASE
                    WHEN ap_invoice.gl_account = sca.jc_lab_cost THEN ( ap_invoice.quantity * ap_invoice.rate ) + ap_invoice.pst_amount
                    ELSE 0.00
                  END)                                                                       AS costs_lab,
              Sum(CASE
                    WHEN ap_invoice.gl_account = sca.jc_mtl_cost
                          OR ap_invoice.gl_account = sca.jc_intercompany_cost
                          OR ap_invoice.gl_account = sca.jc_mtl_cost_rent
                          OR ap_invoice.gl_account = sca.jc_mtl_cost_lease THEN ( ap_invoice.quantity * ap_invoice.rate ) + ap_invoice.pst_amount
                    ELSE 0.00
                  END)                                                                       AS costs_mtl,
              Sum(CASE
                    WHEN ap_invoice.gl_account = sca.jc_equ_cost THEN ( ap_invoice.quantity * ap_invoice.rate ) + ap_invoice.pst_amount
                    ELSE 0.00
                  END)                                                                       AS costs_equ,
              Sum(CASE
                    WHEN ap_invoice.gl_account = sca.jc_sub_cost THEN ( ap_invoice.quantity * ap_invoice.rate ) + ap_invoice.pst_amount
                    ELSE 0.00
                  END)                                                                       AS costs_sub,
              0.00                                                                           AS costs_je
       FROM   standard_control_account sca,
              ap_invoice WITH (nolock)
              LEFT OUTER JOIN job
                           ON job.book = ap_invoice.book
                              AND job.job = ap_invoice.job
              LEFT OUTER JOIN client
                           ON job.book = client.book
                              AND job.client = client.client
              LEFT OUTER JOIN region
                           ON job.region = region.region
              LEFT OUTER JOIN region parent_region
                           ON region.parent_region = parent_region.region
       WHERE  ap_invoice.book = :as_company
              AND ( ( :as_user_access_restricted = 'N'
                      AND ap_invoice.restrict_flag = 'N' )
                     OR :as_user_access_restricted = 'Y' )
              AND IsNull(job.file_type,'') IN ( '', :as_file_type1, :as_file_type2, :as_file_type3 )
              AND ( ( ( CASE
                          WHEN Len(ap_invoice.job) > 0 THEN ap_invoice.job
                          ELSE NULL
                        END ) BETWEEN :as_from_job AND :as_to_job )/* NULL jobs would skew the report */
                     OR ( :as_from_job = '' 
                           AND IsNull(ap_invoice.job,'') = '' 
                           AND ap_invoice.gl_account 
                            IN ( sca.jc_lab_cost, 
                                 sca.jc_mtl_cost, 
                                 sca.jc_intercompany_cost, 
                                 sca.jc_mtl_cost_rent, 
                                 sca.jc_mtl_cost_lease,
                                 sca.jc_equ_cost, 
                                 sca.jc_sub_cost ) ) )
              AND ap_invoice.ap_yyyymm BETWEEN :as_from_YYYYMM AND :as_to_YYYYMM
              AND ( ( :as_region_type = 'A'
                      AND ( :as_region = 'ALL'
                             OR Isnull(job.region, '') = :as_region ) )
                     OR ( :as_region_type = 'P'
                          AND ( :as_region = 'ALL'
                                 OR Isnull(region.parent_region, '') = :as_region ) ) )
       GROUP  BY ap_invoice.book,
                 ( CASE
                     WHEN Len(ap_invoice.job) > 0 THEN ap_invoice.job
                     ELSE ''
                   END ),
                 ( CASE
                     WHEN Len(job.description) > 0 THEN job.description
                     ELSE 'A/P Not Posted to a Job'
                   END ),
                 Isnull(job.client, ''),
                 Isnull(client.NAME, ''),
                 Isnull(region.region, ''),
                 Isnull(region.description, ''),
                 Isnull(parent_region.region, ''),
                 Isnull(parent_region.description, '')
       UNION ALL
       /* Payroll costs */
       SELECT labour_dispersion.book,
              ( CASE
                  WHEN Len(labour_dispersion.job) > 0 THEN labour_dispersion.job
                  ELSE 'P/R w/o job'
                END )                               AS job,
              Isnull(job.description, '')           AS description,
              Isnull(job.client, '')                AS client,
              Isnull(client.NAME, '')               AS client_name,
              Isnull(region.region, '')             AS region,
              Isnull(region.description, '')        AS region_description,
              Isnull(parent_region.region, '')      AS parent_region,
              Isnull(parent_region.description, '') AS parent_region_description,
              'PR'                                  AS source,
              0.00                                  AS revenue,
              0.00                                  AS revenue_hrs,
              0.00                                  AS revenue_lab,
              0.00                                  AS revenue_mtl,
              0.00                                  AS revenue_equ,
              0.00                                  AS revenue_sub,
              0.00                                  AS revenue_je,
              Sum(labour_dispersion.cost)           AS costs,
              Sum(labour_dispersion.reg_hour
                  + labour_dispersion.tah_hour
                  + labour_dispersion.ovr_hour)     AS costs_hrs,
              Sum(labour_dispersion.cost)           AS costs_lab,
              0.00                                  AS costs_mtl,
              0.00                                  AS costs_equ,
              0.00                                  AS costs_sub,
              0.00                                  AS costs_je
       FROM   labour_dispersion WITH (nolock)
              LEFT OUTER JOIN job
                           ON job.book = labour_dispersion.book
                              AND job.job = labour_dispersion.job
              LEFT OUTER JOIN client
                           ON job.book = client.book
                              AND job.client = client.client
              LEFT OUTER JOIN region
                           ON job.region = region.region
              LEFT OUTER JOIN region parent_region
                           ON region.parent_region = parent_region.region
       WHERE  labour_dispersion.book = :as_company
              AND ( job.file_type = :as_file_type1
                     OR job.file_type = :as_file_type2
                     OR job.file_type = :as_file_type3 )
              AND Isnull(labour_dispersion.job, NULL) BETWEEN :as_from_job AND :as_to_job /* NULL jobs would skew the report */
              AND labour_dispersion.gl_yyyymm BETWEEN :as_from_YYYYMM AND :as_to_YYYYMM
              AND ( ( :as_region_type = 'A'
                      AND ( :as_region = 'ALL'
                             OR Isnull(job.region, '') = :as_region ) )
                     OR ( :as_region_type = 'P'
                          AND ( :as_region = 'ALL'
                                 OR Isnull(region.parent_region, '') = :as_region ) ) )
       GROUP  BY labour_dispersion.book,
                 ( CASE
                     WHEN Len(labour_dispersion.job) > 0 THEN labour_dispersion.job
                     ELSE 'P/R w/o job'
                   END ),
                 Isnull(job.description, ''),
                 Isnull(job.client, ''),
                 Isnull(client.NAME, ''),
                 Isnull(region.region, ''),
                 Isnull(region.description, ''),
                 Isnull(parent_region.region, ''),
                 Isnull(parent_region.description, '')
        UNION ALL
        /* Journal entries posted to costs and revenues */
        SELECT journal_entry_item.book,
               Isnull(journal_entry_item.job, '')    AS job,
               ( CASE
                   WHEN Len(job.description) > 0 THEN job.description
                   ELSE 'Cost and Revenue J/Es (no job)'
                 END )                               AS description,
               Isnull(job.client, '')                AS client,
               Isnull(client.NAME, '')               AS client_name,
               Isnull(region.region, '')             AS region,
               Isnull(region.description, '')        AS region_description,
               Isnull(parent_region.region, '')      AS parent_region,
               Isnull(parent_region.description, '') AS parent_region_description,
               'JE'                                  AS source,
               Sum(CASE
                     WHEN journal_entry_item.gl_account = sca.jc_lab_revenue
                           OR journal_entry_item.gl_account = sca.jc_mtl_revenue
                           OR journal_entry_item.gl_account = sca.jc_intercompany_revenue
                           OR journal_entry_item.gl_account = sca.jc_mtl_revenue_rent
                           OR journal_entry_item.gl_account = sca.jc_mtl_revenue_lease
                           OR journal_entry_item.gl_account = sca.jc_equ_revenue
                           OR journal_entry_item.gl_account = sca.jc_sub_revenue THEN amount * -1.0
                     ELSE 0.00
                   END)                              AS revenue,/*if posted to a revenue account, then it's a revenue */
               0.00                                  AS revenue_hrs,
               Sum(CASE
                     WHEN journal_entry_item.gl_account = sca.jc_lab_revenue THEN amount * -1.0
                     ELSE 0.00
                   END)                              AS revenue_lab,
               Sum(CASE
                     WHEN journal_entry_item.gl_account = sca.jc_mtl_revenue
                           OR journal_entry_item.gl_account = sca.jc_intercompany_revenue
                           OR journal_entry_item.gl_account = sca.jc_mtl_revenue_rent
                           OR journal_entry_item.gl_account = sca.jc_mtl_revenue_lease THEN amount * -1.0
                     ELSE 0.00
                   END)                              AS revenue_mtl,
               Sum(CASE
                     WHEN journal_entry_item.gl_account = sca.jc_equ_revenue THEN amount * -1.0
                     ELSE 0.00
                   END)                              AS revenue_equ,
               Sum(CASE
                     WHEN journal_entry_item.gl_account = sca.jc_sub_revenue THEN amount * -1.0
                     ELSE 0.00
                   END)                              AS revenue_sub,
               Sum(CASE
                     WHEN journal_entry_item.gl_account = sca.jc_lab_revenue
                           OR journal_entry_item.gl_account = sca.jc_mtl_revenue
                           OR journal_entry_item.gl_account = sca.jc_intercompany_revenue
                           OR journal_entry_item.gl_account = sca.jc_mtl_revenue_rent
                           OR journal_entry_item.gl_account = sca.jc_mtl_revenue_lease
                           OR journal_entry_item.gl_account = sca.jc_equ_revenue
                           OR journal_entry_item.gl_account = sca.jc_sub_revenue THEN amount * -1.0
                     ELSE 0.00
                   END)                              AS revenue_je,/*if posted to a revenue account, then it's a revenue */
               Sum(CASE
                     WHEN journal_entry_item.gl_account = sca.jc_lab_cost
                           OR journal_entry_item.gl_account = sca.jc_mtl_cost
                           OR journal_entry_item.gl_account = sca.jc_intercompany_cost
                           OR journal_entry_item.gl_account = sca.jc_mtl_cost_rent
                           OR journal_entry_item.gl_account = sca.jc_mtl_cost_lease
                           OR journal_entry_item.gl_account = sca.jc_equ_cost
                           OR journal_entry_item.gl_account = sca.jc_sub_cost THEN amount
                     ELSE 0.00
                   END)                              AS costs,/*if not posted to a revenue account, then it's a cost */
               0.00                                  AS costs_hrs,
               Sum(CASE
                     WHEN journal_entry_item.gl_account = sca.jc_lab_cost THEN amount
                     ELSE 0.00
                   END)                              AS costs_lab,
               Sum(CASE
                     WHEN journal_entry_item.gl_account = sca.jc_mtl_cost
                           OR journal_entry_item.gl_account = sca.jc_intercompany_cost
                           OR journal_entry_item.gl_account = sca.jc_mtl_cost_rent
                           OR journal_entry_item.gl_account = sca.jc_mtl_cost_lease THEN amount
                     ELSE 0.00
                   END)                              AS costs_mtl,
               Sum(CASE
                     WHEN journal_entry_item.gl_account = sca.jc_equ_cost THEN amount
                     ELSE 0.00
                   END)                              AS costs_equ,
               Sum(CASE
                     WHEN journal_entry_item.gl_account = sca.jc_sub_cost THEN amount
                     ELSE 0.00
                   END)                              AS costs_sub,
               Sum(CASE
                     WHEN journal_entry_item.gl_account = sca.jc_lab_cost
                           OR journal_entry_item.gl_account = sca.jc_mtl_cost
                           OR journal_entry_item.gl_account = sca.jc_intercompany_cost
                           OR journal_entry_item.gl_account = sca.jc_mtl_cost_rent
                           OR journal_entry_item.gl_account = sca.jc_mtl_cost_lease
                           OR journal_entry_item.gl_account = sca.jc_equ_cost
                           OR journal_entry_item.gl_account = sca.jc_sub_cost THEN amount
                     ELSE 0.00
                   END)                              AS costs_je /*if not posted to a revenue account, then it's a cost */
        FROM   standard_control_account sca,
               journal_entry_item WITH (nolock)
               LEFT OUTER JOIN journal_entry_root
                            ON journal_entry_item.book = journal_entry_root.book
                               AND journal_entry_item.entry_no = journal_entry_root.entry_no
                               AND journal_entry_item.fiscal_year_begin = journal_entry_root.fiscal_year_begin
               LEFT OUTER JOIN job
                            ON job.book = journal_entry_root.book
                               AND job.job = journal_entry_item.job
               LEFT OUTER JOIN client
                            ON job.book = client.book
                               AND job.client = client.client
               LEFT OUTER JOIN region
                            ON job.region = region.region
               LEFT OUTER JOIN region parent_region
                            ON region.parent_region = parent_region.region
        WHERE  journal_entry_root.book = :as_company
               AND ( job.file_type = :as_file_type1
                      OR job.file_type = :as_file_type2
                      OR job.file_type = :as_file_type3 )
               AND Isnull(journal_entry_item.job, '') BETWEEN :as_from_job AND :as_to_job
               AND journal_entry_root.gl_yyyymm BETWEEN :as_from_YYYYMM AND :as_to_YYYYMM
               AND ( ( :as_region_type = 'A'
                       AND ( :as_region = 'ALL'
                              OR Isnull(job.region, '') = :as_region ) )
                      OR ( :as_region_type = 'P'
                           AND ( :as_region = 'ALL'
                                  OR Isnull(region.parent_region, '') = :as_region ) ) )
        GROUP  BY journal_entry_item.book,
                  Isnull(journal_entry_item.job, ''),
                  ( CASE
                      WHEN Len(job.description) > 0 THEN job.description
                      ELSE 'Cost and Revenue J/Es (no job)'
                    END ),
                  Isnull(job.client, ''),
                  Isnull(client.NAME, ''),
                  Isnull(region.region, ''),
                  Isnull(region.description, ''),
                  Isnull(parent_region.region, ''),
                  Isnull(parent_region.description, '')) job_cost_revenue
GROUP  BY book,
          job,
          description,
          client,
          client_name,
          region,
          region_description,
          parent_region,
          parent_region_description " retrieve.asneeded=yes arguments=(("as_company", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string),("as_from_YYYYMM", string),("as_to_YYYYMM", string),("as_region", string),("as_region_type", string),("as_user_access_restricted", string))  sort="If( as_region_type = 'A', '', parent_region ) A region A job A " )
group(level=1 header.height=72 trailer.height=72 by=("if( as_region_type = 'A', '', parent_region )" , "if( as_region_type = 'A', region, '' )" ) header.color="536870912" header.transparency="0" header.gradient.color="8421504" header.gradient.transparency="0" header.gradient.angle="0" header.brushmode="0" header.gradient.repetition.mode="0" header.gradient.repetition.count="0" header.gradient.repetition.length="100" header.gradient.focus="0" header.gradient.scale="100" header.gradient.spread="100" trailer.color="536870912" trailer.transparency="0" trailer.gradient.color="8421504" trailer.gradient.transparency="0" trailer.gradient.angle="0" trailer.brushmode="0" trailer.gradient.repetition.mode="0" trailer.gradient.repetition.count="0" trailer.gradient.repetition.length="100" trailer.gradient.focus="0" trailer.gradient.scale="100" trailer.gradient.spread="100" )
