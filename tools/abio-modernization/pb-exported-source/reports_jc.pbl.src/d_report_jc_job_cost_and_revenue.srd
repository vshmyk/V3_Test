text(band=header.1 alignment="0" text="REGION~tf_mixed_case(
if(as_region_type = 'A',
   /* show actual region and their parent */
   if( IsNull(region) OR Trim(region) = '' , 'No Region Assigned' , f_get_Region_desc(region ) )
 + if( IsNull(parent_region) OR Trim(parent_region) = ''  OR parent_region = region, '', ' (' + f_get_Region_desc(parent_region) + ')')
   /* show parent region then actual region */
   , if( IsNull(parent_Region) OR Trim( parent_region ) = '' , 'No Region Assigned', f_get_Region_desc(parent_region))
  )
