table(column=(type=char(8) updatewhereclause=yes name=book dbname="centre.book" )
 column=(type=char(6) updatewhereclause=yes name=job dbname="centre.job" )
 column=(type=char(5) updatewhereclause=yes name=area dbname="centre.area" )
 column=(type=char(6) updatewhereclause=yes name=centre dbname="centre.centre" )
 column=(type=decimal(2) updatewhereclause=yes name=to_date_revenue dbname="centre.to_date_revenue" )
 column=(type=decimal(2) updatewhereclause=yes name=ar_amt dbname="job.ar_amt" )
 retrieve="SELECT 
  centre.book, 
  centre.job, 
  centre.area, 
  centre.centre,
  centre.to_date_revenue,
  ar_amt
FROM job, book, 
  centre LEFT OUTER JOIN
(	SELECT book, job, area, centre,
          IsNull(SUM(lab_amount + mtl_amount + equ_amount + sub_amount), 0) ar_amt
	FROM ar_invoice	 
   WHERE (ar_invoice.job BETWEEN :as_from_job AND :as_to_job)  
   GROUP BY book, job, area, centre
) ar ON 
	  centre.book = ar.book AND
	  centre.job = ar.job AND
	  centre.area = ar.area AND
	  centre.centre = ar.centre
WHERE (book.book = :as_book) AND 	
		(job.book = book.book) AND
	   (job.book = centre.book) AND	
	   (job.job = centre.job) AND	
	   (centre.job BETWEEN :as_from_job AND :as_to_job) AND 
 	   (:as_job_active = 'N' OR job.active_flag = :as_job_active) AND 
	   (centre.to_date_revenue <> ar_amt)

" arguments=(("as_book", string),("as_from_job", string),("as_to_job", string),("as_job_active", string))  sort="job A area A centre A " )
group(level=1 header.height=0 trailer.height=0 trailer.height.autosize=yes by=("job" ) header.color="536870912" header.transparency="0" header.gradient.color="8421504" header.gradient.transparency="0" header.gradient.angle="0" header.brushmode="0" header.gradient.repetition.mode="0" header.gradient.repetition.count="0" header.gradient.repetition.length="100" header.gradient.focus="0" header.gradient.scale="100" header.gradient.spread="100" trailer.color="536870912" trailer.transparency="0" trailer.gradient.color="8421504" trailer.gradient.transparency="0" trailer.gradient.angle="0" trailer.brushmode="0" trailer.gradient.repetition.mode="0" trailer.gradient.repetition.count="0" trailer.gradient.repetition.length="100" trailer.gradient.focus="0" trailer.gradient.scale="100" trailer.gradient.spread="100" )
