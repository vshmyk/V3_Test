table(column=(type=char(8) updatewhereclause=yes key=yes name=book dbname="job.book" dbalias=".book" )
 column=(type=char(6) updatewhereclause=yes key=yes name=job dbname="job.job" dbalias=".job" )
 column=(type=char(1) updatewhereclause=yes name=fixed_price_flag dbname="job.fixed_price_flag" dbalias=".fixed_price_flag" )
 column=(type=char(35) updatewhereclause=yes name=description dbname="job.description" dbalias=".description" )
 column=(type=char(1) updatewhereclause=yes name=rev_os dbname="rev_os" )
 column=(type=char(1) updatewhereclause=yes name=po_os dbname="po_os" )
 column=(type=datetime updatewhereclause=yes name=job_costing dbname="job.job_costing" dbalias=".job_costing" )
 column=(type=datetime updatewhereclause=yes name=labour dbname="labour" )
 column=(type=datetime updatewhereclause=yes name=ar_invoice dbname="ar_invoice" )
 column=(type=datetime updatewhereclause=yes name=ar_payment dbname="ar_payment" )
 column=(type=datetime updatewhereclause=yes name=ap_po dbname="ap_po" )
 column=(type=datetime updatewhereclause=yes name=ap_invoice dbname="ap_invoice" )
 retrieve="  SELECT job.book,
			job.job,   
			job.fixed_price_flag,   
         job.description,   
         (CASE WHEN job.to_date_revenue = job.to_date_payment THEN '' ELSE 'Y' END) AS rev_os,
         (CASE WHEN job.commitment = 0 THEN '' ELSE 'Y' END) AS po_os,
         job.last_update AS job_costing,
         (SELECT Max(labour_dispersion.work_date) FROM labour_dispersion WHERE labour_dispersion.book = :as_book AND labour_dispersion.job = job.job) AS labour,
         (SELECT Max(ar_invoice.invoice_date) FROM ar_invoice WHERE ar_invoice.book = :as_book AND ar_invoice.job = job.job) AS ar_invoice,
         (SELECT Max(payment.payment_date) FROM payment WHERE payment.book = :as_book AND payment.job = job.job) AS ar_payment,
         (SELECT Max(po_root.issue_date) FROM po_root WHERE po_root.book = :as_book AND po_root.job = job.job) AS ap_po,
         (SELECT Max(ap_invoice.add_datetime) FROM ap_invoice WHERE ap_invoice.book = :as_book AND ap_invoice.job = job.job) AS ap_invoice
    FROM job
   WHERE job.book = :as_book AND
         (job.file_type = :as_file_type1 OR  
         job.file_type = :as_file_type2 OR  
         job.file_type = :as_file_type3) AND  
         job.job BETWEEN :as_from_job AND :as_to_job" update="job" updatewhere=0 updatekeyinplace=no arguments=(("as_book", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string))  sort="job_sort A " )
text(band=header alignment="2" text="Job  Recent Activity" border="0" color="33554432" x="14" y="8" height="80" width="4594" html.valueishtml="0"  name=t_1 visible="1"  font.face="Arial" font.height="-12" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
