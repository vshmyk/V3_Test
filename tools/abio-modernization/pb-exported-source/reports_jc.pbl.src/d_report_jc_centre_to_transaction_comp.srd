table(column=(type=char(6) updatewhereclause=yes name=job dbname="job" )
 column=(type=char(5) updatewhereclause=yes name=area dbname="area" )
 column=(type=char(6) updatewhereclause=yes name=centre dbname="centre" )
 column=(type=char(6) updatewhereclause=yes name=cc dbname="cc" )
 column=(type=decimal(2) updatewhereclause=yes name=hr_to_date_cost dbname="hr_to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=jc_hour dbname="jc_hour" )
 column=(type=decimal(2) updatewhereclause=yes name=lab_to_date_cost dbname="lab_to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=lab_amt dbname="lab_amt" )
 column=(type=decimal(2) updatewhereclause=yes name=mtl_to_date_cost dbname="mtl_to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=mtl_amt dbname="mtl_amt" )
 column=(type=decimal(2) updatewhereclause=yes name=equ_to_date_cost dbname="equ_to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=equ_amt dbname="equ_amt" )
 column=(type=decimal(2) updatewhereclause=yes name=sub_to_date_cost dbname="sub_to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=sub_amt dbname="sub_amt" )
 retrieve="SELECT 
	job, 
	area, 
	centre,
	cc,
	hr_to_date_cost, 
	jc_hour, 
	lab_to_date_cost,
	lab_amt, 
	mtl_to_date_cost,
	mtl_amt, 
	equ_to_date_cost,
	equ_amt, 
	sub_to_date_cost, 
	sub_amt
FROM
(
	SELECT 
		jc.book, 
		jc.job, 
		jc.area, 
		jc.centre,
		centre.centre cc,
		IsNUll(hr_to_date_cost, 0) hr_to_date_cost, 
		jc_hour, 
		IsNUll(lab_to_date_cost, 0) lab_to_date_cost,
		lab_amt, 
		IsNUll(mtl_to_date_cost, 0) mtl_to_date_cost,
		mtl_amt, 
		IsNUll(equ_to_date_cost, 0) equ_to_date_cost,
		equ_amt, 
		IsNUll(sub_to_date_cost, 0) sub_to_date_cost, 
		sub_amt
		FROM job, book,
		(
		 SELECT book, job, area, centre, 
				IsNUll(SUM(hr_amt), 0) as jc_hour,
				IsNUll(SUM(lab_amt), 0) as lab_amt,
				IsNUll(SUM(mtl_amt), 0) as mtl_amt,
				IsNUll(SUM(equ_amt), 0) as equ_amt,
				IsNUll(SUM(sub_amt), 0) as sub_amt
		 FROM jc_transaction
		 WHERE file_type = 'H' AND (job BETWEEN :as_from_job AND :as_to_job) AND book = :as_book
		 GROUP BY book, job, area, centre 
		) jc  LEFT OUTER JOIN centre ON
				jc.book = centre.book AND		
				jc.job = centre.job AND	
				jc.area = centre.area AND	
				jc.centre = centre.centre 
		WHERE (book.book = :as_book) AND 	
			  (job.book = book.book) AND
		     (jc.book = book.book)	AND 		  
		     (jc.job = job.job) AND 
	   	  (job.job BETWEEN :as_from_job AND :as_to_job) AND 
 			  (:as_job_active = 'N' OR job.active_flag = 'Y')   
) centre_jc_trans
WHERE 
	(hr_to_date_cost <> jc_hour) OR 
	(lab_to_date_cost <> lab_amt) OR 
	(mtl_to_date_cost <> mtl_amt) OR 
	(equ_to_date_cost <> equ_amt) OR 
	(sub_to_date_cost <> sub_amt ) OR IsNull(cc, '') = ''
" arguments=(("as_book", string),("as_from_job", string),("as_to_job", string),("as_job_active", string))  sort="job A area A centre A " )
