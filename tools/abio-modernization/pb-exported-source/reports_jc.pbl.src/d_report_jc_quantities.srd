table(column=(type=char(6) updatewhereclause=yes name=job dbname="centre.job" )
 column=(type=char(5) updatewhereclause=yes name=area dbname="centre.area" )
 column=(type=char(6) updatewhereclause=yes name=centre dbname="centre.centre" )
 column=(type=char(50) updatewhereclause=yes name=centre_lab_desc dbname="centre.lab_desc" )
 column=(type=char(3) updatewhereclause=yes name=cost_type dbname="centre.cost_type" )
 column=(type=char(4) updatewhereclause=yes name=unit dbname="centre.unit" )
 column=(type=decimal(2) updatewhereclause=yes name=forecast_qnt dbname="centre.forecast_qnt" )
 column=(type=decimal(2) updatewhereclause=yes name=to_date_qnt dbname="centre.to_date_qnt" )
 column=(type=char(35) updatewhereclause=yes name=job_description dbname="centre.description" )
 column=(type=long updatewhereclause=yes name=sort_key dbname="centre.sort_key" )
 column=(type=datetime updatewhereclause=yes name=max_date dbname="centre.max_date" )
 column=(type=decimal(2) updatewhereclause=yes name=lab_to_date dbname="lab_to_date" )
 column=(type=char(8000) updatewhereclause=yes name=lab_complete dbname="lab_complete" )
 column=(type=decimal(2) updatewhereclause=yes name=adm_to_date dbname="adm_to_date" )
 column=(type=char(8000) updatewhereclause=yes name=adm_complete dbname="adm_complete" )
 column=(type=decimal(2) updatewhereclause=yes name=mtl_to_date dbname="mtl_to_date" )
 column=(type=char(8000) updatewhereclause=yes name=mtl_complete dbname="mtl_complete" )
 column=(type=decimal(2) updatewhereclause=yes name=equ_to_date dbname="equ_to_date" )
 column=(type=char(8000) updatewhereclause=yes name=equ_complete dbname="equ_complete" )
 column=(type=decimal(2) updatewhereclause=yes name=own_to_date dbname="own_to_date" )
 column=(type=char(8000) updatewhereclause=yes name=own_complete dbname="own_complete" )
 column=(type=decimal(2) updatewhereclause=yes name=sub_to_date dbname="sub_to_date" )
 column=(type=char(8000) updatewhereclause=yes name=sub_complete dbname="sub_complete" )
 retrieve="select 
	centre_cost_types.job job, 
	centre_cost_types.area area, 
	centre_cost_types.centre centre, 
	centre_cost_types.lab_desc lab_desc, 
	centre_cost_types.cost_type cost_type, 
	centre_cost_types.unit unit, 
	centre_cost_types.forecast_qnt forecast_qnt,
	centre_cost_types.to_date_qnt to_date_qnt, 
	centre_cost_types.description description, 
	sort_key,
	latest_quantities.max_date,
	CASE WHEN lab_to_date_qnt = 0 THEN NULL ELSE lab_to_date_qnt END lab_to_date,
	(CASE WHEN CHARINDEX('L', centre.cost_type) > 0 THEN Replace(lab_complete_flag, ' ', '') ELSE '' END) lab_complete,
	CASE WHEN adm_to_date_qnt = 0 THEN NULL ELSE adm_to_date_qnt END adm_to_date,
	(CASE WHEN CHARINDEX('A', centre.cost_type) > 0 THEN Replace(adm_complete_flag, ' ', '') ELSE '' END) adm_complete,
	CASE WHEN mtl_to_date_qnt = 0 THEN NULL ELSE mtl_to_date_qnt END mtl_to_date,
	(CASE WHEN CHARINDEX('M', centre.cost_type) > 0 THEN Replace(mtl_complete_flag, ' ', '') ELSE '' END) mtl_complete,
	CASE WHEN equ_to_date_qnt = 0 THEN NULL ELSE equ_to_date_qnt END equ_to_date,
	(CASE WHEN CHARINDEX('E', centre.cost_type) > 0 THEN Replace(equ_complete_flag, ' ', '') ELSE '' END) equ_complete,
	CASE WHEN own_to_date_qnt = 0 THEN NULL ELSE own_to_date_qnt END own_to_date,
	(CASE WHEN CHARINDEX('O', centre.cost_type) > 0 THEN Replace(own_complete_flag, ' ', '') ELSE '' END) own_complete,
	CASE WHEN sub_to_date_qnt = 0 THEN NULL ELSE sub_to_date_qnt END sub_to_date,
	(CASE WHEN CHARINDEX('S', centre.cost_type) > 0 THEN Replace(sub_complete_flag, ' ', '') ELSE '' END) sub_complete
from centre,
  (SELECT centre.job,   
         centre.area,   
         centre.centre,   
         centre.description lab_desc,   
			'LAB' cost_type,
			centre.lab_unit unit,
			centre.lab_forecast_qnt forecast_qnt,
			centre.lab_to_date_qnt to_date_qnt,
			job.description,
         1 sort_key
    FROM centre,   
         job
   WHERE 
			centre.book = job.book AND 
			centre.job =  job.job AND 
         job.book = :as_book AND
			(centre.file_type = :as_file_type1 OR  
         centre.file_type = :as_file_type2 OR 
         centre.file_type = :as_file_type3) AND 
         centre.job BETWEEN :as_from_job AND :as_to_job AND  
         centre.area BETWEEN :as_from_area AND :as_to_area AND  
         centre.centre BETWEEN :as_from_centre AND :as_to_centre AND
			CharIndex('L',centre.cost_type) > 0  AND centre.lab_cur_budget_qnt <> 0 AND
         ((:as_active_centres = 'Y' AND centre.active_flag = 'Y') OR
         :as_active_centres != 'Y' OR
         :as_active_centres IS NULL) AND
         (:as_cost_type1 = 'L' OR
         :as_cost_type2 = 'L' OR
         :as_cost_type3 = 'L' OR
         :as_cost_type4 = 'L' OR
         :as_cost_type5 = 'L' OR
         :as_cost_type6 = 'L') AND
         ((:as_access_restricted_data = 'N' AND centre.restrict_flag = 'N') OR :as_access_restricted_data = 'Y')
UNION
  SELECT centre.job,   
         centre.area,   
         centre.centre,   
         centre.description adm_desc,   
			'ADM' cost_type,
			centre.adm_unit unit,
			centre.adm_forecast_qnt forecast_qnt,
			centre.adm_to_date_qnt to_date_qnt,
			job.description,
         1 sort_key
    FROM centre,   
         job
   WHERE 
			centre.book = job.book AND 
			centre.job =  job.job AND 
         job.book = :as_book AND
			(centre.file_type = :as_file_type1 OR  
         centre.file_type = :as_file_type2 OR 
         centre.file_type = :as_file_type3) AND 
         centre.job BETWEEN :as_from_job AND :as_to_job AND  
         centre.area BETWEEN :as_from_area AND :as_to_area AND  
         centre.centre BETWEEN :as_from_centre AND :as_to_centre AND
			CharIndex('A',centre.cost_type) > 0  AND centre.adm_cur_budget_qnt <> 0 AND
         ((:as_active_centres = 'Y' AND centre.active_flag = 'Y') OR
         :as_active_centres != 'Y' OR
         :as_active_centres IS NULL) AND
         (:as_cost_type1 = 'A' OR
         :as_cost_type2 = 'A' OR
         :as_cost_type3 = 'A' OR
         :as_cost_type4 = 'A' OR
         :as_cost_type5 = 'A' OR
         :as_cost_type6 = 'A') AND
         ((:as_access_restricted_data = 'N' AND centre.restrict_flag = 'N') OR :as_access_restricted_data = 'Y')
UNION
  SELECT centre.job,   
         centre.area,   
         centre.centre,   
         centre.description mat_desc,   
			'MTL' cost_type,
			centre.mtl_unit unit,
			centre.mtl_forecast_qnt forecast_qnt,
			centre.mtl_to_date_qnt to_date_qnt,
			job.description,
         2 sort_key
    FROM centre,   
         job  
   WHERE centre.book = job.book AND 
			centre.job =  job.job AND 
         job.book = :as_book AND
			(centre.file_type = :as_file_type1 OR  
         centre.file_type = :as_file_type2 OR 
         centre.file_type = :as_file_type3) AND 
         centre.job BETWEEN :as_from_job AND :as_to_job AND  
         centre.area BETWEEN :as_from_area AND :as_to_area AND  
         centre.centre BETWEEN :as_from_centre AND :as_to_centre AND
			CharIndex('M',centre.cost_type) > 0  AND centre.mtl_cur_budget_qnt <> 0 AND
         ((:as_active_centres = 'Y' AND centre.active_flag = 'Y') OR
         :as_active_centres != 'Y' OR
         :as_active_centres IS NULL) AND
         (:as_cost_type1 = 'M' OR
         :as_cost_type2 = 'M' OR
         :as_cost_type3 = 'M' OR
         :as_cost_type4 = 'M' OR
         :as_cost_type5 = 'M' OR
         :as_cost_type6 = 'M') AND
         ((:as_access_restricted_data = 'N' AND centre.restrict_flag = 'N') OR :as_access_restricted_data = 'Y')
UNION
  SELECT centre.job,   
         centre.area,   
         centre.centre,   
         centre.description equ_desc,   
			(CASE application_properties.centre_cost_type_adm_own_flag WHEN 'Y' THEN 'EQR' ELSE 'EQU' END) cost_type,
			centre.equ_unit unit,
			centre.equ_forecast_qnt forecast_qnt,
			centre.equ_to_date_qnt to_date_qnt,
			job.description,
         3 sort_key
    FROM centre,   
         job,
         application_properties  
   WHERE centre.book = job.book AND 
			centre.job =  job.job AND 
         job.book = :as_book AND
			(centre.file_type = :as_file_type1 OR  
         centre.file_type = :as_file_type2 OR 
         centre.file_type = :as_file_type3) AND 
         centre.job BETWEEN :as_from_job AND :as_to_job AND  
         centre.area BETWEEN :as_from_area AND :as_to_area AND  
         centre.centre BETWEEN :as_from_centre AND :as_to_centre AND
			CharIndex('E',centre.cost_type) > 0  AND centre.equ_cur_budget_qnt <> 0 AND
         ((:as_active_centres = 'Y' AND centre.active_flag = 'Y') OR
         :as_active_centres != 'Y' OR
         :as_active_centres IS NULL) AND
         (:as_cost_type1 = 'E' OR
         :as_cost_type2 = 'E' OR
         :as_cost_type3 = 'E' OR
         :as_cost_type4 = 'E'OR
         :as_cost_type5 = 'E'OR
         :as_cost_type6 = 'E') AND
         ((:as_access_restricted_data = 'N' AND centre.restrict_flag = 'N') OR :as_access_restricted_data = 'Y')
UNION
  SELECT centre.job,   
         centre.area,   
         centre.centre,   
         centre.description eqo_desc,   
			'EQO' cost_type,
			centre.own_unit unit,
			centre.own_forecast_qnt forecast_qnt,
			centre.own_to_date_qnt to_date_qnt,
			job.description,
         3 sort_key
    FROM centre,   
         job  
   WHERE centre.book = job.book AND 
			centre.job =  job.job AND 
         job.book = :as_book AND
			(centre.file_type = :as_file_type1 OR  
         centre.file_type = :as_file_type2 OR 
         centre.file_type = :as_file_type3) AND 
         centre.job BETWEEN :as_from_job AND :as_to_job AND  
         centre.area BETWEEN :as_from_area AND :as_to_area AND  
         centre.centre BETWEEN :as_from_centre AND :as_to_centre AND
			CharIndex('O',centre.cost_type) > 0  AND centre.own_cur_budget_qnt <> 0 AND
         ((:as_active_centres = 'Y' AND centre.active_flag = 'Y') OR
         :as_active_centres != 'Y' OR
         :as_active_centres IS NULL) AND
         (:as_cost_type1 = 'O' OR
         :as_cost_type2 = 'O' OR
         :as_cost_type3 = 'O' OR
         :as_cost_type4 = 'O'OR
         :as_cost_type5 = 'O'OR
         :as_cost_type6 = 'O') AND
         ((:as_access_restricted_data = 'N' AND centre.restrict_flag = 'N') OR :as_access_restricted_data = 'Y')
UNION
  SELECT centre.job,   
         centre.area,   
         centre.centre,   
         centre.description sub_desc,   
			'SUB' cost_type,
			centre.sub_unit unit,
			centre.sub_forecast_qnt forecast_qnt,
			centre.sub_to_date_qnt to_date_qnt,
			job.description,
         4 sort_key
    FROM centre,   
         job  
   WHERE centre.book = job.book AND 
			centre.job =  job.job AND 
         job.book = :as_book AND
			(centre.file_type = :as_file_type1 OR  
         centre.file_type = :as_file_type2 OR 
         centre.file_type = :as_file_type3) AND 
         centre.job BETWEEN :as_from_job AND :as_to_job AND  
         centre.area BETWEEN :as_from_area AND :as_to_area AND  
         centre.centre BETWEEN :as_from_centre AND :as_to_centre AND
			CharIndex('S',centre.cost_type) > 0  AND centre.sub_cur_budget_qnt <> 0 AND
         ((:as_active_centres = 'Y' AND centre.active_flag = 'Y') OR
         :as_active_centres != 'Y' OR
         :as_active_centres IS NULL) AND
         (:as_cost_type1 = 'S' OR
         :as_cost_type2 = 'S' OR
         :as_cost_type3 = 'S' OR
         :as_cost_type4 = 'S'OR
         :as_cost_type5 = 'S'OR
         :as_cost_type6 = 'S') AND
         ((:as_access_restricted_data = 'N' AND centre.restrict_flag = 'N') OR :as_access_restricted_data = 'Y')
	) centre_cost_types
   LEFT OUTER JOIN (SELECT book, job, 
									area, 
									centre, 
									max(measurement_date) max_date
							 FROM quantity 
						   WHERE book = :as_book 
							  AND quantity.job BETWEEN :as_from_job AND :as_to_job   
							  AND quantity.area BETWEEN :as_from_area AND :as_to_area   
							  AND quantity.centre BETWEEN :as_from_centre AND :as_to_centre 
						GROUP BY book, 
									job, 
									area, 
									centre) latest_quantities 
        ON latest_quantities.job = centre_cost_types.job
       AND latest_quantities.area = centre_cost_types.area
       AND latest_quantities.centre = centre_cost_types.centre
WHERE centre.book =:as_book AND 
		centre.job = centre_cost_types.job AND 
		centre.area = centre_cost_types.area AND 
		centre.centre = centre_cost_types.centre
ORDER BY centre_cost_types.job ASC,   
         centre_cost_types.area ASC,   
         centre_cost_types.centre ASC   
" arguments=(("as_book", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string),("as_from_area", string),("as_to_area", string),("as_from_centre", string),("as_to_centre", string),("as_active_centres", string),("as_cost_type1", string),("as_cost_type2", string),("as_cost_type3", string),("as_cost_type4", string),("as_cost_type5", string),("as_cost_type6", string),("as_access_restricted_data", string),("as_all_types", string))  sort="job_sort A area_sort A centre_sort A sort_key A " )
