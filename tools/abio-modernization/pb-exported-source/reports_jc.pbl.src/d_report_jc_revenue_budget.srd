table(column=(type=char(6) updatewhereclause=yes name=job dbname="centre.job" )
 column=(type=char(5) updatewhereclause=yes name=area dbname="centre.area" )
 column=(type=char(6) updatewhereclause=yes name=centre dbname="centre.centre" )
 column=(type=char(50) updatewhereclause=yes name=description dbname="centre.description" )
 column=(type=decimal(2) updatewhereclause=yes name=current_budget dbname="current_budget" )
 column=(type=decimal(2) updatewhereclause=yes name=original_budget dbname="original_budget" )
 column=(type=decimal(4) updatewhereclause=yes name=commit_cost dbname="commit_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=to_date_cost dbname="to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=to_date_revenue dbname="centre.to_date_revenue" )
 column=(type=char(35) updatewhereclause=yes name=job_description dbname="job.description" )
 column=(type=char(20) updatewhereclause=yes name=client_po dbname="centre.client_po" )
 column=(type=char(10) updatewhereclause=yes name=construction_work_package dbname="centre.construction_work_package" )
 column=(type=char(6) updatewhereclause=yes name=job_region dbname="job.region" )
 retrieve="  SELECT centre.job,   
         centre.area,   
         centre.centre,   
         centre.description, 

         (centre.lab_cur_budget_amt + 
			 centre.mtl_cur_budget_amt + 
			 centre.equ_cur_budget_amt + 
			 centre.sub_cur_budget_amt +
          (CASE application_properties.centre_cost_type_adm_own_flag 
			  WHEN 'Y' 
			  THEN centre.own_cur_budget_amt + 
				    centre.adm_cur_budget_amt 
			  ELSE 0 END)) AS current_budget,

         (centre.lab_orig_budget_amt + 
			 centre.mtl_orig_budget_amt + 
			 centre.equ_orig_budget_amt + 
			 centre.sub_orig_budget_amt +
          (CASE application_properties.centre_cost_type_adm_own_flag 
			  WHEN 'Y' 
			  THEN centre.own_orig_budget_amt + 
					 centre.adm_orig_budget_amt 
			  ELSE 0 END)) AS original_budget,

         (centre.lab_commit_cost + 
			 centre.mtl_commit_cost + 
			 centre.equ_commit_cost + 
			 centre.sub_commit_cost +
          (CASE application_properties.centre_cost_type_adm_own_flag 
			  WHEN 'Y' 
			  THEN centre.own_commit_cost + 
					 centre.adm_commit_cost 
			  ELSE 0 END)) AS commit_cost,

         (centre.lab_to_date_cost + 
			 centre.mtl_to_date_cost + 
			 centre.equ_to_date_cost + 
			 centre.sub_to_date_cost +
          (CASE application_properties.centre_cost_type_adm_own_flag 
			  WHEN 'Y' 
			  THEN centre.own_to_date_cost + 
                centre.adm_to_date_cost 
			  ELSE 0 END)) AS to_date_cost,

			centre.to_date_revenue,
			job.description,
         centre.client_po,
         centre.construction_work_package,
			job.region
    FROM centre,
         job LEFT OUTER JOIN region ON 
			job.region = region.region,  
			application_properties
   WHERE centre.job = job.job AND 
         centre.book = job.book AND
         centre.book = :as_book AND
			centre.file_type in ( :as_file_type1, :as_file_type2, :as_file_type3 ) AND 
         centre.job BETWEEN :as_from_job AND :as_to_job AND  
         centre.area BETWEEN :as_from_area AND :as_to_area AND  
         centre.centre BETWEEN :as_from_centre AND :as_to_centre AND
			((:as_region_type = 'A' AND (:as_region = 'ALL' OR job.region = :as_region)) OR ( :as_region_type = 'P' AND (:as_region = 'ALL' OR region.parent_region = :as_region))) AND 
			((CharIndex('R',centre.cost_type) > 0 OR IsNull(centre.to_date_revenue, 0) <> 0 AND :as_only_revenue_centres = 'Y') OR 
			 (:as_only_revenue_centres = 'N' AND (CharIndex('R',centre.cost_type) > 0 OR IsNull(centre.to_date_revenue, 0) <> 0 OR 
					(lab_cur_budget_amt <> 0 OR 
					 adm_cur_budget_amt <> 0 OR 
					 mtl_cur_budget_amt <> 0 OR 
					 equ_cur_budget_amt <> 0 OR 
					 own_cur_budget_amt <> 0 OR 
					 sub_cur_budget_amt <> 0 OR 
					 lab_to_date_cost <> 0 OR
					 adm_to_date_cost <> 0 OR
					 mtl_to_date_cost <> 0 OR
					 equ_to_date_cost <> 0 OR
					 own_to_date_cost <> 0 OR
					 sub_to_date_cost <> 0 OR
					 lab_commit_cost <> 0 OR
					 adm_commit_cost <> 0 OR
					 mtl_commit_cost <> 0 OR
					 equ_commit_cost <> 0 OR
					 own_commit_cost <> 0 OR
					 sub_commit_cost <> 0)
			)
			)
			)
			AND (centre.restrict_flag = 'N' OR :as_access_restricted_data = 'Y')
" arguments=(("as_book", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string),("as_from_area", string),("as_to_area", string),("as_from_centre", string),("as_to_centre", string),("as_budget", string),("as_access_restricted_data", string),("as_only_revenue_centres", string),("as_region", string),("as_region_type", string))  sort="job A area A If( IsNumber( centre ), 1, 2 ) A If( IsNumber( centre ), Long( centre ), 0 ) A centre A " )
