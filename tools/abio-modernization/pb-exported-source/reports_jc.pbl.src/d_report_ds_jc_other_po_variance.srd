 retrieve="  SELECT centre.client_po,
         centre.job,   
         centre.area,   
         centre.centre,   
         centre.description,  
 
         centre.lab_cur_month_amt,
         centre.adm_cur_month_amt,
         centre.mtl_cur_month_amt,
         centre.equ_cur_month_amt,
         centre.own_cur_month_amt,
         centre.sub_cur_month_amt,

         centre.lab_to_date_cost,
         centre.adm_to_date_cost,
         centre.mtl_to_date_cost,
         centre.equ_to_date_cost,
         centre.own_to_date_cost,
         centre.sub_to_date_cost,

         centre.lab_month_end_commit,
         centre.adm_month_end_commit,
         centre.mtl_month_end_commit,
         centre.equ_month_end_commit,
         centre.own_month_end_commit,
         centre.sub_month_end_commit,

         centre.lab_commit_cost,
         centre.adm_commit_cost,
         centre.mtl_commit_cost,
         centre.equ_commit_cost,
         centre.own_commit_cost,
         centre.sub_commit_cost,

         centre.lab_forecast_amt,
         centre.adm_forecast_amt,
         centre.mtl_forecast_amt,
         centre.equ_forecast_amt,
         centre.own_forecast_amt,
         centre.sub_forecast_amt,

         centre.lab_cur_budget_amt,
         centre.adm_cur_budget_amt,
         centre.mtl_cur_budget_amt,
         centre.equ_cur_budget_amt,
         centre.own_cur_budget_amt,
         centre.sub_cur_budget_amt,

         centre.lab_variance_amt,
         centre.adm_variance_amt,
         centre.mtl_variance_amt,
         centre.equ_variance_amt,
         centre.own_variance_amt,
         centre.sub_variance_amt,

			centre.hr_cur_budget_amt,
			centre.hr_to_date_cost,
			centre.adm_hr_cur_budget_amt,
			centre.adm_hr_to_date_cost

    FROM centre
   WHERE centre.book = :as_book AND
         (centre.file_type = :as_file_type1 OR  
         centre.file_type = :as_file_type2 OR  
         centre.file_type = :as_file_type3) AND  
         centre.client_po BETWEEN :as_from_po AND :as_to_po AND
         centre.job BETWEEN :as_from_job AND :as_to_job AND
         ((:as_access_restricted_data = 'N' AND centre.restrict_flag = 'N') OR :as_access_restricted_data = 'Y')
ORDER BY centre.client_po,
         centre.job,   
         centre.area,   
         centre.centre
" arguments=(("as_book", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_po", string),("as_to_po", string),("as_from_job", string),("as_to_job", string),("as_access_restricted_data", string),("as_job_cost_month_variance_flag", string)) )
