table(column=(type=decimal(2) updatewhereclause=yes name=budget_amt_hr dbname="budget_amt_hr" )
 column=(type=decimal(2) updatewhereclause=yes name=budget_amt_lab dbname="budget_amt_lab" )
 column=(type=decimal(2) updatewhereclause=yes name=to_date_cost_lab_hr dbname="to_date_cost_lab_hr" )
 column=(type=decimal(2) updatewhereclause=yes name=to_date_cost_lab dbname="to_date_cost_lab" )
 column=(type=decimal(2) updatewhereclause=yes name=budget_amt_adm_hr dbname="budget_amt_adm_hr" )
 column=(type=decimal(2) updatewhereclause=yes name=budget_amt_adm dbname="budget_amt_adm" )
 column=(type=decimal(2) updatewhereclause=yes name=to_date_cost_adm_hr dbname="to_date_cost_adm_hr" )
 column=(type=decimal(2) updatewhereclause=yes name=to_date_cost_adm dbname="to_date_cost_adm" )
 retrieve="SELECT Sum(CASE :as_budget WHEN 'C' THEN centre.hr_cur_budget_amt ELSE centre.hr_orig_budget_amt END) 			AS budget_amt_hr,
       Sum(CASE :as_budget WHEN 'C' THEN centre.lab_cur_budget_amt ELSE centre.lab_orig_budget_amt END) 			AS budget_amt_lab,
       Sum(CASE :as_snapshot WHEN 'L' THEN centre.hr_to_date_cost ELSE centre.hr_snapshot_cost END) 				AS to_date_cost_lab_hr,
       Sum(CASE :as_snapshot WHEN 'L' THEN centre.lab_to_date_cost ELSE centre.lab_snapshot_cost END) 			AS to_date_cost_lab,
		 
		 Sum(CASE :as_budget WHEN 'C' THEN centre.adm_hr_cur_budget_amt ELSE centre.adm_hr_orig_budget_amt END) 	AS budget_amt_adm_hr,
       Sum(CASE :as_budget WHEN 'C' THEN centre.adm_cur_budget_amt ELSE centre.adm_orig_budget_amt END) 			AS budget_amt_adm,
       Sum(CASE :as_snapshot WHEN 'L' THEN centre.adm_hr_to_date_cost ELSE centre.adm_hr_snapshot_cost END) 	AS to_date_cost_adm_hr,
       Sum(CASE :as_snapshot WHEN 'L' THEN centre.adm_to_date_cost ELSE centre.adm_snapshot_cost END) 			AS to_date_cost_adm

  FROM centre   
 WHERE centre.book = :as_book AND
       centre.job = :as_job AND
       centre.area BETWEEN :as_from_area AND :as_to_area AND
       centre.centre BETWEEN :as_from_centre AND :as_to_centre
" arguments=(("as_book", string),("as_job", string),("as_from_area", string),("as_to_area", string),("as_from_centre", string),("as_to_centre", string),("as_budget", string),("as_snapshot", string)) )
