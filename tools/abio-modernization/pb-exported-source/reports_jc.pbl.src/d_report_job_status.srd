table(column=(type=char(8) updatewhereclause=yes name=job_book dbname="job.book" dbalias=".book" )
 column=(type=char(6) updatewhereclause=yes name=job dbname="job.job" dbalias=".job" )
 column=(type=char(1) updatewhereclause=yes name=job_fixed_price_flag dbname="job.fixed_price_flag" dbalias=".fixed_price_flag" )
 column=(type=char(35) updatewhereclause=yes name=description dbname="job.description" dbalias=".description" )
 column=(type=decimal(2) updatewhereclause=yes name=contract_amount dbname="job.contract_amount" dbalias=".contract_amount" )
 column=(type=decimal(2) updatewhereclause=yes name=original_budget dbname="job.original_budget" dbalias=".original_budget" )
 column=(type=decimal(2) updatewhereclause=yes name=current_budget dbname="job.current_budget" dbalias=".current_budget" )
 column=(type=decimal(2) updatewhereclause=yes name=to_date_cost dbname="job.to_date_cost" dbalias=".to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=to_date_revenue dbname="job.to_date_revenue" dbalias=".to_date_revenue" )
 column=(type=decimal(2) updatewhereclause=yes name=to_date_payment dbname="job.to_date_payment" dbalias=".to_date_payment" )
 column=(type=decimal(2) updatewhereclause=yes name=commitment dbname="job.commitment" dbalias=".commitment" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=forecast dbname="forecast" )
 column=(type=char(6) updatewhereclause=yes name=job_region dbname="job.region" dbalias=".region" )
 retrieve="  SELECT job.book,
			job.job,   
			job.fixed_price_flag,   
         job.description,   
         job.contract_amount,   
         job.original_budget,   
         job.current_budget,   
         job.to_date_cost,   
         job.to_date_revenue,   
         job.to_date_payment,   
         job.commitment,   
         sum(lab_forecast_amt+mtl_forecast_amt+equ_forecast_amt+sub_forecast_amt) as forecast,
			job.region
    FROM job,   
         centre  
   WHERE job.job = centre.job AND
         job.book = :as_book AND
         centre.book = :as_book AND
         (job.file_type = :as_file_type1 OR  
         job.file_type = :as_file_type2 OR  
         job.file_type = :as_file_type3) AND  
         job.job BETWEEN :as_from_job AND :as_to_job AND 
			(:as_region = 'ALL' OR job.region = :as_region) 
GROUP BY job.book,
			job.job,   
			job.fixed_price_flag,   
         job.description,   
			job.region,   
         job.contract_amount,   
         job.original_budget,   
         job.current_budget,   
         job.to_date_cost,   
         job.to_date_revenue,   
         job.to_date_payment,   
         job.commitment   
" arguments=(("as_book", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string),("as_region", string))  sort="job_sort A " )
text(band=header alignment="2" text="Job Status" border="0" color="33554432" x="14" y="8" height="80" width="4594" html.valueishtml="0"  name=t_1 visible="1"  font.face="Arial" font.height="-12" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
compute(band=header alignment="2" expression="f_mixed_case(f_job(as_from_job, as_to_job) 
+ ', ' + f_files(as_file_type1, as_file_type2, as_file_type3)
+ ', ' +IF(as_region <> 'ALL', 'region ' + as_region + ~" - ~" + f_get_region_desc(as_region),  'all regions')
, ~"C~")"border="0" color="33554432" x="14" y="112" height="64" width="4594" format="[GENERAL]" html.valueishtml="0"  name=criteria visible="1"  font.face="Arial" font.height="-9" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
