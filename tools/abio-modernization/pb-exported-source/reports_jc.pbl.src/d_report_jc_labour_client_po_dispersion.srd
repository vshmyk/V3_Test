 retrieve="  SELECT labour_dispersion.book,   
         labour_dispersion.employee,   
         labour_dispersion.work_date,   
         labour_dispersion.dispersion_item,   
         labour_dispersion.job,   
         labour_dispersion.area,   
         labour_dispersion.centre,   
         labour_dispersion.timesheet_item,   
         labour_dispersion.timesheet_job,   
         labour_dispersion.timesheet_area,   
         labour_dispersion.timesheet_centre,   
         labour_dispersion.source,   
         labour_dispersion.trade_union,   
         labour_dispersion.occupation,   
         labour_dispersion.shift,   
         labour_dispersion.gl_yyyymm,   
         labour_dispersion.reg_hour,   
         labour_dispersion.tah_hour,   
         labour_dispersion.ovr_hour,   
         labour_dispersion.loa_hour,   
         labour_dispersion.sched_premium_hour,   
         labour_dispersion.spot_premium_hour,   
         labour_dispersion.shut_premium_hour,   
         labour_dispersion.meal,   
         labour_dispersion.subsistence,   
         labour_dispersion.rotation,   
         labour_dispersion.site_allowance,   
         labour_dispersion.retro,   
         labour_dispersion.fringe,   
         labour_dispersion.overhead,   
         labour_dispersion.cost,   
         labour_dispersion.reg_rate,   
         labour_dispersion.tah_rate,   
         labour_dispersion.ovr_rate,   
         labour_dispersion.loa_rate,   
         labour_dispersion.extract_date,   
         labour_dispersion.extract_reference,   
         labour_dispersion.snapshot_date,   
         labour_dispersion.file_type,   
         centre.client_po,   
         centre.lab_po_item,   
         centre.construction_work_package,
			client_po.description,
			employee.name,
			job.description job_description,
         labour_dispersion.recruitment,
         labour_dispersion.retention
	from	labour_dispersion
			INNER JOIN centre ON
					centre.book = labour_dispersion.book
					and centre.job = labour_dispersion.job
					and centre.area = labour_dispersion.area
					and centre.centre = labour_dispersion.centre
					AND ( centre.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' ) 
			INNER JOIN employee ON
					employee.book = labour_dispersion.book
					AND employee.employee = labour_dispersion.employee
					AND ( employee.restrict_flag = 'N' OR :as_user_access_restricted = 'Y' ) 
			LEFT OUTER JOIN client_po 
					 ON client_po.job = centre.job
					AND client_po.client_po = centre.client_po
			INNER JOIN job  
                ON job.book = labour_dispersion.book 
               AND job.job = labour_dispersion.job 
   WHERE labour_dispersion.book = :as_company and
			labour_dispersion.file_type in ( :as_file_type1, :as_file_type2 ) and
			labour_dispersion.job between :as_from_job and :as_to_job and
			UPPER( labour_dispersion.extract_reference ) between :as_from_ref and :as_to_ref and
			labour_dispersion.trade_union between :as_from_group and :as_to_group and
			labour_dispersion.gl_yyyymm between :as_from_yyyymm and :as_to_yyyymm and
         ( ( :as_date_type = 'A' AND labour_dispersion.work_date >= :adt_from_date AND labour_dispersion.work_date < DATEADD( day, 1, :adt_to_date )) OR  
           ( :as_date_type = 'S' AND labour_dispersion.snapshot_date >= :adt_from_date AND labour_dispersion.snapshot_date < DATEADD( day, 1, :adt_to_date )) OR  
			  ( :as_date_type = 'E' AND labour_dispersion.add_datetime >= :adt_from_date AND labour_dispersion.add_datetime < DATEADD( day, 1, :adt_to_date )) OR 
           ( :as_date_type = 'X' AND labour_dispersion.extract_date >= :adt_from_date and labour_dispersion.extract_date < DATEADD( day, 1, :adt_to_date )) OR
			  ( :as_date_type = 'N' AND labour_dispersion.extract_date IS NULL
						and labour_dispersion.work_date between :adt_from_date and :adt_to_date ) ) and
			( :as_source = 'ALL' OR labour_dispersion.source = REPLACE( :as_source, '/', '' ) ) and
			centre.client_po between :as_from_client_code and :as_to_client_code and
			ltrim( centre.client_po ) <> ''
" arguments=(("as_company", string),("as_file_type1", string),("as_file_type2", string),("as_from_job", string),("as_to_job", string),("as_from_client_code", string),("as_to_client_code", string),("as_from_ref", string),("as_to_ref", string),("as_from_group", string),("as_to_group", string),("as_from_yyyymm", string),("as_to_yyyymm", string),("adt_from_date", datetime),("adt_to_date", datetime),("as_date_type", string),("as_source", string),("as_user_access_restricted", string))  sort="labour_dispersion_job A centre_client_po A labour_dispersion_trade_union A labour_dispersion_occupation A labour_dispersion_work_date A labour_dispersion_employee A labour_dispersion_area A labour_dispersion_centre A " )
