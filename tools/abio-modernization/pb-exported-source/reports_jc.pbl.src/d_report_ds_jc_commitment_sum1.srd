release 9;
datawindow(units=0 timer_interval=0 color=67108864 processing=1 HTMLDW=no print.printername="" print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.canusedefaultprinter=yes print.prompt=no print.buttons=no print.preview.buttons=no print.cliptext=no print.overrideprintjob=no print.collate=yes hidegrayline=no grid.lines=0 )
header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=92 color="536870912" )
table(column=(type=decimal(2) updatewhereclause=yes name=camtl dbname="camtl" )
 column=(type=decimal(2) updatewhereclause=yes name=camtm dbname="camtm" )
 column=(type=decimal(2) updatewhereclause=yes name=camte dbname="camte" )
 column=(type=decimal(2) updatewhereclause=yes name=camts dbname="camts" )
 retrieve="  SELECT Sum(centre.lab_commit_cost) AS camtl,   
         Sum(centre.mtl_commit_cost) AS camtm,   
         Sum(centre.equ_commit_cost) AS camte,   
         Sum(centre.sub_commit_cost) AS camts
    FROM centre  
   WHERE centre.book = :as_book AND 
         centre.job = :as_job AND  
         centre.area BETWEEN :as_from_area AND :as_to_area AND  
         centre.centre BETWEEN :as_from_centre AND :as_to_centre
" arguments=(("as_book", string),("as_job", string),("as_from_area", string),("as_to_area", string),("as_from_centre", string),("as_to_centre", string)) )
