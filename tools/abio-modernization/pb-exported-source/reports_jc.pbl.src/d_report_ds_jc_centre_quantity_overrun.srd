 column=(type=decimal(2) updatewhereclause=yes name=equ_to_date_qnt dbname="centre.equ_to_date_qnt" dbalias=".equ_to_date_qnt" )
 column=(type=decimal(2) updatewhereclause=yes name=own_to_date_qnt dbname="centre.own_to_date_qnt" dbalias=".own_to_date_qnt" )
 column=(type=decimal(2) updatewhereclause=yes name=sub_to_date_qnt dbname="centre.sub_to_date_qnt" dbalias=".sub_to_date_qnt" )
 retrieve="select	centre.job,
			centre.area,
			centre.centre,
			centre.description,
			centre.cost_type,
			centre.lab_unit,
			centre.adm_unit,
			centre.mtl_unit,
			centre.equ_unit,
			centre.own_unit,
			centre.sub_unit,

			centre.lab_orig_budget_qnt,
			centre.adm_orig_budget_qnt,
			centre.mtl_orig_budget_qnt,
			centre.equ_orig_budget_qnt,
			centre.own_orig_budget_qnt,
			centre.sub_orig_budget_qnt,

			centre.lab_cur_budget_qnt,
			centre.adm_cur_budget_qnt,
			centre.mtl_cur_budget_qnt,
			centre.equ_cur_budget_qnt,
			centre.own_cur_budget_qnt,
			centre.sub_cur_budget_qnt,

			centre.lab_forecast_qnt,
			centre.adm_forecast_qnt,
			centre.mtl_forecast_qnt,
			centre.equ_forecast_qnt,
			centre.own_forecast_qnt,
			centre.sub_forecast_qnt,

			centre.lab_to_date_qnt,
			centre.adm_to_date_qnt,
			centre.mtl_to_date_qnt,
			centre.equ_to_date_qnt,
			centre.own_to_date_qnt,
			centre.sub_to_date_qnt

from		centre
where		centre.book = :as_company
			and centre.job = :as_job
			and centre.area between :as_from_area and :as_to_area
			and centre.centre between :as_from_centre and :as_to_centre
			and ( centre.restrict_flag = 'N' or :as_access_user_restrict = 'Y' )
" arguments=(("as_company", string),("as_job", string),("as_from_area", string),("as_to_area", string),("as_from_centre", string),("as_to_centre", string),("as_access_user_restrict", string))  sort="job A area A centre A " )
