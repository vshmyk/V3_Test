 retrieve="  SELECT centre.area,
         centre.client_po,
         centre.construction_work_package,

         centre.lab_po_item,
         centre.adm_po_item,
         centre.mtl_po_item,
         centre.equ_po_item,
         centre.own_po_item,
         centre.sub_po_item,

         client_po.description AS po_desc,
         centre.job,
         centre.centre,
         area.description as area_name,
         centre.description,

         (CASE WHEN :as_budget = 'C' THEN centre.lab_cur_budget_qnt ELSE centre.lab_orig_budget_qnt END) AS lab_budget_qnt,
         (CASE WHEN :as_budget = 'C' THEN centre.adm_cur_budget_qnt ELSE centre.adm_orig_budget_qnt END) AS adm_budget_qnt,
         (CASE WHEN :as_budget = 'C' THEN centre.mtl_cur_budget_qnt ELSE centre.mtl_orig_budget_qnt END) AS mtl_budget_qnt,
         (CASE WHEN :as_budget = 'C' THEN centre.equ_cur_budget_qnt ELSE centre.equ_orig_budget_qnt END) AS equ_budget_qnt,
         (CASE WHEN :as_budget = 'C' THEN centre.own_cur_budget_qnt ELSE centre.own_orig_budget_qnt END) AS own_budget_qnt,
         (CASE WHEN :as_budget = 'C' THEN centre.sub_cur_budget_qnt ELSE centre.sub_orig_budget_qnt END) AS sub_budget_qnt,

         (CASE WHEN :as_budget = 'C' THEN centre.hr_cur_budget_amt ELSE centre.hr_orig_budget_amt END) AS hr_budget_amt,
         (CASE WHEN :as_budget = 'C' THEN centre.adm_hr_cur_budget_amt ELSE centre.adm_hr_orig_budget_amt END) AS adm_hr_budget_amt,

         (CASE WHEN :as_budget = 'C' THEN centre.lab_cur_budget_amt ELSE centre.lab_orig_budget_amt END) AS lab_budget_amt,
         (CASE WHEN :as_budget = 'C' THEN centre.adm_cur_budget_amt ELSE centre.adm_orig_budget_amt END) AS adm_budget_amt,
         (CASE WHEN :as_budget = 'C' THEN centre.mtl_cur_budget_amt ELSE centre.mtl_orig_budget_amt END) AS mtl_budget_amt,
         (CASE WHEN :as_budget = 'C' THEN centre.equ_cur_budget_amt ELSE centre.equ_orig_budget_amt END) AS equ_budget_amt,
         (CASE WHEN :as_budget = 'C' THEN centre.own_cur_budget_amt ELSE centre.own_orig_budget_amt END) AS own_budget_amt,
         (CASE WHEN :as_budget = 'C' THEN centre.sub_cur_budget_amt ELSE centre.sub_orig_budget_amt END) AS sub_budget_amt,

         (CASE WHEN :as_snap = 'L' THEN centre.hr_forecast_amt ELSE centre.hr_snapshot_forecast END) AS hr_forecast,
         (CASE WHEN :as_snap = 'L' THEN centre.adm_hr_forecast_amt ELSE centre.adm_hr_snapshot_forecast END) AS adm_hr_forecast,

         (CASE WHEN :as_snap = 'L' THEN centre.lab_forecast_amt ELSE centre.lab_snapshot_forecast END) AS lab_forecast,
         (CASE WHEN :as_snap = 'L' THEN centre.adm_forecast_amt ELSE centre.adm_snapshot_forecast END) AS adm_forecast,
         (CASE WHEN :as_snap = 'L' THEN centre.mtl_forecast_amt ELSE centre.mtl_snapshot_forecast END) AS mtl_forecast,
         (CASE WHEN :as_snap = 'L' THEN centre.equ_forecast_amt ELSE centre.equ_snapshot_forecast END) AS equ_forecast,
         (CASE WHEN :as_snap = 'L' THEN centre.own_forecast_amt ELSE centre.own_snapshot_forecast END) AS own_forecast,
         (CASE WHEN :as_snap = 'L' THEN centre.sub_forecast_amt ELSE centre.sub_snapshot_forecast END) AS sub_forecast,

         (CASE WHEN :as_snap = 'L' THEN centre.hr_to_date_cost ELSE centre.hr_snapshot_cost END) AS hr_cost,
         (CASE WHEN :as_snap = 'L' THEN centre.adm_hr_to_date_cost ELSE centre.adm_hr_snapshot_cost END) AS adm_hr_cost,

         (CASE WHEN :as_snap = 'L' THEN centre.lab_to_date_cost ELSE centre.lab_snapshot_cost END) AS lab_cost,
         (CASE WHEN :as_snap = 'L' THEN centre.adm_to_date_cost ELSE centre.adm_snapshot_cost END) AS adm_cost,
         (CASE WHEN :as_snap = 'L' THEN centre.mtl_to_date_cost ELSE centre.mtl_snapshot_cost END) AS mtl_cost,
         (CASE WHEN :as_snap = 'L' THEN centre.equ_to_date_cost ELSE centre.equ_snapshot_cost END) AS equ_cost,
         (CASE WHEN :as_snap = 'L' THEN centre.own_to_date_cost ELSE centre.own_snapshot_cost END) AS own_cost,
         (CASE WHEN :as_snap = 'L' THEN centre.sub_to_date_cost ELSE centre.sub_snapshot_cost END) AS sub_cost,

         (CASE WHEN :as_snap = 'L' THEN centre.lab_commit_cost ELSE centre.lab_snapshot_commit END) AS lab_commit,
         (CASE WHEN :as_snap = 'L' THEN centre.adm_commit_cost ELSE centre.adm_snapshot_commit END) AS adm_commit,
         (CASE WHEN :as_snap = 'L' THEN centre.mtl_commit_cost ELSE centre.mtl_snapshot_commit END) AS mtl_commit,
         (CASE WHEN :as_snap = 'L' THEN centre.equ_commit_cost ELSE centre.equ_snapshot_commit END) AS equ_commit,
         (CASE WHEN :as_snap = 'L' THEN centre.own_commit_cost ELSE centre.own_snapshot_commit END) AS own_commit,
         (CASE WHEN :as_snap = 'L' THEN centre.sub_commit_cost ELSE centre.sub_snapshot_commit END) AS sub_commit,

         centre.lab_forecast_qnt,
         centre.lab_to_date_qnt,
         centre.lab_unit,
         centre.lab_complete_flag,

         centre.adm_forecast_qnt,
         centre.adm_to_date_qnt,
         centre.adm_unit,
         centre.adm_complete_flag,

         centre.mtl_forecast_qnt,
         centre.mtl_to_date_qnt,
         centre.mtl_unit,
         centre.mtl_complete_flag,

         centre.equ_forecast_qnt,
         centre.equ_to_date_qnt,
         centre.equ_unit,
         centre.equ_complete_flag,

         centre.own_forecast_qnt,
         centre.own_to_date_qnt,
         centre.own_unit,
         centre.own_complete_flag,

         centre.sub_forecast_qnt,
         centre.sub_to_date_qnt,
         centre.sub_unit,
         centre.sub_complete_flag,

         centre.sched_premium_hour,
         centre.spot_premium_hour,
         centre.shut_premium_hour,

         centre.adm_sched_premium_hour,
         centre.adm_spot_premium_hour,
         centre.adm_shut_premium_hour,

         centre.override_forecast_flag
    FROM centre LEFT OUTER JOIN client_po ON centre.job = client_po.job AND centre.client_po = client_po.client_po,
         job,
         area
   WHERE centre.job = job.job AND
         centre.job = area.job AND
         centre.area = area.area AND
         centre.book = :as_book AND
         job.book = :as_book AND
         area.book = :as_book AND
         (centre.file_type = :as_file_type1 OR  
         centre.file_type = :as_file_type2 OR  
         centre.file_type = :as_file_type3) AND  
         centre.job BETWEEN :as_from_job AND :as_to_job AND
         centre.area BETWEEN :as_from_area AND :as_to_area AND
         centre.cost_type != 'G' AND
         ((:as_access_restricted_data = 'N' AND centre.restrict_flag = 'N') OR :as_access_restricted_data = 'Y')
ORDER BY centre.job,
         centre.area,
         centre.centre" arguments=(("as_book", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string),("as_from_area", string),("as_to_area", string),("as_budget", string),("as_snap", string),("as_access_restricted_data", string)) )
