table(column=(type=char(20) updatewhereclause=yes name=centre_client_po dbname="centre.client_po" )
 column=(type=char(40) updatewhereclause=yes name=po_desc dbname="po_desc" )
 column=(type=char(6) updatewhereclause=yes name=job dbname="jc_transaction.job" )
 column=(type=char(5) updatewhereclause=yes name=area dbname="jc_transaction.area" )
 column=(type=char(6) updatewhereclause=yes name=centre dbname="jc_transaction.centre" )
 column=(type=char(50) updatewhereclause=yes name=description dbname="centre.description" )
 column=(type=datetime updatewhereclause=yes name=activity_date dbname="jc_transaction.activity_date" )
 column=(type=decimal(2) updatewhereclause=yes name=hr_amt dbname="jc_transaction.hr_amt" )
 column=(type=decimal(2) updatewhereclause=yes name=sched_premium_hour dbname="jc_transaction.sched_premium_hour" )
 column=(type=decimal(2) updatewhereclause=yes name=spot_premium_hour dbname="jc_transaction.spot_premium_hour" )
 column=(type=decimal(2) updatewhereclause=yes name=shut_premium_hour dbname="jc_transaction.shut_premium_hour" )
 column=(type=decimal(2) updatewhereclause=yes name=lab_amt dbname="jc_transaction.lab_amt" )
 column=(type=char(6) updatewhereclause=yes name=centre_lab_po_item dbname="centre.LAB_PO_ITEM" )
 column=(type=decimal(2) updatewhereclause=yes name=mtl_amt dbname="jc_transaction.mtl_amt" )
 column=(type=char(6) updatewhereclause=yes name=centre_mat_po_item dbname="centre.MAT_PO_ITEM" )
 column=(type=decimal(2) updatewhereclause=yes name=equ_amt dbname="jc_transaction.equ_amt" )
 column=(type=char(6) updatewhereclause=yes name=centre_equ_po_item dbname="centre.EQU_PO_ITEM" )
 column=(type=decimal(2) updatewhereclause=yes name=sub_amt dbname="jc_transaction.sub_amt" )
 column=(type=char(6) updatewhereclause=yes name=centre_sub_po_item dbname="centre.SUB_PO_ITEM" )
 column=(type=decimal(2) updatewhereclause=yes name=total dbname="TOTAL" )
 retrieve="select	centre.client_po,
         (SELECT client_po.description 
            FROM client_po 
           WHERE client_po.job = centre.job
             AND client_po.client_po = centre.client_po) AS po_desc,
			jc_transaction.job,
			jc_transaction.area,
			jc_transaction.centre,
			centre.description,
			jc_transaction.activity_date,
			jc_transaction.hr_amt,
			jc_transaction.sched_premium_hour,
			jc_transaction.spot_premium_hour,
			jc_transaction.shut_premium_hour,
			jc_transaction.lab_amt,
			centre.lab_po_item as LAB_PO_ITEM,			
			jc_transaction.mtl_amt,
         centre.mtl_po_item as MAT_PO_ITEM,
			jc_transaction.equ_amt,
         centre.equ_po_item as EQU_PO_ITEM,			
			jc_transaction.sub_amt,
         centre.sub_po_item as SUB_PO_ITEM,
         (lab_amt + mtl_amt + equ_amt + sub_amt) as TOTAL
	from	jc_transaction,
			centre
	where	jc_transaction.book = :as_company
			and jc_transaction.job between :as_from_job and :as_to_job
			and jc_transaction.area between :as_from_area and :as_to_area
			and (jc_transaction.activity_date  >= :adt_from_date and jc_transaction.activity_date  < DATEADD( day, 1, :adt_to_date ))
			and centre.file_type in ( :as_file_type1, :as_file_type2, :as_file_type3 )
			and centre.book = jc_transaction.book
			and centre.job = jc_transaction.job
			and centre.area = jc_transaction.area
			and centre.centre = jc_transaction.centre
			and centre.restrict_flag = 'N'
			and centre.client_po between :as_from_po and :as_to_po 
" arguments=(("as_company", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string),("as_from_area", string),("as_to_area", string),("as_from_po", string),("as_to_po", string),("adt_from_date", datetime),("adt_to_date", datetime))  sort="job A area A centre A centre_client_po A activity_date A " )
