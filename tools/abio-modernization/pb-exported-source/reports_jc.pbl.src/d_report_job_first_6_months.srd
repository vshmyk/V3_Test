 column=(type=decimal(2) updatewhereclause=yes name=period_1_cost dbname="job.period_1_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=period_2_cost dbname="job.period_2_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=period_3_cost dbname="job.period_3_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=period_4_cost dbname="job.period_4_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=period_5_cost dbname="job.period_5_cost" )
