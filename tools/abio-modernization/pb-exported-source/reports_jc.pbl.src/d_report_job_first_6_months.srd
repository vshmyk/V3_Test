 column=(type=decimal(2) updatewhereclause=yes name=period_8_cost dbname="job.period_8_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=period_9_cost dbname="job.period_9_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=period_10_cost dbname="job.period_10_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=period_11_cost dbname="job.period_11_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=period_12_cost dbname="job.period_12_cost" )
 retrieve="  SELECT job.book,
			job.job,   
         job.description,   
         job.year_open_revenue,   
         job.period_1_revenue,   
         job.period_2_revenue,   
         job.period_3_revenue,   
         job.period_4_revenue,   
         job.period_5_revenue,   
         job.period_6_revenue,   
         job.period_7_revenue,   
         job.period_8_revenue,   
         job.period_9_revenue,   
         job.period_10_revenue,   
         job.period_11_revenue,   
         job.period_12_revenue,   
         job.year_open_cost,   
         job.period_1_cost,   
         job.period_2_cost,   
         job.period_3_cost,   
         job.period_4_cost,   
         job.period_5_cost,   
         job.period_6_cost,   
         job.period_7_cost,   
         job.period_8_cost,   
         job.period_9_cost,   
         job.period_10_cost,   
         job.period_11_cost,   
         job.period_12_cost
    FROM job  
   WHERE job.book = :as_book AND
         (job.file_type = :as_file_type1 OR  
         job.file_type = :as_file_type2 OR  
         job.file_type = :as_file_type3) AND  
         job.job BETWEEN :as_from_job AND :as_to_job    
" update="job" updatewhere=0 updatekeyinplace=no arguments=(("as_book", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string),("as_current_todate", string))  sort="job_sort A " )
