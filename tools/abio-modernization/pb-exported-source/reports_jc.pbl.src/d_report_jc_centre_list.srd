table(column=(type=char(6) updatewhereclause=yes name=job dbname="centre.job" )
 column=(type=char(5) updatewhereclause=yes name=area dbname="centre.area" )
 column=(type=char(6) updatewhereclause=yes name=centre dbname="centre.centre" )
 column=(type=char(50) updatewhereclause=yes name=description dbname="centre.description" )
 column=(type=char(7) updatewhereclause=yes name=cost_type dbname="centre.cost_type" )
 column=(type=char(5) updatewhereclause=yes name=group_area_ceiling dbname="centre.group_area_ceiling" )
 column=(type=char(6) updatewhereclause=yes name=group_centre_ceiling dbname="centre.group_centre_ceiling" )
 column=(type=char(20) updatewhereclause=yes name=client_po dbname="centre.client_po" )
 column=(type=char(1) updatewhereclause=yes name=override_forecast_flag dbname="centre.override_forecast_flag" )
 column=(type=char(35) updatewhereclause=yes name=job_description dbname="job.description" )
 column=(type=char(35) updatewhereclause=yes name=area_description dbname="area.description" )
 column=(type=char(5) updatewhereclause=yes name=dispersion_type dbname="area.dispersion_type" )
 column=(type=char(6) updatewhereclause=yes name=lab_revenue_group dbname="centre.lab_revenue_group" )
 column=(type=char(6) updatewhereclause=yes name=adm_revenue_group dbname="centre.adm_revenue_group" )
 column=(type=char(6) updatewhereclause=yes name=mtl_revenue_group dbname="centre.mtl_revenue_group" )
 column=(type=char(6) updatewhereclause=yes name=equ_revenue_group dbname="centre.equ_revenue_group" )
 column=(type=char(6) updatewhereclause=yes name=own_revenue_group dbname="centre.own_revenue_group" )
 column=(type=char(6) updatewhereclause=yes name=sub_revenue_group dbname="centre.sub_revenue_group" )
 column=(type=char(1) updatewhereclause=yes name=centre_active_flag dbname="centre.active_flag" )
 column=(type=char(10) updatewhereclause=yes name=construction_work_package dbname="centre.construction_work_package" )
 column=(type=char(12) updatewhereclause=yes name=client_work_order dbname="centre.client_work_order" )
 column=(type=datetime updatewhereclause=yes name=centre_client_work_order_expiry_date dbname="centre.client_work_order_expiry_date" )
 column=(type=char(12) updatewhereclause=yes name=client_cost_centre dbname="centre.client_cost_centre" )
 column=(type=char(24) updatewhereclause=yes name=work_breakdown_structure dbname="centre.work_breakdown_structure" )
 column=(type=char(6) updatewhereclause=yes name=lab_po_item dbname="centre.lab_po_item" )
 column=(type=char(6) updatewhereclause=yes name=centre_adm_po_item dbname="centre.adm_po_item" )
 column=(type=char(6) updatewhereclause=yes name=mtl_po_item dbname="centre.mtl_po_item" )
 column=(type=char(6) updatewhereclause=yes name=equ_po_item dbname="centre.equ_po_item" )
 column=(type=char(6) updatewhereclause=yes name=own_po_item dbname="centre.own_po_item" )
 column=(type=char(6) updatewhereclause=yes name=sub_po_item dbname="centre.sub_po_item" )
 column=(type=char(12) updatewhereclause=yes name=centre_lab_client_account dbname="centre.lab_client_account" )
 column=(type=char(12) updatewhereclause=yes name=adm_client_account dbname="centre.adm_client_account" )
 column=(type=char(12) updatewhereclause=yes name=centre_mtl_client_account dbname="centre.mtl_client_account" )
 column=(type=char(12) updatewhereclause=yes name=centre_equ_client_account dbname="centre.equ_client_account" )
 column=(type=char(12) updatewhereclause=yes name=own_client_account dbname="centre.own_client_account" )
 column=(type=char(12) updatewhereclause=yes name=centre_sub_client_account dbname="centre.sub_client_account" )
 column=(type=char(1) updatewhereclause=yes name=application_properties_centre_cost_type_adm_own_flag dbname="application_properties.centre_cost_type_adm_own_flag" )
 column=(type=datetime updatewhereclause=yes name=centre_client_work_order_effective_date dbname="centre.client_work_order_effective_date" )
 column=(type=char(1) updatewhereclause=yes name=centre_restrict_flag dbname="centre.restrict_flag" )
 retrieve="  SELECT centre.job,   
         centre.area,   
         centre.centre,   
         centre.description,   
         centre.cost_type,   
         centre.group_area_ceiling,   
         centre.group_centre_ceiling,   
         centre.client_po,   
			centre.override_forecast_flag,
			job.description,
         area.description,
         area.dispersion_type,
         centre.lab_revenue_group,
         centre.adm_revenue_group,
         centre.mtl_revenue_group,
         centre.equ_revenue_group,
         centre.own_revenue_group,
         centre.sub_revenue_group,
         centre.active_flag, 
			centre.construction_work_package,
			centre.client_work_order, 
			centre.client_work_order_expiry_date, 
			centre.client_cost_centre, 
			centre.work_breakdown_structure,
			centre.lab_po_item, 
			centre.adm_po_item, 
			centre.mtl_po_item, 
			centre.equ_po_item, 
			centre.own_po_item, 
			centre.sub_po_item,
			centre.lab_client_account,
			centre.adm_client_account,
			centre.mtl_client_account,
			centre.equ_client_account,
			centre.own_client_account,
			centre.sub_client_account,
			application_properties.centre_cost_type_adm_own_flag,
			centre.client_work_order_effective_date,
			centre.restrict_flag
    FROM centre,
         job,
         area,
         application_properties

   WHERE centre.job 	= job.job AND 
         centre.job 	= area.job AND
         centre.area = area.area AND
         centre.book = :as_book AND
         job.book 	= :as_book AND
         area.book 	= :as_book AND
			(centre.file_type = :as_file_type1 OR  
         centre.file_type = :as_file_type2 OR 
         centre.file_type = :as_file_type3) AND 
         centre.job BETWEEN :as_from_job AND :as_to_job AND  
         centre.area BETWEEN :as_from_area AND :as_to_area AND  
         centre.centre BETWEEN :as_from_centre AND :as_to_centre AND
         ((:as_active_centres = 'Y' AND centre.active_flag = 'Y') OR
         (:as_active_centres = 'N' AND (centre.active_flag != 'Y' OR centre.active_flag IS NULL)) OR
         :as_active_centres = 'A') AND
         (CharIndex(:as_cost_type1,centre.cost_type) > 0 OR
         CharIndex(:as_cost_type2,centre.cost_type) > 0 OR
         CharIndex(:as_cost_type3,centre.cost_type) > 0 OR
         CharIndex(:as_cost_type4,centre.cost_type) > 0 OR
         CharIndex(:as_cost_type5,centre.cost_type) > 0 OR
         CharIndex(:as_cost_type6,centre.cost_type) > 0 OR
         CharIndex(:as_cost_type7,centre.cost_type) > 0 OR
         CharIndex(:as_cost_type8,centre.cost_type) > 0) AND
			((:as_access_restricted_data = 'Y' AND centre.restrict_flag = 'Y') OR
         (:as_access_restricted_data = 'N' AND (centre.restrict_flag != 'Y' OR centre.restrict_flag IS NULL)) OR
         :as_access_restricted_data = 'A')
ORDER BY centre.job,   
         centre.area,   
         centre.centre
" arguments=(("as_book", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string),("as_from_area", string),("as_to_area", string),("as_from_centre", string),("as_to_centre", string),("as_active_centres", string),("as_cost_type1", string),("as_cost_type2", string),("as_cost_type3", string),("as_cost_type4", string),("as_cost_type5", string),("as_cost_type6", string),("as_cost_type7", string),("as_cost_type8", string),("as_access_restricted_data", string),("as_all_types", string))  sort="job A area A If( IsNumber( centre ), 1, 2 ) A If( IsNumber( centre ), Long( centre ), 0 ) A centre A " )
group(level=1 header.height=64 trailer.height=0 by=("job" ) header.color="536870912" header.transparency="0" header.gradient.color="8421504" header.gradient.transparency="0" header.gradient.angle="0" header.brushmode="0" header.gradient.repetition.mode="0" header.gradient.repetition.count="0" header.gradient.repetition.length="100" header.gradient.focus="0" header.gradient.scale="100" header.gradient.spread="100" trailer.color="536870912" trailer.transparency="0" trailer.gradient.color="8421504" trailer.gradient.transparency="0" trailer.gradient.angle="0" trailer.brushmode="0" trailer.gradient.repetition.mode="0" trailer.gradient.repetition.count="0" trailer.gradient.repetition.length="100" trailer.gradient.focus="0" trailer.gradient.scale="100" trailer.gradient.spread="100" )
