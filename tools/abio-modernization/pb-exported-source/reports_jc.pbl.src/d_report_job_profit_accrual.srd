table(column=(type=char(8) updatewhereclause=yes key=yes name=book dbname="job.book" )
 column=(type=char(6) updatewhereclause=yes key=yes name=job dbname="job.job" )
 column=(type=char(1) updatewhereclause=yes name=fixed_price_flag dbname="job.fixed_price_flag" )
 column=(type=char(35) updatewhereclause=yes name=description dbname="job.description" )
 column=(type=decimal(2) updatewhereclause=yes name=expected_revenue dbname="job.expected_revenue" )
 column=(type=decimal(2) updatewhereclause=yes name=expected_cost dbname="job.expected_cost" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=glrev dbname="glrev" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=glcst dbname="glcst" )
 retrieve="  SELECT job.book,
			job.job,   
			job.fixed_price_flag,   
         job.description,   
         job.expected_revenue,   
         job.expected_cost,   
         job.year_open_revenue + job.period_1_revenue + job.period_2_revenue + job.period_3_revenue + job.period_4_revenue + job.period_5_revenue + job.period_6_revenue + job.period_7_revenue + job.period_8_revenue + job.period_9_revenue + job.period_10_revenue + job.period_11_revenue + job.period_12_revenue AS glrev,   
         job.year_open_cost + job.period_1_cost + job.period_2_cost + job.period_3_cost + job.period_4_cost + job.period_5_cost + job.period_6_cost + job.period_7_cost + job.period_8_cost + job.period_9_cost + job.period_10_cost + job.period_11_cost + job.period_12_cost AS glcst  
    FROM job
   WHERE job.book = :as_book AND
         (job.file_type = :as_file_type1 OR  
         job.file_type = :as_file_type2 OR  
         job.file_type = :as_file_type3) AND  
         job.job BETWEEN :as_from_job AND :as_to_job" update="job" updatewhere=0 updatekeyinplace=no arguments=(("as_book", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string))  sort="job_sort A " )
