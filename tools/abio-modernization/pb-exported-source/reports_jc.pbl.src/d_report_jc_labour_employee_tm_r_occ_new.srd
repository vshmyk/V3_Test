text(band=header alignment="1" text="SITE ALLOW
&& ROTATION" border="0" color="33554432" x="3657" y="204" height="112" width="325" html.valueishtml="0"  name=site_allow_rotation_t visible="1"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="1" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.tip="For employee rates:
Site allowance and Rotation as per the T&M Employee Rate entry screen.

For occupation rates and Cost+:
Site Allowance with markup as per the 'other' specification on T&M Labour Rate Type
and Rotation with markup as per the 'rotation' specification on T&M Labour Rate Type.

* Rotation is travel, mileage, turnaround and taxi & meals from the timesheet

** timesheet values are less GST as per the GST rule associated with the timesheet" tooltip.transparency="0" transparency="0" )
text(band=header alignment="1" text="SAFETY &&
SUBSIST" border="0" color="33554432" x="4000" y="204" height="112" width="261" html.valueishtml="0"  name=safety_subsist_t visible="1"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="1" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.tip="For employee rates:
Meal* & Subsistence* as per the T&M Employee Labour Rate entry screen.
Subsistence includes all hours @ board & travel hourly rate

For occupation rates and cost+:
Regular and Overtime Safety as per T&M Labour Rate Type entry,
Meal Allowance* with markup as per the 'other' specification on T&M Labour Rate Type, and
Subsistence* as per T&M Labour Rate Type entry.

* timesheet values are less GST as specifed by the timesheet's GST rule" tooltip.transparency="0" transparency="0" )
