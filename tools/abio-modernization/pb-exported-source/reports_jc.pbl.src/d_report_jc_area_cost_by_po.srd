table(column=(type=char(20) update=yes updatewhereclause=yes name=client_po dbname="centre.client_po" )
 column=(type=char(40) update=yes updatewhereclause=yes name=po_desc dbname="po_desc" )
 column=(type=char(5) update=yes updatewhereclause=yes name=area dbname="centre.area" )
 column=(type=char(35) updatewhereclause=yes name=area_desc dbname="area.area_desc" )
 column=(type=char(6) update=yes updatewhereclause=yes name=job dbname="centre.job" )
 column=(type=char(6) update=yes updatewhereclause=yes name=centre dbname="centre.centre" )
 column=(type=char(50) update=yes updatewhereclause=yes name=description dbname="centre.description" )
 column=(type=decimal(2) updatewhereclause=yes name=hr dbname="hr" )
 column=(type=decimal(2) updatewhereclause=yes name=lab dbname="lab" )
 column=(type=decimal(2) updatewhereclause=yes name=adm dbname="adm" )
 column=(type=decimal(2) updatewhereclause=yes name=mtl dbname="mtl" )
 column=(type=decimal(2) updatewhereclause=yes name=equ dbname="equ" )
 column=(type=decimal(2) updatewhereclause=yes name=own dbname="own" )
 column=(type=decimal(2) updatewhereclause=yes name=sub dbname="sub" )
 column=(type=char(6) updatewhereclause=yes name=lab_po_item dbname="centre.lab_po_item" )
 column=(type=char(6) updatewhereclause=yes name=adm_po_item dbname="centre.adm_po_item" )
 column=(type=char(6) updatewhereclause=yes name=mtl_po_item dbname="centre.mtl_po_item" )
 column=(type=char(6) updatewhereclause=yes name=equ_po_item dbname="centre.equ_po_item" )
 column=(type=char(6) updatewhereclause=yes name=own_po_item dbname="centre.own_po_item" )
 column=(type=char(6) updatewhereclause=yes name=sub_po_item dbname="centre.sub_po_item" )
 column=(type=decimal(2) updatewhereclause=yes name=gain dbname="gain" )
 column=(type=char(35) updatewhereclause=yes name=area_description dbname="area.description" )
 retrieve="  SELECT centre.client_po,
         (SELECT client_po.description 
            FROM client_po 
           WHERE client_po.job = centre.job
             AND client_po.client_po = centre.client_po) AS po_desc,
         centre.area,
         area.description AS area_desc,
         centre.job,
         centre.centre,
         centre.description,
         (CASE :as_snapshot WHEN 'L' THEN (CASE :as_cost_type WHEN 'A' THEN centre.hr_to_date_cost ELSE centre.hr_forecast_amt END) ELSE (CASE :as_cost_type WHEN 'A' THEN centre.hr_snapshot_cost ELSE centre.hr_snapshot_forecast END) END) AS hr,
         (CASE :as_snapshot WHEN 'L' THEN (CASE :as_cost_type WHEN 'A' THEN centre.lab_to_date_cost ELSE centre.lab_forecast_amt END) ELSE (CASE :as_cost_type WHEN 'A' THEN centre.lab_snapshot_cost ELSE centre.lab_snapshot_forecast END) END) AS lab,
         (CASE :as_snapshot WHEN 'L' THEN (CASE :as_cost_type WHEN 'A' THEN centre.adm_to_date_cost ELSE centre.adm_forecast_amt END) ELSE (CASE :as_cost_type WHEN 'A' THEN centre.adm_snapshot_cost ELSE centre.adm_snapshot_forecast END) END) AS adm,
         (CASE :as_snapshot WHEN 'L' THEN (CASE :as_cost_type WHEN 'A' THEN centre.mtl_to_date_cost ELSE centre.mtl_forecast_amt END) ELSE (CASE :as_cost_type WHEN 'A' THEN centre.mtl_snapshot_cost ELSE centre.mtl_snapshot_forecast END) END) AS mtl,
         (CASE :as_snapshot WHEN 'L' THEN (CASE :as_cost_type WHEN 'A' THEN centre.equ_to_date_cost ELSE centre.equ_forecast_amt END) ELSE (CASE :as_cost_type WHEN 'A' THEN centre.equ_snapshot_cost ELSE centre.equ_snapshot_forecast END) END) AS equ,
         (CASE :as_snapshot WHEN 'L' THEN (CASE :as_cost_type WHEN 'A' THEN centre.own_to_date_cost ELSE centre.own_forecast_amt END) ELSE (CASE :as_cost_type WHEN 'A' THEN centre.own_snapshot_cost ELSE centre.own_snapshot_forecast END) END) AS own,
         (CASE :as_snapshot WHEN 'L' THEN (CASE :as_cost_type WHEN 'A' THEN centre.sub_to_date_cost ELSE centre.sub_forecast_amt END) ELSE (CASE :as_cost_type WHEN 'A' THEN centre.sub_snapshot_cost ELSE centre.sub_snapshot_forecast END) END) AS sub,
         centre.lab_po_item,
         centre.adm_po_item,
         centre.mtl_po_item,
         centre.equ_po_item,
         centre.own_po_item,
         centre.sub_po_item,
         (centre.lab_cur_budget_amt + centre.mtl_cur_budget_amt + centre.equ_cur_budget_amt + centre.sub_cur_budget_amt - (CASE :as_snapshot WHEN 'L' THEN centre.lab_forecast_amt + centre.mtl_forecast_amt + centre.equ_forecast_amt + centre.sub_forecast_amt ELSE centre.lab_snapshot_forecast + centre.mtl_snapshot_forecast + centre.equ_snapshot_forecast + centre.sub_snapshot_forecast END)) AS gain,
			area.description
    FROM centre,
         area
   WHERE centre.job = area.job AND
         centre.area = area.area AND
         centre.book = :as_book AND
         area.book = :as_book AND
         (centre.file_type = :as_file_type1 OR  
         centre.file_type = :as_file_type2 OR  
         centre.file_type = :as_file_type3) AND  
         ((:as_access_restricted_data = 'N' AND centre.restrict_flag = 'N') OR :as_access_restricted_data = 'Y') AND
         centre.job BETWEEN :as_from_job AND :as_to_job AND
         centre.area BETWEEN :as_from_area AND :as_to_area AND
         Len(centre.client_po) > 0 AND 
         Len(centre.client_po) > 0 AND 
			((( CASE :as_snapshot WHEN 'L' THEN (CASE :as_cost_type WHEN 'A' THEN centre.lab_to_date_cost ELSE centre.lab_forecast_amt END) ELSE (CASE :as_cost_type WHEN 'A' THEN centre.lab_snapshot_cost ELSE centre.lab_snapshot_forecast END) END) <> 0 OR 
			( CASE :as_snapshot WHEN 'L' THEN (CASE :as_cost_type WHEN 'A' THEN centre.mtl_to_date_cost ELSE centre.mtl_forecast_amt END) ELSE (CASE :as_cost_type WHEN 'A' THEN centre.mtl_snapshot_cost ELSE centre.mtl_snapshot_forecast END) END) <> 0 OR 
			( CASE :as_snapshot WHEN 'L' THEN (CASE :as_cost_type WHEN 'A' THEN centre.adm_to_date_cost ELSE centre.adm_forecast_amt END) ELSE (CASE :as_cost_type WHEN 'A' THEN centre.adm_snapshot_cost ELSE centre.adm_snapshot_forecast END) END) <> 0 OR 
			( CASE :as_snapshot WHEN 'L' THEN (CASE :as_cost_type WHEN 'A' THEN centre.equ_to_date_cost ELSE centre.equ_forecast_amt END) ELSE (CASE :as_cost_type WHEN 'A' THEN centre.equ_snapshot_cost ELSE centre.equ_snapshot_forecast END) END) <> 0 OR 
			( CASE :as_snapshot WHEN 'L' THEN (CASE :as_cost_type WHEN 'A' THEN centre.own_to_date_cost ELSE centre.own_forecast_amt END) ELSE (CASE :as_cost_type WHEN 'A' THEN centre.own_snapshot_cost ELSE centre.own_snapshot_forecast END) END) <> 0 OR
			( CASE :as_snapshot WHEN 'L' THEN (CASE :as_cost_type WHEN 'A' THEN centre.sub_to_date_cost ELSE centre.sub_forecast_amt END) ELSE (CASE :as_cost_type WHEN 'A' THEN centre.sub_snapshot_cost ELSE centre.sub_snapshot_forecast END) END) <> 0) OR 
			 :as_zero_activity = 'Y')

" arguments=(("as_book", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string),("as_from_area", string),("as_to_area", string),("as_cost_type", string),("as_snapshot", string),("as_access_restricted_data", string),("as_zero_activity", string))  sort="client_po A job_sort A area_sort A centre_sort A " )
