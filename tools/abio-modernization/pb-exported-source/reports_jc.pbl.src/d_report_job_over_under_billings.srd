table(column=(type=char(8) updatewhereclause=yes name=job_book dbname="job.book" )
 column=(type=char(6) updatewhereclause=yes name=job dbname="job.job" )
 column=(type=char(35) updatewhereclause=yes name=description dbname="job.description" )
 column=(type=decimal(2) updatewhereclause=yes name=contract_amount dbname="job.contract_amount" )
 column=(type=decimal(2) updatewhereclause=yes name=original_budget dbname="job.original_budget" )
 column=(type=decimal(2) updatewhereclause=yes name=current_budget dbname="job.current_budget" )
 column=(type=decimal(2) updatewhereclause=yes name=to_date_cost dbname="job.to_date_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=to_date_revenue dbname="job.to_date_revenue" )
 column=(type=decimal(2) updatewhereclause=yes name=to_date_payment dbname="job.to_date_payment" )
 column=(type=decimal(2) updatewhereclause=yes name=commitment dbname="job.commitment" )
 column=(type=decimal(2) updatewhereclause=yes name=forecast dbname="forecast" )
 retrieve="  SELECT job.book,
			job.job,   
         job.description,   
         job.contract_amount,   
         job.original_budget,   
         job.current_budget,   
         job.to_date_cost,   
         job.to_date_revenue,   
         job.to_date_payment,   
         job.commitment,   
         sum(lab_forecast_amt+mtl_forecast_amt+equ_forecast_amt+sub_forecast_amt) as forecast  
    FROM job,   
         centre  
   WHERE job.job = centre.job AND
         job.book = :as_book AND
         centre.book = :as_book AND
         (job.file_type = :as_file_type1 OR  
         job.file_type = :as_file_type2 OR  
         job.file_type = :as_file_type3) AND  
         job.job BETWEEN :as_from_job AND :as_to_job
GROUP BY job.book,
			job.job,   
         job.description,   
         job.contract_amount,   
         job.original_budget,   
         job.current_budget,   
         job.to_date_cost,   
         job.to_date_revenue,   
         job.to_date_payment,   
         job.commitment   
" arguments=(("as_book", string),("as_file_type1", string),("as_file_type2", string),("as_file_type3", string),("as_from_job", string),("as_to_job", string))  sort="job_sort A " )
