table(column=(type=char(59) updatewhereclause=yes name=centre dbname="centre" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=budget_amt dbname="budget_amt" )
 column=(type=decimal(2) updatewhereclause=yes name=snapshot_cost dbname="snapshot_cost" )
 column=(type=decimal(2) updatewhereclause=yes name=snapshot_forecast_amt dbname="snapshot_forecast_amt" )
 retrieve="SELECT centre.centre + ' - ' + centre.description                AS centre,
       Round(centre_snapshot_history.lab_cur_budget_amt
             + centre_snapshot_history.mtl_cur_budget_amt
             + centre_snapshot_history.equ_cur_budget_amt
             + centre_snapshot_history.sub_cur_budget_amt, 2)    AS budget_amt,
       Round(centre_snapshot_history.lab_snapshot_cost
             + centre_snapshot_history.lab_snapshot_commit
             + centre_snapshot_history.mtl_snapshot_cost
             + centre_snapshot_history.mtl_snapshot_commit
             + centre_snapshot_history.equ_snapshot_cost
             + centre_snapshot_history.equ_snapshot_commit
             + centre_snapshot_history.sub_snapshot_cost
             + centre_snapshot_history.sub_snapshot_commit, 2)   AS snapshot_cost,
       Round(centre_snapshot_history.lab_snapshot_forecast
             + centre_snapshot_history.mtl_snapshot_forecast
             + centre_snapshot_history.equ_snapshot_forecast
             + centre_snapshot_history.sub_snapshot_forecast, 2) AS snapshot_forecast_amt
FROM   centre_snapshot_history
       LEFT OUTER JOIN centre
                    ON centre.book = centre_snapshot_history.book
                       AND centre.job = centre_snapshot_history.job
                       AND centre.area = centre_snapshot_history.area
                       AND centre.centre = centre_snapshot_history.centre
WHERE  centre_snapshot_history.book = :as_book
       AND centre_snapshot_history.job = :as_job
       AND centre_snapshot_history.area = :as_area
       AND centre_snapshot_history.snapshot_date = :adt_snap
       AND ( centre_snapshot_history.lab_snapshot_cost
             + centre_snapshot_history.lab_snapshot_commit
             + centre_snapshot_history.mtl_snapshot_cost
             + centre_snapshot_history.mtl_snapshot_commit
             + centre_snapshot_history.equ_snapshot_cost
             + centre_snapshot_history.equ_snapshot_commit
             + centre_snapshot_history.sub_snapshot_cost
             + centre_snapshot_history.sub_snapshot_commit <> 0 ) " arguments=(("as_book", string),("as_job", string),("as_area", string),("adt_snap", datetime)) )
