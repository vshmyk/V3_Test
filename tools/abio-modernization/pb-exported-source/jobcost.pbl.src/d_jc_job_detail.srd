 retrieve="  SELECT 'I' as action,   
         job.book,   
         job.job,   
         job.description,   
         job.superintendent,   
         job.address_1,   
         job.address_2,   
         job.city,   
         job.province,   
         job.country,   
         job.postal,   
         job.phone,   
         job.fax,   
         job.parent_job,   
         job.client,   
         job.client_job,   
         job.client_po,   
         job.po_address_flag,   
         job.shipping_msg_type,   
         job.start_date,   
         job.complete_date,   
         job.snapshot_date,   
         job.last_update,   
         job.shutdown_start_date,   
         job.shutdown_end_date,   
         job.wcb_class,   
         job.gst_rule,   
         job.reg_hours_per_day,   
         job.invoice_dispersion_flag,   
         job.freeze_budget_flag,   
         job.active_flag,   
         job.file_type,   
         job.equipment_rate_type,   
         job.labour_rate_type,   
         job.labour_markup_percent,   
         job.material_markup_percent,   
         job.include_staff_hrs_flag,   
         job.smtc_per_hour,   
         job.smtc_per_hour_label,   
         job.equipment_revenue_area,   
         job.equipment_revenue_centre,   
         job.add_user_id,   
         job.add_datetime,   
         job.dashboard_group,   
         job.division,   
         job.contract_book,   
         job.memo,   
         job.ap_last_job_po_no,   
         job.client_po_item,   
         job.contract_amount,   
         job.original_budget,   
         job.current_budget,   
         job.to_date_cost,   
         job.to_date_revenue,   
         job.to_date_payment,   
         job.commitment,   
         job.expected_cost,   
         job.expected_revenue,   
         job.year_open_cost,   
         job.period_1_cost,   
         job.period_2_cost,   
         job.period_3_cost,   
         job.period_4_cost,   
         job.period_5_cost,   
         job.period_6_cost,   
         job.period_7_cost,   
         job.period_8_cost,   
         job.period_9_cost,   
         job.period_10_cost,   
         job.period_11_cost,   
         job.period_12_cost,   
         job.year_open_revenue,   
         job.period_1_revenue,   
         job.period_2_revenue,   
         job.period_3_revenue,   
         job.period_4_revenue,   
         job.period_5_revenue,   
         job.period_6_revenue,   
         job.period_7_revenue,   
         job.period_8_revenue,   
         job.period_9_revenue,   
         job.period_10_revenue,   
         job.period_11_revenue,   
         job.period_12_revenue,   
         job.last_timesheet,   
         job.timesheet_sign_line,   
         job.equipment_time_entry_sheet_approver_style,   
         job.concurrent_crew_memberships_flag,   
         job.timesheet_prefix,   
         '' cf_book_standard_flag,   
         0 cf_dashboard_group_count,   
         job.project_control_email_address,   
         job.region,   
         job.job_type,   
         job.site_contact,   
         job.admin_fee_percent,   
         job.fixed_price_flag,
         case admin_fee_percent when 0.0 then 'N' ELSE 'Y' end as admin_fee_flag,
         job.timesheet_message,
         job.hbk_percent,
         job.labour_surcharge_label,
         job.labour_surcharge_percent,
         job.trade_union_group
    FROM job   
" update="job" updatewhere=0 updatekeyinplace=yes )
