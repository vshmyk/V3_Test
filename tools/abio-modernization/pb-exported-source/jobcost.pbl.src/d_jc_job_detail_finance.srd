 retrieve="  SELECT 'I' as action,   
					~"job~".~"book~",   
					~"job~".~"job~",   
		
					~"job~".~"contract_amount~",   
					~"job~".~"original_budget~",   
					~"job~".~"current_budget~",   
					~"job~".~"to_date_cost~",   
					~"job~".~"to_date_revenue~",   
					~"job~".~"to_date_payment~",   
					~"job~".~"commitment~",   
					~"job~".~"expected_cost~",   
					~"job~".~"expected_revenue~",   
					~"job~".~"year_open_cost~",   
					~"job~".~"period_1_cost~",   
					~"job~".~"period_2_cost~",   
					~"job~".~"period_3_cost~",   
					~"job~".~"period_4_cost~",   
					~"job~".~"period_5_cost~",   
					~"job~".~"period_6_cost~",   
					~"job~".~"period_7_cost~",   
					~"job~".~"period_8_cost~",   
					~"job~".~"period_9_cost~",   
					~"job~".~"period_10_cost~",   
					~"job~".~"period_11_cost~",   
					~"job~".~"period_12_cost~",   
					~"job~".~"year_open_revenue~",   
					~"job~".~"period_1_revenue~",   
					~"job~".~"period_2_revenue~",   
					~"job~".~"period_3_revenue~",   
					~"job~".~"period_4_revenue~",   
					~"job~".~"period_5_revenue~",   
					~"job~".~"period_6_revenue~",   
					~"job~".~"period_7_revenue~",   
					~"job~".~"period_8_revenue~",   
					~"job~".~"period_9_revenue~",   
					~"job~".~"period_10_revenue~",   
					~"job~".~"period_11_revenue~",   
					~"job~".~"period_12_revenue~",
               '      ' as company_gl_year_begin,
         CAST(0.00 AS NUMERIC(15,2)) AS cc_cur_budget_amt,
         CAST(0.00 AS NUMERIC(15,2)) AS cc_forecast_amt,
         'J' ~"skin_type~"
			 FROM ~"job~"
" update="job" updatewhere=0 updatekeyinplace=no )
