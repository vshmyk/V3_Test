 retrieve="  SELECT '' as action, 
			location_id,    
         job,   
         display_order,   
         address_1,   
         address_2,   
         city,   
         province,   
         postal,   
         contact,   
         contact_phone,   
         active_flag,   
         add_user_id,   
         add_datetime,
			country  
    FROM job_shipping_info   
" update="job_shipping_info" updatewhere=1 updatekeyinplace=yes )
