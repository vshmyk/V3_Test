 retrieve="  SELECT 'I' as action,   
         job_document.book,   
         job_document.job,   
         job_document.document_item,   
         job_document.segment_no,   
         job_document.description,   
         job_document.pdf_flag  ,   
         job_document.received_datetime,   
         job_document.add_user_id,   
         job_document.add_datetime
    FROM job_document   
" update="job_document" updatewhere=1 updatekeyinplace=no )
