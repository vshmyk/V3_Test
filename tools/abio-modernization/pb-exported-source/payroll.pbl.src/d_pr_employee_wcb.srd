table(column=(type=char(1) updatewhereclause=yes name=action dbname="action" values="C	C/D	D/I	I/" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=book dbname="employee_wcb.book" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=employee dbname="employee_wcb.employee" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=wcb_class dbname="employee_wcb.wcb_class" )
 column=(type=char(25) updatewhereclause=yes name=wcb_description dbname="wcb_class.wcb_description" )
 column=(type=char(4) update=yes updatewhereclause=yes key=yes name=tax_year dbname="employee_wcb.tax_year" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=wcb_assessable_earn dbname="employee_wcb.wcb_assessable_earn" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=wcb_remittance dbname="employee_wcb.wcb_remittance" )
 retrieve="  SELECT 'I' as action,
			 employee_wcb.book,   
          employee,
          employee_wcb.wcb_class as wcb_class,
			 wcb_class.description as wcb_description,   
          tax_year,   
          wcb_assessable_earn,   
          wcb_remittance  
    FROM employee_wcb, 
			wcb_class  
   WHERE employee_wcb.wcb_class = wcb_class.wcb_class 


" update="employee_wcb" updatewhere=0 updatekeyinplace=yes )
