 column=(type=decimal(2) update=yes updatewhereclause=yes name=reg_rate dbname="timesheet_premium.reg_rate" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=tah_rate dbname="timesheet_premium.tah_rate" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=ovr_rate dbname="timesheet_premium.ovr_rate" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=reg_earn dbname="timesheet_premium.reg_earn" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=tah_earn dbname="timesheet_premium.tah_earn" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=ovr_earn dbname="timesheet_premium.ovr_earn" )
 column=(type=char(8) update=yes updatewhereclause=yes name=add_user_id dbname="timesheet_premium.add_user_id" )
 column=(type=datetime update=yes updatewhereclause=yes name=add_datetime dbname="timesheet_premium.add_datetime" )
 retrieve="  SELECT 'I' as action,
         ~"timesheet_premium~".~"book~",   
         ~"timesheet_premium~".~"employee~",   
         ~"timesheet_premium~".~"work_date~",   
         ~"timesheet_premium~".~"timesheet_item~",   
         ~"timesheet_premium~".~"premium_type~",   
         ~"premium_type~".~"description~",   
         ~"premium_type~".~"timesheet_override_flag~",   
         ~"timesheet~".~"transact_flag~",   
         ~"timesheet~".~"cheque_no~",   
         ~"timesheet_premium~".~"reg_rate~",   
         ~"timesheet_premium~".~"tah_rate~",   
         ~"timesheet_premium~".~"ovr_rate~",   
         ~"timesheet_premium~".~"reg_earn~",   
         ~"timesheet_premium~".~"tah_earn~",   
         ~"timesheet_premium~".~"ovr_earn~",   
         ~"timesheet_premium~".~"add_user_id~",   
         ~"timesheet_premium~".~"add_datetime~"  
    FROM ~"timesheet_premium~",   
         ~"premium_type~",
         ~"timesheet~" 
   WHERE ~"premium_type~".~"premium_type~" = ~"timesheet_premium~".~"premium_type~"
     AND ~"timesheet_premium~".~"book~" = ~"timesheet~".~"book~"
     AND ~"timesheet_premium~".~"employee~" = ~"timesheet~".~"employee~"
     AND ~"timesheet_premium~".~"work_date~" = ~"timesheet~".~"work_date~"
     AND ~"timesheet_premium~".~"timesheet_item~" = ~"timesheet~".~"timesheet_item~"
" update="timesheet_premium" updatewhere=0 updatekeyinplace=no )
