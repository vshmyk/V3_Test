table(column=(type=char(1) updatewhereclause=yes name=action dbname="action" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=book dbname="timesheet_premium.book" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=employee dbname="timesheet_premium.employee" )
