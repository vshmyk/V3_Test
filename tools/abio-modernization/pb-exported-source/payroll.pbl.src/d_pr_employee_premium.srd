table(column=(type=char(1) updatewhereclause=yes name=action dbname="action" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=book dbname="employee_premium.book" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=employee dbname="employee_premium.employee" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=premium_type dbname="employee_premium.premium_type" )
 column=(type=datetime update=yes updatewhereclause=yes key=yes name=effective_date dbname="employee_premium.effective_date" )
 column=(type=datetime update=yes updatewhereclause=yes name=expiry_date dbname="employee_premium.expiry_date" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=reg_rate dbname="employee_premium.reg_rate" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=tah_rate dbname="employee_premium.tah_rate" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=ovr_rate dbname="employee_premium.ovr_rate" )
 column=(type=char(8) update=yes updatewhereclause=yes name=add_user_id dbname="employee_premium.add_user_id" )
 column=(type=datetime update=yes updatewhereclause=yes name=add_datetime dbname="employee_premium.add_datetime" )
 column=(type=decimal(1) updatewhereclause=yes name=tah_multiplier dbname="trade_union.tah_multiplier" )
 column=(type=decimal(1) updatewhereclause=yes name=ovr_multiplier dbname="trade_union.ovr_multiplier" )
 column=(type=char(1) updatewhereclause=yes name=overtime_hour_flag dbname="premium_type.overtime_hour_flag" )
 column=(type=char(1) updatewhereclause=yes name=overtime_multiplier_flag dbname="premium_type.overtime_multiplier_flag" )
 column=(type=decimal(2) updatewhereclause=yes name=min_hour_rate dbname="min_hour_rate" )
 column=(type=decimal(2) updatewhereclause=yes name=max_hour_rate dbname="max_hour_rate" )
 column=(type=char(5) updatewhereclause=yes name=trade_union dbname="employee.trade_union" )
 retrieve="  SELECT 'I' action,   
         employee_premium.book,   
         employee_premium.employee,   
         employee_premium.premium_type,   
         employee_premium.effective_date,   
         employee_premium.expiry_date,   
         employee_premium.reg_rate,   
         employee_premium.tah_rate,   
         employee_premium.ovr_rate,   
         employee_premium.add_user_id,   
         employee_premium.add_datetime,   
         trade_union.tah_multiplier,   
         trade_union.ovr_multiplier,   
         premium_type.overtime_hour_flag,   
         premium_type.overtime_multiplier_flag,   
			0.00 min_hour_rate,  
			0.00 max_hour_rate,   
         employee.trade_union
    FROM employee_premium,   
         premium_type,   
         employee,   
         trade_union  
   WHERE ( employee_premium.premium_type = premium_type.premium_type ) and  
         ( employee_premium.book = employee.book ) and  
         ( employee_premium.employee = employee.employee ) and  
         ( employee.book = trade_union.book ) and  
         ( employee.trade_union = trade_union.trade_union )    
" update="employee_premium" updatewhere=0 updatekeyinplace=no )
