table(column=(type=char(8) updatewhereclause=yes name=timesheet_premium_premium_type dbname="timesheet_premium.premium_type" )
 column=(type=char(25) updatewhereclause=yes name=premium_type_description dbname="premium_type.description" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_premium_reg_earn dbname="timesheet_premium.reg_earn" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_premium_tah_earn dbname="timesheet_premium.tah_earn" )
 column=(type=decimal(2) updatewhereclause=yes name=timesheet_premium_ovr_earn dbname="timesheet_premium.ovr_earn" )
 column=(type=decimal(2) updatewhereclause=yes name=total_earn dbname="total_earn" )
 retrieve="  SELECT ~"timesheet_premium~".~"premium_type~",   
         ~"premium_type~".~"description~",   
         timesheet_premium.reg_earn,   /* for the export */
         timesheet_premium.tah_earn,   /* for the export */   
         timesheet_premium.ovr_earn,   /* for the export */
         ~"timesheet_premium~".~"reg_earn~" + ~"timesheet_premium~".~"tah_earn~" + ~"timesheet_premium~".~"ovr_earn~" as total_earn
    FROM ~"timesheet_premium~",   
         ~"premium_type~"
   WHERE ~"premium_type~".~"premium_type~" = ~"timesheet_premium~".~"premium_type~"
     AND ~"timesheet_premium~".~"book~" = :as_book
     AND ~"timesheet_premium~".~"employee~" = :al_employee
     AND ~"timesheet_premium~".~"work_date~" = :adt_work
     AND ~"timesheet_premium~".~"timesheet_item~" = :ai_item
" arguments=(("as_book", string),("al_employee", number),("adt_work", datetime),("ai_item", number)) )
