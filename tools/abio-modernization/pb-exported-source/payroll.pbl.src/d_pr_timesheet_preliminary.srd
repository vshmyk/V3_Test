 retrieve="SELECT 'I'                     AS action,
       'N'                     AS selected,
       'N'                     AS division_editable,
       dbo.timesheet.book,
       dbo.timesheet.employee,
       dbo.timesheet.work_date,
       dbo.timesheet.timesheet_item,
       dbo.timesheet.job,
       dbo.timesheet.area,
       dbo.timesheet.work_order,
       dbo.timesheet.centre,
       dbo.timesheet.gl_account,
       dbo.timesheet.division,
       dbo.timesheet.trade_union,
       dbo.timesheet.occupation,
       dbo.employee.occupation AS employee_occupation,
       dbo.timesheet.wcb_class,
       dbo.timesheet.gst_rule,
       dbo.timesheet.shift,
       dbo.timesheet.timesheet_status,
       dbo.timesheet.pr_yyyymm,
       dbo.timesheet.reg_hour,
       dbo.timesheet.tah_hour,
       dbo.timesheet.ovr_hour,
       dbo.timesheet.travel_hour,
       dbo.timesheet.loa_hour,
       dbo.timesheet.mileage_hour,
       dbo.timesheet.reg_rate,
       dbo.timesheet.tah_rate,
       dbo.timesheet.ovr_rate,
       dbo.timesheet.loa_rate,
       dbo.timesheet.mileage_rate,
       dbo.timesheet.reg_earn,
       dbo.timesheet.tah_earn,
       dbo.timesheet.ovr_earn,
       dbo.timesheet.travel_earn,
       dbo.timesheet.loa,
       dbo.timesheet.mileage,
       dbo.timesheet.turnaround,
       dbo.timesheet.taxi,
       dbo.timesheet.meal,
       dbo.timesheet.vehicle_allowance_paid,
       dbo.timesheet.other_taxable_pay,
       dbo.timesheet.add_user_id,
       dbo.timesheet.add_datetime,
       dbo.timesheet.total,
       dbo.timesheet.travel_rate,
       dbo.timesheet.file_type,
       dbo.timesheet.memo,
       dbo.timesheet.client_name,
       dbo.timesheet.field_timesheet_item,
       job.timesheet_message,
       job.description + ' ' + job.city + ' ' + job.province as job_description
FROM   dbo.timesheet
       LEFT OUTER JOIN employee
                    ON employee.book = timesheet.book
                       AND employee.employee = timesheet.employee
       LEFT OUTER JOIN job
                    ON timesheet.book = job.book
                       AND timesheet.job = job.job " update="dbo.timesheet" updatewhere=0 updatekeyinplace=no  sort="book A employee A work_date A timesheet_item A " )
