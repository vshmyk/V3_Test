table(column=(type=char(8) updatewhereclause=yes name=book dbname="book" )
 column=(type=long updatewhereclause=yes name=cheque_no dbname="cheque_no" )
 column=(type=long updatewhereclause=yes name=employee dbname="employee" )
 column=(type=char(25) updatewhereclause=yes name=name dbname="name" )
 column=(type=char(1) updatewhereclause=yes name=employment_type dbname="employment_type" )
 column=(type=datetime updatewhereclause=yes name=issue_date dbname="issue_date" )
 column=(type=char(2) updatewhereclause=yes name=tax_province dbname="tax_province" )
 column=(type=char(1) updatewhereclause=yes name=transact_flag dbname="transact_flag" )
 column=(type=long updatewhereclause=yes name=eft_batch dbname="eft_batch" )
 column=(type=decimal(2) updatewhereclause=yes name=net_pay dbname="net_pay" )
 column=(type=char(1) updatewhereclause=yes name=cheque_status dbname="cheque_status" )
 column=(type=char(8) updatewhereclause=yes name=form_no dbname="form_no" )
 column=(type=long updatewhereclause=yes name=void_cheque_no dbname="void_cheque_no" )
 column=(type=char(6) updatewhereclause=yes name=pr_yyyymm dbname="pr_yyyymm" )
 column=(type=char(1) updatewhereclause=yes name=file_type dbname="file_type" )
 column=(type=char(1) updatewhereclause=yes name=pr_cheque_restrict_flag dbname="restrict_flag" )
 column=(type=char(5) updatewhereclause=yes name=pr_cheque_trade_union dbname="trade_union" )
 column=(type=char(1) updatewhereclause=yes name=multi_flag dbname="multi_flag" )
 column=(type=char(8000) updatewhereclause=yes name=premium dbname="premium" )
 column=(type=long updatewhereclause=yes name=rollover_bit dbname="rollover_bit" )
 retrieve="SELECT TOP 1000 book, 
		 cheque_no,
       employee,
		 name,
		 employment_type,
		 issue_date,
		 tax_province,
		 transact_flag,
		 eft_batch,
		 net_pay,
		 cheque_status,
		 form_no,
       void_cheque_no,
		 pr_yyyymm,
		 file_type,
		 restrict_flag,
		 trade_union,
		 (CASE IsNull(trade_union_count, 0) WHEN 0 THEN '' WHEN 1 THEN ''  WHEN 2 THEN '' ELSE 'Y' END) as multi_flag,
		 premium, CONVERT(INT,0) AS rollover_bit
  FROM (SELECT book, 
					pr_cheque.cheque_no,   
					pr_cheque.employee,   
					person.name as name,
					pr_cheque.employment_type,   
					pr_cheque.issue_date,   
					pr_cheque.tax_province,   
					pr_cheque.transact_flag,   
					pr_cheque.eft_batch,   
					pr_cheque.net_pay,   
					pr_cheque.cheque_status,   
					pr_cheque.form_no,   
					pr_cheque.void_cheque_no,   
					pr_cheque.pr_yyyymm,   
					pr_cheque.file_type,   
					pr_cheque.restrict_flag,   
					pr_cheque.trade_union,
					dbo.uf_pr_cheque_premiums(book, pr_cheque.cheque_no) premium,
					dbo.uf_pr_cheque_union_count(book, pr_cheque.cheque_no) as trade_union_count 
			 FROM pr_cheque, person   
			WHERE pr_cheque.employee = person.employee ) pr_cheque"  sort="cheque_no A " )
