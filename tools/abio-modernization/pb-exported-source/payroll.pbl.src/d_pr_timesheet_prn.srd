 retrieve="  SELECT '            ' as  action,
         timesheet.employee,
         timesheet.work_date,   
         timesheet.timesheet_item,   
         '            ' as  hold_work_date,   
         timesheet.job,   
         timesheet.area,   
         timesheet.centre,   
         timesheet.equipment,   
         timesheet.gl_account,   
         timesheet.division,
         timesheet.trade_union,   
         timesheet.occupation,   
         timesheet.cheque_no,   
         timesheet.gst_rule,   
         timesheet.shift,   
         timesheet.memo,   
         timesheet.pr_yyyymm,   
         timesheet.transact_flag,   
         timesheet.reg_hour,   
         timesheet.tah_hour,   
         timesheet.ovr_hour,   
         timesheet.travel_hour,   
         timesheet.loa_hour,   
         timesheet.mileage_hour,   
         timesheet.reg_rate,   
         timesheet.tah_rate,   
         timesheet.ovr_rate,   
         timesheet.loa_rate,   
         timesheet.mileage_rate,   
         timesheet.reg_earn,   
         timesheet.tah_earn,   
         timesheet.ovr_earn,   
         timesheet.travel_earn,   
         timesheet.loa,   
         timesheet.mileage,   
         timesheet.turnaround,   
         timesheet.site_allowance,   
         timesheet.taxi,   
         timesheet.meal,   
         timesheet.retro,   
         timesheet.other_taxable_pay,   
         timesheet.total,   
         timesheet.fringe,   
         timesheet.gst_amount,   
         timesheet.wcb_class,   
         timesheet.transact_datetime,   
         timesheet.employment_type,   
         timesheet.restrict_flag,   
         timesheet.file_type,
         timesheet.book,
         '            ' as  cc_reg_hour_total,
         '            ' as  cc_tah_hour_total,
         '            ' as  cc_ovr_hour_total,
         '            ' as  cc_travel_hour_total,
         '            ' as  cc_loa_hour_total,
         '            ' as  cc_mileage_hour_total,
         '            ' as  cc_reg_earn_total,
         '            ' as  cc_tah_earn_total,
         '            ' as  cc_ovr_earn_total,
         '            ' as  cc_travel_earn_total,
         '            ' as  cc_loa_total,
         '            ' as  cc_mileage_total,
         '            ' as  cc_turnaround_total,
         '            ' as  cc_meal_total,
         '            ' as  cc_taxi_total,
         '            ' as  cc_retro_total,
         '            ' as  cc_vehicle_allowance_paid_total,
         '            ' as  cc_other_taxable_pay_total,
         '            ' as  cc_total_total,
         '            ' as  cc_fringe_total,
         '            ' as  cc_site_allowance_total,
         '            ' as  cc_gst_amount_total,
         '            ' as  cc_pay_in_lieu_of_notice_total,
			timesheet.add_user_id,
         timesheet.add_datetime,
         timesheet.client_approver,
         timesheet.timesheet_status,
         timesheet.vehicle_allowance_paid,
         timesheet.pay_in_lieu_of_notice,
         timesheet.tah_spot_flag,
         timesheet.ovr_spot_flag,
         timesheet_premium.premium_type,   
         timesheet_premium.reg_earn,   
         timesheet_premium.tah_earn,   
         timesheet_premium.ovr_earn,
		   premium_type.description as premium_description,
			job.labour_rate_type,
         timesheet.retention_earn,
         timesheet.recruitment_cost,
         timesheet.crew,
         timesheet.ticket_no,
         job.timesheet_message
    FROM timesheet 
			LEFT OUTER JOIN job 
					ON timesheet.book = job.book AND timesheet.job = job.job
			LEFT OUTER JOIN timesheet_premium 
					ON timesheet.book = timesheet_premium.book 
					AND timesheet.employee = timesheet_premium.employee 
					AND timesheet.work_date = timesheet_premium.work_date 
					AND timesheet.timesheet_item = timesheet_premium.timesheet_item
			LEFT OUTER JOIN premium_type 
					ON timesheet_premium.premium_type = premium_type.premium_type 
				
   WHERE timesheet.book = :as_book
     AND ( timesheet.employee = :ai_employee ) AND  
         ( timesheet.work_date = :adt_work ) AND  
         ( timesheet.timesheet_item = :ai_item )   
            
" arguments=(("as_book", string),("ai_employee", number),("adt_work", datetime),("ai_item", number)) )
