table(column=(type=decimal(2) updatewhereclause=yes identity=yes name=adv dbname="adv" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=earnings dbname="earnings" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=vacation_owed dbname="vacation_owed" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=statutory_owed dbname="statutory_owed" )
 column=(type=decimal(3) updatewhereclause=yes identity=yes name=cpp dbname="cpp" )
 column=(type=decimal(3) updatewhereclause=yes identity=yes name=ei dbname="ei" )
 column=(type=decimal(3) updatewhereclause=yes name=qpip dbname="qpip" )
 column=(type=decimal(3) updatewhereclause=yes identity=yes name=income_tax dbname="income_tax" )
 column=(type=decimal(3) updatewhereclause=yes identity=yes name=insurance dbname="insurance" )
 column=(type=decimal(3) updatewhereclause=yes identity=yes name=training dbname="training" )
 column=(type=decimal(3) updatewhereclause=yes identity=yes name=recruitment dbname="recruitment" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=personal_safety dbname="personal_safety" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=group_safety dbname="group_safety" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=production_bonus dbname="production_bonus" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=staff_safety dbname="staff_safety" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=smtc dbname="smtc" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=incentive dbname="incentive" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=retention dbname="retention" )
 column=(type=decimal(3) updatewhereclause=yes identity=yes name=charity dbname="charity" )
 column=(type=decimal(3) updatewhereclause=yes identity=yes name=security_deposit dbname="security_deposit" )
 column=(type=decimal(3) updatewhereclause=yes identity=yes name=province_education_tax dbname="province_education_tax" )
 column=(type=decimal(3) updatewhereclause=yes identity=yes name=province_payroll_tax dbname="province_payroll_tax" )
 column=(type=decimal(2) updatewhereclause=yes identity=yes name=fringe dbname="fringe" )
 retrieve="  SELECT sum(pr_cheque.advance_repay) as adv,   
         
         sum(pr_cheque.reg_earn  
				 + pr_cheque.tah_earn
 				 + pr_cheque.ovr_earn 
				 + pr_cheque.travel_earn 
				 + pr_cheque.taxable_loa  
				 + pr_cheque.taxable_mileage  
				 + pr_cheque.other_taxable_pay  
				 + pr_cheque.vehicle_allowance_paid  
				 + pr_cheque.retro  
				 + pr_cheque.pay_in_lieu_of_notice  
				 + pr_cheque.turnaround  
				 + pr_cheque.taxi  
				 + pr_cheque.meal  
				 + pr_cheque.nontaxable_loa  
				 + pr_cheque.nontaxable_mileage  
				 + pr_cheque.taxable_site_allow  
				 + pr_cheque.nontaxable_site_allow) as earnings,   

         sum(pr_cheque.vacation_paid  
				 + pr_cheque.vacation_lost  
				 - pr_cheque.vacation_earn) as vacation_owed,

         sum(pr_cheque.statutory_paid
				 + pr_cheque.statutory_lost
				 - pr_cheque.statutory_earn) as statutory_owed,

         sum(-2.0 * (pr_cheque.cpp_contribution + pr_cheque.cpp2_contribution)) as cpp,   

         sum(Round((-1.0 - :n_ei_contribution_rate) * pr_cheque.ei_premium, 2)) as ei,   

         sum(Round((-1.0 - :n_qpip_contribution_rate) * pr_cheque.qpip_premium, 2)) as qpip,   

         sum(-1.0 * pr_cheque.income_tax) as income_tax ,  

         sum(-1.0 * pr_cheque.insurance) as insurance ,

         sum(-1.0 * pr_cheque.training) as training,   

         sum(-1.0 * pr_cheque.recruitment_cost) as recruitment,   

         sum(pr_cheque.personal_safety_paid  
             + pr_cheque.personal_safety_lost   
         	 - pr_cheque.personal_safety_earn) as personal_safety,   

         sum(pr_cheque.group_safety_paid  
             + pr_cheque.group_safety_lost   
         	 - pr_cheque.group_safety_earn) as group_safety,   

         sum(pr_cheque.production_bonus_paid  
             + pr_cheque.production_bonus_lost   
         	 - pr_cheque.production_bonus_earn) as production_bonus,   

         sum(pr_cheque.staff_safety_paid  
             + pr_cheque.staff_safety_lost   
         	 - pr_cheque.staff_safety_earn) as staff_safety,   

         sum(pr_cheque.smtc_paid  
             + pr_cheque.smtc_lost   
         	 - pr_cheque.smtc_earn) as smtc,   

         sum(pr_cheque.incentive_paid  
             + pr_cheque.incentive_lost   
         	 - pr_cheque.incentive_earn) as incentive,   

         sum(pr_cheque.retention_paid  
             + pr_cheque.retention_lost   
         	 - pr_cheque.retention_earn) as retention,   

         sum(-1.0 * pr_cheque.charity) as charity,   

         sum(-1.0 * pr_cheque.security_deposit) as security_deposit,   

         sum(-1.0 * pr_cheque.province_education_tax) as province_education_tax,   

         sum(-1.0 * pr_cheque.province_payroll_tax) as province_payroll_tax,   

         sum(pr_cheque.cpp_contribution 
				 + pr_cheque.cpp2_contribution 
				 + Round(pr_cheque.ei_premium * :n_ei_contribution_rate, 2) 
				 + Round(pr_cheque.qpip_premium * :n_qpip_contribution_rate, 2) 
				 + pr_cheque.union_remittance  
				 + pr_cheque.wcb_remittance  
				 + pr_cheque.province_education_tax
				 + pr_cheque.vacation_earn  
				 + pr_cheque.statutory_earn
				 + pr_cheque.paid_sick_leave
 				 + pr_cheque.training  
				 + pr_cheque.employer_rrsp  
				 + pr_cheque.personal_safety_earn  
				 + pr_cheque.group_safety_earn  
				 + pr_cheque.production_bonus_earn  
				 + pr_cheque.staff_safety_earn  
				 + pr_cheque.smtc_earn  
				 + pr_cheque.incentive_earn  
				 + pr_cheque.union_rrsp_paid_out  
				 + pr_cheque.employer_rrsp_paid_out) as fringe

    FROM pr_cheque  
   WHERE pr_cheque.book 			= :as_book
     AND pr_cheque.file_type 		= 'C'    
     AND pr_cheque.transact_flag = 'N'   
     AND pr_cheque.cheque_status in ('P','R')    
     AND pr_cheque.pr_yyyymm = :s_pr_yyyymm     
" arguments=(("as_book", string),("s_pr_yyyymm", string),("n_ei_contribution_rate", number),("n_qpip_contribution_rate", number)) )
