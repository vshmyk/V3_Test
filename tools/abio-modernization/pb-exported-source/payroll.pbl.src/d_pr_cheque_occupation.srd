table(column=(type=char(1) updatewhereclause=yes name=action dbname="action" )
 column=(type=char(8) update=yes updatewhereclause=yes name=book dbname="pr_cheque_occupation.book" )
 column=(type=long update=yes updatewhereclause=yes name=cheque_no dbname="pr_cheque_occupation.cheque_no" )
 column=(type=char(5) update=yes updatewhereclause=yes name=trade_union dbname="pr_cheque_occupation.trade_union" )
 column=(type=datetime updatewhereclause=yes name=union_rate_effective_date dbname="pr_cheque_occupation.union_rate_effective_date" )
 column=(type=char(35) updatewhereclause=yes name=trade_union_trade_union_description dbname="trade_union.trade_union_description" )
 column=(type=char(5) update=yes updatewhereclause=yes name=occupation dbname="pr_cheque_occupation.occupation" )
 column=(type=char(35) updatewhereclause=yes name=occupation_occupation_description dbname="occupation.occupation_description" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=reg_hour dbname="pr_cheque_occupation.reg_hour" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=tah_hour dbname="pr_cheque_occupation.tah_hour" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=ovr_hour dbname="pr_cheque_occupation.ovr_hour" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=travel_hour dbname="pr_cheque_occupation.travel_hour" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=union_pension dbname="pr_cheque_occupation.union_pension" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=union_rrsp dbname="pr_cheque_occupation.union_rrsp" )
 column=(type=decimal(2) updatewhereclause=yes name=pr_cheque_occupation_employee_rrsp dbname="pr_cheque_occupation.employee_rrsp" )
 retrieve="  SELECT 'I' as action,
         ~"pr_cheque_occupation~".~"book~",   
         ~"pr_cheque_occupation~".~"cheque_no~",   
         ~"pr_cheque_occupation~".~"trade_union~",   
         ~"pr_cheque_occupation~".~"union_rate_effective_date~",   
         ~"trade_union~".~"description~" as trade_union_description,   
         ~"pr_cheque_occupation~".~"occupation~",   
         ~"occupation~".~"description~" as occupation_description,   
         ~"pr_cheque_occupation~".~"reg_hour~",   
         ~"pr_cheque_occupation~".~"tah_hour~",   
         ~"pr_cheque_occupation~".~"ovr_hour~",   
         ~"pr_cheque_occupation~".~"travel_hour~",   
         ~"pr_cheque_occupation~".~"union_pension~",   
         ~"pr_cheque_occupation~".~"union_rrsp~"  ,   
         ~"pr_cheque_occupation~".~"employee_rrsp~"  
    FROM ~"pr_cheque_occupation~" LEFT OUTER JOIN trade_union 
											 ON pr_cheque_occupation.book = trade_union.book
                                 AND pr_cheque_occupation.trade_union = trade_union.trade_union
										  LEFT OUTER JOIN occupation 
											 ON pr_cheque_occupation.book = occupation.book
                                 AND pr_cheque_occupation.trade_union = occupation.trade_union
                                 AND pr_cheque_occupation.occupation = occupation.occupation
" )
