text(band=detail alignment="1" text="release vacation pay?" border="0" color="33554432" x="59" y="16" height="60" width="713" html.valueishtml="0"  name=vpay_t visible="1"  font.face="Segoe UI" font.height="-9" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="1" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.tip="‘Y’es causes all accrued plus currently earned vacation pay to be released for each selected cheque. 
‘N’o causes no vacation pay to be released. 
‘L’ost – causes the accumulated vacation pay to be lost – it does not affect the current cheque vacation earnings. 
‘Q’uit – causes both the accumulated vacation  and current vacation  earned to be ‘lost’. 
" tooltip.transparency="0" transparency="0" )
text(band=detail alignment="1" text="release statutory pay?" border="0" color="33554432" x="55" y="184" height="60" width="713" html.valueishtml="0"  name=spay_t visible="1"  font.face="Segoe UI" font.height="-9" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="1" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.tip="‘Y’es causes all accrued plus currently earned statutory pay to be released for each selected cheque. 
‘N’o causes no statutory to be released. 
‘L’ost – causes the accumulated statutory pay to be lost – it does not affect the current cheque statutory earnings. 
‘Q’uit – causes both the accumulated statutory and current statutory earned to be ‘lost’. 
" tooltip.transparency="0" transparency="0" )
text(band=detail alignment="1" text="release personal safety?" border="0" color="33554432" x="59" y="352" height="60" width="713" html.valueishtml="0"  name=psaf_t visible="1"  font.face="Segoe UI" font.height="-9" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="1" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.tip="‘Y’es releases all accrued personal safety – it does not release personal safety earned by the current cheque. 
‘N’o – does not release any accrued personal safety. 
‘L’ost – causes the accumulated personal safety to be lost – it does not affect the current chequepersonal safety earnings. 
‘Q’uit – causes both the accumulated personal safety and current personal safety earned to be ‘lost’. 
" tooltip.transparency="0" transparency="0" )
text(band=detail alignment="1" text="release group safety?" border="0" color="33554432" x="55" y="520" height="60" width="713" html.valueishtml="0"  name=gsaf_t visible="1"  font.face="Segoe UI" font.height="-9" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="1" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.tip="‘Y’es releases all accrued group safety – it does not release group safety earned by the current cheque. 
‘N’o – does not release any accrued group safety. 
‘L’ost – causes the accumulated group safety to be lost – it does not affect the current cheque group safety earnings. 
‘Q’uit – causes both the accumulated group safety and current group safety earned to be ‘lost’. 
" tooltip.transparency="0" transparency="0" )
text(band=detail alignment="1" text="release other safety?" border="0" color="33554432" x="55" y="688" height="60" width="713" html.valueishtml="0"  name=osaf_t visible="1"  font.face="Segoe UI" font.height="-9" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="1" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.tip="‘Y’es releases all accrued other safety amounts – it does not release other safety earned by the current cheque. 
‘O’ne quarter - releases 25% of accrued other safety amounts – it does not release other safety earned by the current cheque. 
‘H’alf - releases 50% of accrued other safety amounts – it does not release other safety earned by the current cheque. 
‘T’hree quarters - releases 75% of accrued other safety amounts – it does not release other safety earned by the current cheque. 
‘N’o – does not release any accrued other safety. 
‘L’ost – causes the accumulated other safety to be lost – it does not affect the current cheque other safety earnings. 
‘Q’uit – causes both the accumulated other safety and current other safety earned to be ‘lost’. 
" tooltip.transparency="0" transparency="0" )
text(band=detail alignment="1" text="release small tools?" border="0" color="33554432" x="55" y="856" height="60" width="713" html.valueishtml="0"  name=smtc_t visible="1"  font.face="Segoe UI" font.height="-9" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="1" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.tip="‘Y’es releases all of the accrued small tools.
‘A’ll – releases all accrued and current small tool. 
‘Q’uit – causes all accrued and current small tool to be lost. 
‘N’o – does nothing. " tooltip.transparency="0" transparency="0" )
text(band=detail alignment="1" text="release retention?" border="0" color="33554432" x="55" y="1024" height="60" width="713" html.valueishtml="0"  name=ret_t visible="1"  font.face="Segoe UI" font.height="-9" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="1" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.tip="‘Y’es releases 30% of the accrued retention. 
