 retrieve="  SELECT 'I' as action,
			0 as cc_datawindow_height,
         ~"pr_cheque_trade_union~".~"book~",   
         ~"pr_cheque_trade_union~".~"cheque_no~",   
         ~"pr_cheque_trade_union~".~"trade_union~",   
         ~"pr_cheque_trade_union~".~"union_rate_effective_date~",   
         ~"pr_cheque_trade_union~".~"reg_hour~",   
         ~"pr_cheque_trade_union~".~"tah_hour~",   
         ~"pr_cheque_trade_union~".~"ovr_hour~",   
         ~"pr_cheque_trade_union~".~"travel_hour~",   
         ~"pr_cheque_trade_union~".~"reg_earn~",   
         ~"pr_cheque_trade_union~".~"tah_earn~",   
         ~"pr_cheque_trade_union~".~"ovr_earn~",   
         ~"pr_cheque_trade_union~".~"travel_earn~",   
         ~"pr_cheque_trade_union~".~"earnings_type~",   
         ~"pr_cheque_trade_union~".~"all_hr_reg_earn~",   
         ~"pr_cheque_trade_union~".~"all_hr_base_earn~",   
         ~"pr_cheque_trade_union~".~"pension_source_earn~",   
         ~"pr_cheque_trade_union~".~"rrsp_source_earn~",   
         ~"pr_cheque_trade_union~".~"dues_source_earn~",   
         ~"pr_cheque_trade_union~".~"vacation_source_earn~",   
         ~"pr_cheque_trade_union~".~"statutory_source_earn~",   
         ~"pr_cheque_trade_union~".~"union_pension~",   
         ~"pr_cheque_trade_union~".~"union_rrsp~",   
         ~"pr_cheque_trade_union~".~"union_rrsp_paid_out~",   
         ~"pr_cheque_trade_union~".~"employer_rrsp_paid_out~",   
         ~"pr_cheque_trade_union~".~"vacation_earn~",   
         ~"pr_cheque_trade_union~".~"vacation_paid_to_union~",   
         ~"pr_cheque_trade_union~".~"statutory_earn~",   
         ~"pr_cheque_trade_union~".~"statutory_paid_to_union~",   
         ~"pr_cheque_trade_union~".~"paid_sick_leave~",   
         ~"pr_cheque_trade_union~".~"union_dues~",   
         ~"pr_cheque_trade_union~".~"union_remittance~",   
         ~"pr_cheque_trade_union~".~"employee_pension~",   
         ~"pr_cheque_trade_union~".~"employee_rrsp~",   
         ~"trade_union_rate~".~"vacation_pay_type~",   
         ~"trade_union_rate~".~"statutory_pay_type~",   
         ~"trade_union_rate~".~"dues_type~",   
         ~"trade_union_rate~".~"remit_earning_type~"
    FROM ~"pr_cheque_trade_union~" LEFT OUTER JOIN ~"pr_cheque~" 
                                   ON pr_cheque.book = pr_cheque_trade_union.book
                                  AND pr_cheque.cheque_no = pr_cheque_trade_union.cheque_no
   										LEFT OUTER JOIN ~"trade_union_rate~" 
                                   ON trade_union_rate.book = pr_cheque.book
                                  AND trade_union_rate.trade_union = pr_cheque_trade_union.trade_union
                                  AND pr_cheque.issue_date BETWEEN trade_union_rate.effective_date 
                                                               AND trade_union_rate.expiry_date 

  
" update="pr_cheque_trade_union" updatewhere=0 updatekeyinplace=no )
