table(column=(type=char(8) updatewhereclause=yes key=yes name=book dbname="employee.book" dbalias=".book" )
 column=(type=long updatewhereclause=yes key=yes name=employee dbname="employee.employee" dbalias=".employee" )
 column=(type=char(25) updatewhereclause=yes name=name dbname="employee.name" dbalias=".name" )
 column=(type=char(20) updatewhereclause=yes name=given_name dbname="employee.given_name" dbalias=".given_name" )
 column=(type=char(20) updatewhereclause=yes name=surname dbname="employee.surname" dbalias=".surname" )
 column=(type=char(9) updatewhereclause=yes name=ccra_business_no dbname="employee.ccra_business_no" dbalias=".ccra_business_no" )
 column=(type=char(9) updatewhereclause=yes name=sin dbname="employee.sin" dbalias=".sin" )
 column=(type=char(20) updatewhereclause=yes name=mailing_city dbname="employee.mailing_city" dbalias=".mailing_city" )
 column=(type=char(2) updatewhereclause=yes name=mailing_province dbname="employee.mailing_province" dbalias=".mailing_province" )
 column=(type=char(3) updatewhereclause=yes name=mailing_country dbname="employee.mailing_country" dbalias=".mailing_country" )
 column=(type=char(10) updatewhereclause=yes name=mailing_postal dbname="employee.mailing_postal" dbalias=".mailing_postal" )
 column=(type=char(10) updatewhereclause=yes name=phone dbname="employee.phone" dbalias=".phone" )
 column=(type=char(255) updatewhereclause=yes name=trade dbname="employee.trade" dbalias=".trade" )
 column=(type=char(5) updatewhereclause=yes name=trade_union dbname="employee.trade_union" dbalias=".trade_union" )
 column=(type=char(5) updatewhereclause=yes name=occupation dbname="employee.occupation" dbalias=".occupation" )
 column=(type=datetime updatewhereclause=yes name=hire_date dbname="employee.hire_date" dbalias=".hire_date" )
 column=(type=datetime updatewhereclause=yes name=termination_date dbname="employee.termination_date" dbalias=".termination_date" )
 column=(type=char(1) updatewhereclause=yes name=garnishee_flag dbname="employee.garnishee_flag" dbalias=".garnishee_flag" )
 column=(type=char(1) updatewhereclause=yes name=file_type dbname="employee.file_type" dbalias=".file_type" )
 column=(type=char(1) updatewhereclause=yes name=restrict_flag dbname="employee.restrict_flag" dbalias=".restrict_flag" )
 column=(type=char(3) updatewhereclause=yes name=wcb_class dbname="employee.wcb_class" dbalias=".wcb_class" )
 column=(type=char(1) updatewhereclause=yes name=employment_type dbname="employee.employment_type" dbalias=".employment_type" )
 column=(type=char(6) updatewhereclause=yes name=region dbname="employee.region" dbalias=".region" )
 column=(type=char(1) updatewhereclause=yes name=active dbname="employee.active" dbalias=".active" )
 column=(type=char(1) updatewhereclause=yes name=owing dbname="employee.owing" dbalias=".owing" )
 column=(type=char(1) updatewhereclause=yes name=exempt dbname="employee.exempt" dbalias=".exempt" )
 column=(type=char(8000) updatewhereclause=yes name=premium dbname="employee.premium" dbalias=".premium" )
 column=(type=long updatewhereclause=yes name=rollover_bit dbname="rollover_bit" )
 retrieve="SELECT book,
		 employee,
		 name,
		 given_name,
		 surname,
		 ccra_business_no,	
		 sin,
		 mailing_city,   
		 mailing_province,   
		 mailing_country,   
		 mailing_postal,   
		 phone,
		 trade, 
		 trade_union,
		 occupation,
		 hire_date,
		 termination_date,
		 garnishee_flag,
		 file_type,
		 restrict_flag,
		 wcb_class,
		 employment_type,
		 region,
		 active,
		 owing,
		 exempt,
       premium, CONVERT(INT,0) AS rollover_bit
FROM			
	(
		SELECT
			employee.book,
			employee.employee,   
			employee.name,   
			person.given_name,
			person.surname,
			person.ccra_business_no,
			person.sin,
			person.mailing_city,   
			person.mailing_province,   
			person.mailing_country,   
			person.mailing_postal,   
			person.phone,
			person.trade, 
			employee.trade_union,
			employee.occupation,
			employee.hire_date,
			employee.termination_date,
			employee.garnishee_flag,
			employee.file_type,
			employee.restrict_flag,
			employee.wcb_class,
			employee.region,
			employee.employment_type,
        (CASE LEN(SUBSTRING(CAST(employee.termination_date as VARCHAR),1,10))
			WHEN 10 THEN 'N'
			ELSE 'Y'
		   END) as active,
		  (CASE (advance_repay + personal_safety_owed + smtc_owed + vacation_owed + statutory_owed + group_safety_owed + staff_safety_owed + incentive_owed) 
			WHEN 0 THEN 'N'
			ELSE 'Y'
			END) as owing,
            employee.ei_exempt_flag,
			employee.cpp_exempt_flag,
			employee.income_tax_exempt_flag,
			(CASE PATINDEX('%Y%',(employee.ei_exempt_flag + employee.cpp_exempt_flag + employee.income_tax_exempt_flag)) 
				WHEN 0 THEN (CASE WHEN employee.cpp_exempt_effective_date IS NULL THEN 'N' ELSE 'Y' END)
				ELSE 'Y'
			END) as exempt,
		   dbo.uf_employee_premiums(employee.book, employee.employee) premium  
		 FROM employee,
			 (SELECT person.employee,   
						person.name,   
						person.surname,   
						person.given_name,   
						person.mailing_city,   
						person.mailing_province,   
						person.mailing_country,   
						person.mailing_postal,   
						person.email,   
						person.birth_date,   
						person.phone,
						person.sin,
						person.ccra_business_no,
						dbo.uf_person_trades(person.employee) as trade 
				 FROM person 
			) person 
		WHERE person.employee = employee.employee
	)  employee  " update="employee" updatewhere=0 updatekeyinplace=no  sort="surname A given_name A " )
