         pr_cheque.memo,
			pr_cheque.union_rrsp_paid_out,
         pr_cheque.employer_rrsp_paid_out,
         pr_cheque.province_education_tax,
         pr_cheque.province_payroll_tax,
         pr_cheque.paid_sick_leave,
         (select count(1) from pr_cheque_trade_union where pr_cheque_trade_union.book = pr_cheque.book and pr_cheque_trade_union.cheque_no = pr_cheque.cheque_no) as cc_tu_count, 
         (select count(1) from pr_cheque_occupation where pr_cheque_occupation.book = pr_cheque.book and pr_cheque_occupation.cheque_no = pr_cheque.cheque_no) as cc_occ_count
    FROM pr_cheque
" )
