table(column=(type=char(8) updatewhereclause=yes name=book dbname="book" )
 column=(type=datetime updatewhereclause=yes name=work_date dbname="work_date" )
 column=(type=long updatewhereclause=yes name=field_timesheet_item dbname="field_timesheet_item" )
 column=(type=char(5000) updatewhereclause=yes name=note dbname="note" )
 column=(type=char(1) updatewhereclause=yes name=file_type dbname="file_type" )
 column=(type=char(8) updatewhereclause=yes name=add_user_id dbname="add_user_id" )
 column=(type=datetime updatewhereclause=yes name=add_datetime dbname="add_datetime" )
 column=(type=long updatewhereclause=yes identity=yes name=count_all dbname="count_all" )
 column=(type=long updatewhereclause=yes identity=yes name=count_p dbname="count_p" )
 column=(type=long updatewhereclause=yes name=count_r dbname="count_r" )
 column=(type=long updatewhereclause=yes identity=yes name=rollover_bit dbname="rollover_bit" )
 column=(type=char(14) updatewhereclause=yes name=status dbname="status" )
 column=(type=char(25) updatewhereclause=yes name=name dbname="name" )
 retrieve="SELECT field_timesheet.book, 
       field_timesheet.work_date, 
       field_timesheet.field_timesheet_item, 
       field_timesheet.note, 
       field_timesheet.file_type, 
       field_timesheet.add_user_id, 
       field_timesheet.add_datetime, 
       ISNULL(ts_count.count_all, 0)     AS count_all, 
       ISNULL(prelim_count.count_p, 0)   AS count_p,
       ISNULL(reject_count.count_r, 0)   AS count_r,
       CONVERT(INT, 0)                   AS rollover_bit, 
       (CASE 
           WHEN ISNULL(reject_count.count_r, 0) > 0 THEN 'Has Rejections'
           WHEN ISNULL(prelim_count.count_p, 0) = 0 THEN 'Completed' 
           ELSE 'In Progress' 
        END)                             AS status,
       ISNULL(abio_user.name, field_timesheet.add_user_id) AS name 
FROM   field_timesheet 
       LEFT OUTER JOIN abio_user
         ON abio_user.user_id = field_timesheet.add_user_id
       LEFT OUTER JOIN (SELECT ts_c.book, 
                               ts_c.work_date, 
                               ts_c.add_user_id, 
                               ts_c.field_timesheet_item, 
                               COUNT(1) AS count_all 
                        FROM   timesheet ts_c 
                        GROUP  BY ts_c.book, 
                                  ts_c.work_date, 
                                  ts_c.add_user_id, 
                                  ts_c.field_timesheet_item) ts_count 
                    ON ts_count.book = field_timesheet.book 
                       AND ts_count.work_date = field_timesheet.work_date 
                       AND ts_count.add_user_id = field_timesheet.add_user_id 
                       AND ts_count.field_timesheet_item = field_timesheet.field_timesheet_item 
       LEFT OUTER JOIN (SELECT ts_p.book, 
                               ts_p.work_date, 
                               ts_p.add_user_id, 
                               ts_p.field_timesheet_item, 
                               ts_p.file_type AS dummy, 
                               COUNT(1) AS count_p 
                        FROM   timesheet ts_p 
                        GROUP  BY ts_p.book, 
                                  ts_p.work_date, 
                                  ts_p.add_user_id, 
                                  ts_p.field_timesheet_item, 
                                  ts_p.file_type 
                        HAVING ts_p.file_type = 'P') prelim_count 
                    ON prelim_count.book = field_timesheet.book 
                       AND prelim_count.work_date = field_timesheet.work_date 
                       AND prelim_count.add_user_id = field_timesheet.add_user_id 
                       AND prelim_count.field_timesheet_item = field_timesheet.field_timesheet_item
       LEFT OUTER JOIN (SELECT ts_r.book, 
                               ts_r.work_date, 
                               ts_r.add_user_id, 
                               ts_r.field_timesheet_item, 
                               ts_r.file_type AS dummy, 
                               COUNT(1) AS count_r 
                        FROM   timesheet ts_r 
                        GROUP  BY ts_r.book, 
                                  ts_r.work_date, 
                                  ts_r.add_user_id, 
                                  ts_r.field_timesheet_item, 
                                  ts_r.file_type 
                        HAVING ts_r.file_type = 'R') reject_count 
                    ON reject_count.book = field_timesheet.book 
                       AND reject_count.work_date = field_timesheet.work_date 
                       AND reject_count.add_user_id = field_timesheet.add_user_id 
                       AND reject_count.field_timesheet_item = field_timesheet.field_timesheet_item"  sort="work_date A field_timesheet_item A " )
