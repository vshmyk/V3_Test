         pr_cheque.ovr_premium_fringe,   
         pr_cheque.gst_amount,   
         pr_cheque.monthly_dues,   
         pr_cheque.last_month_with_dues,   
         pr_cheque.last_daily_dues_date,   
         pr_cheque.last_taxable_benefit_month,   
         pr_cheque.pay_period_start_date,   
         pr_cheque.issue_date,   
         pr_cheque.reconcile_date,   
         pr_cheque.extract_datetime,   
         pr_cheque.eft_date,   
         pr_cheque.eft_batch,   
         pr_cheque.eft_institution,   
         pr_cheque.eft_branch,   
         pr_cheque.eft_account,   
         pr_cheque.eft_us_routing,   
         pr_cheque.approval_1,   
         pr_cheque.approval_2,   
         pr_cheque.cheque_status,   
         pr_cheque.form_no,   
         pr_cheque.pr_yyyymm,   
         pr_cheque.transact_flag,   
         pr_cheque.trade_union,   
         pr_cheque.tax_province,   
         pr_cheque.void_cheque_no,   
         pr_cheque.transact_datetime,   
         pr_cheque.employment_type,   
         pr_cheque.restrict_flag,   
         pr_cheque.file_type,   
         pr_cheque.add_user_id,   
         pr_cheque.add_datetime,   
         pr_cheque.shift_premium,   
         pr_cheque.shift_premium_fringe,   
         pr_cheque.last_monthly_remit_month,   
         pr_cheque.vehicle_allowance_paid,   
         pr_cheque.taxable_benefit_gas,   
         pr_cheque.taxable_benefit_vehicle,   
         pr_cheque.pay_in_lieu_of_notice,   
         pr_cheque.vacation_lost,   
         pr_cheque.statutory_lost,   
         pr_cheque.production_bonus_earn,   
         pr_cheque.production_bonus_paid,   
         pr_cheque.production_bonus_lost,   
         pr_cheque.production_bonus_owed,
         'Y' as protect_earn_tab,   
         pr_cheque.back_dues,   
         pr_cheque.daily_dues,   
         pr_cheque.weekly_dues,   
         pr_cheque.vacation_paid_to_union,   
         pr_cheque.statutory_paid_to_union,   
         pr_cheque.last_weekly_dues_paid_date,
         pr_cheque.vacation_source_earn,  
         pr_cheque.statutory_source_earn,  
         pr_cheque.rrsp_source_earn,  
         pr_cheque.pension_source_earn,  
         pr_cheque.dues_source_earn,  
         pr_cheque.vacation_hours_paid,  
         pr_cheque.statutory_hours_paid,
         trade_union_rate.dues_type,
         trade_union_rate.vacation_pay_type,
         trade_union_rate.statutory_pay_type,
         trade_union_rate.include_travel_flag,
         trade_union.staff_flag,
         trade_union.change_allowed_on_ck_empr_rrsp_flag,
         employee.employment_type,
         employee.rrsp_vendor,
         pr_cheque.memo,
         pr_cheque.vacation_hours_earn,   
         pr_cheque.vacation_hours_owed,   
         pr_cheque.vacation_hours_lost,   
         pr_cheque.add_to_union_remittance,   
         pr_cheque.union_remittance + pr_cheque.admin_fee + pr_cheque.union_dues + pr_cheque.back_dues + pr_cheque.daily_dues 
			+ pr_cheque.weekly_dues + pr_cheque.monthly_dues + pr_cheque.employee_pension 
			+ pr_cheque.vacation_paid_to_union + pr_cheque.statutory_paid_to_union 
			+ pr_cheque.employee_pension + pr_cheque.incentive_paid_to_rrsp as total_remittance,
			pr_cheque.union_rrsp_paid_out,
         pr_cheque.employer_rrsp_paid_out,
         pr_cheque.province_education_tax,
         pr_cheque.province_payroll_tax,
         pr_cheque.qpip_earn,
         pr_cheque.qpip_premium,
			dbo.fn_union_remit_tooltip(pr_cheque.book, pr_cheque.cheque_no) as union_remit_desc
    FROM pr_cheque LEFT OUTER JOIN trade_union_rate ON 	( pr_cheque.book = trade_union_rate.book ) and  
																				( pr_cheque.trade_union = trade_union_rate.trade_union )  and  
																				( trade_union_rate.effective_date <= pr_cheque.issue_date ) and  
																				( trade_union_rate.expiry_date >= pr_cheque.issue_date ), 
			employee, trade_union 
   WHERE 
			( pr_cheque.book = trade_union.book ) and  
         ( pr_cheque.trade_union = trade_union.trade_union )  and  
			( pr_cheque.book = employee.book ) and  
         ( pr_cheque.employee = employee.employee )    
" update="pr_cheque" updatewhere=0 updatekeyinplace=no )
