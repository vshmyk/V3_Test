table(column=(type=char(8) updatewhereclause=yes name=book dbname="book" )
 column=(type=char(1) updatewhereclause=yes name=restrict_flag dbname="restrict_flag" )
 column=(type=long updatewhereclause=yes name=employee dbname="employee" )
 column=(type=char(25) updatewhereclause=yes name=person_name dbname="NAME" )
 column=(type=datetime updatewhereclause=yes name=work_date dbname="work_date" )
 column=(type=long updatewhereclause=yes name=timesheet_item dbname="timesheet_item" )
 column=(type=char(6) updatewhereclause=yes name=job dbname="job" )
 column=(type=char(5) updatewhereclause=yes name=area dbname="area" )
 column=(type=char(6) updatewhereclause=yes name=centre dbname="centre" )
 column=(type=char(8) updatewhereclause=yes name=equipment dbname="equipment" )
 column=(type=char(6) updatewhereclause=yes name=gl_account dbname="gl_account" )
 column=(type=char(5) updatewhereclause=yes name=trade_union dbname="trade_union" )
 column=(type=char(5) updatewhereclause=yes name=occupation dbname="occupation" )
 column=(type=char(1) updatewhereclause=yes name=shift dbname="shift" )
 column=(type=decimal(2) updatewhereclause=yes name=reg_hour dbname="reg_hour" )
 column=(type=decimal(2) updatewhereclause=yes name=tah_hour dbname="tah_hour" )
 column=(type=decimal(2) updatewhereclause=yes name=ovr_hour dbname="ovr_hour" )
 column=(type=decimal(2) updatewhereclause=yes name=total dbname="total" )
 column=(type=char(1) updatewhereclause=yes name=file_type dbname="file_type" )
 column=(type=long updatewhereclause=yes name=cheque_no dbname="cheque_no" )
 column=(type=char(3) updatewhereclause=yes name=wcb_class dbname="wcb_class" )
 column=(type=char(1) updatewhereclause=yes name=timesheet_status dbname="timesheet_status" )
 column=(type=char(1) updatewhereclause=yes name=transact_flag dbname="transact_flag" )
 column=(type=char(8000) updatewhereclause=yes name=premium_type dbname="premium_type" )
 column=(type=datetime updatewhereclause=yes name=add_datetime dbname="add_datetime" )
 column=(type=datetime updatewhereclause=yes name=transact_datetime dbname="transact_datetime" )
 column=(type=char(100) updatewhereclause=yes name=memo dbname="memo" )
 column=(type=char(12) updatewhereclause=yes name=billing_no dbname="billing_no" )
 column=(type=char(16) updatewhereclause=yes name=ar_invoice_no dbname="ar_invoice_no" )
 column=(type=long updatewhereclause=yes identity=yes name=rollover_bit dbname="rollover_bit" )
 retrieve="SELECT TOP 2000 
    book, restrict_flag, employee, NAME, work_date, timesheet_item, 
    job, area, centre, equipment, gl_account, trade_union, occupation, 
    shift, reg_hour, tah_hour, ovr_hour, total, file_type, cheque_no, 
    wcb_class, timesheet_status, transact_flag, premium_type, add_datetime, 
    transact_datetime, memo, billing_no, ar_invoice_no, CONVERT(INT, 0) AS rollover_bit 
FROM (
    SELECT 
        timesheet.book, 
        timesheet.restrict_flag, 
        timesheet.employee, 
        person.name AS NAME, 
        timesheet.work_date, 
        timesheet.timesheet_item, 
        timesheet.job, 
        timesheet.area, 
        timesheet.centre, 
        timesheet.equipment, 
        timesheet.gl_account, 
        timesheet.trade_union, 
        timesheet.occupation, 
        timesheet.shift, 
        timesheet.reg_hour, 
        timesheet.ovr_hour, 
        timesheet.tah_hour, 
        timesheet.total, 
        timesheet.file_type, 
        timesheet.cheque_no, 
        timesheet.wcb_class, 
        timesheet.timesheet_status, 
        timesheet.transact_flag, 
        dbo.Uf_timesheet_premiums(timesheet.book, timesheet.employee, timesheet.work_date, timesheet.timesheet_item) premium_type, 
        timesheet.add_datetime, 
        timesheet.transact_datetime, 
        timesheet.memo, 
        IsNull(timesheet.billing_no, ld_max.billing_no) as billing_no, 
        ar_billing.invoice_no as ar_invoice_no 
    FROM timesheet 
    LEFT OUTER JOIN person 
        ON timesheet.employee = person.employee 
    LEFT OUTER JOIN (
        SELECT 
            book, employee, work_date, timesheet_item, billing_no,
            ROW_NUMBER() OVER (PARTITION BY book, employee, work_date, timesheet_item 
                               ORDER BY dispersion_item DESC) as rn
        FROM labour_dispersion
    ) ld_max 
        ON timesheet.book = ld_max.book 
        AND timesheet.employee = ld_max.employee 
        AND timesheet.work_date = ld_max.work_date 
        AND timesheet.timesheet_item = ld_max.timesheet_item 
        AND ld_max.rn = 1
    LEFT OUTER JOIN ar_billing 
        ON timesheet.book = ar_billing.book 
        AND IsNull(timesheet.billing_no, ld_max.billing_no) = ar_billing.billing_no 
) timesheet " )
