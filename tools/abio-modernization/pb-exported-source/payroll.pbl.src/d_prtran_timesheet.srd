 retrieve="  SELECT 0 as gst,   
         timesheet.employee,   
         timesheet.work_date,   
         timesheet.timesheet_item,   
         timesheet.job,   
         timesheet.area,   
         timesheet.centre,   
         timesheet.equipment,   
         timesheet.gl_account,   
         timesheet.division,   
         timesheet.trade_union,   
         timesheet.occupation,   
         timesheet.wcb_class,   
         timesheet.gst_rule,   
         timesheet.shift,   
         timesheet.memo,   
         timesheet.pr_yyyymm,   
         timesheet.transact_flag,   
         timesheet.reg_hour,   
         timesheet.tah_hour,   
         timesheet.ovr_hour,   
         timesheet.travel_hour,   
         timesheet.loa_hour,   
         timesheet.mileage_hour,   
         timesheet.reg_rate,   
         timesheet.tah_rate,   
         timesheet.ovr_rate,   
         timesheet.loa_rate,   
         timesheet.mileage_rate,   
         timesheet.travel_rate,   
         timesheet.reg_earn,   
         timesheet.tah_earn,   
         timesheet.ovr_earn,   
         timesheet.travel_earn,   
         timesheet.loa,   
         timesheet.mileage,   
         timesheet.turnaround,   
         timesheet.site_allowance,   
         timesheet.taxi,   
         timesheet.meal,   
         timesheet.retro,   
         timesheet.other_taxable_pay,   
         timesheet.total,   
         (SELECT sum(tp.reg_earn + tp.tah_earn + tp.ovr_earn) 
            FROM timesheet_premium tp,
                 premium_type pt 
           WHERE tp.book = timesheet.book 
             AND tp.employee = timesheet.employee 
             AND tp.work_date = timesheet.work_date 
             AND tp.timesheet_item = timesheet.timesheet_item
             AND tp.premium_type = pt.premium_type
             AND (pt.shift_2_flag = 'Y' OR pt.shift_3_flag = 'Y')) as shift_premium,  
         timesheet.fringe,   
         timesheet.gst_amount,   
         timesheet.cheque_no,   
         timesheet.transact_datetime,   
         timesheet.employment_type,   
         timesheet.restrict_flag,   
         timesheet.book,   
         timesheet.file_type,   
         timesheet.vehicle_allowance_paid,
         timesheet.pay_in_lieu_of_notice,
         timesheet.tah_spot_flag,
         timesheet.ovr_spot_flag,
         timesheet.retention_earn,
         timesheet.recruitment_cost,
			timesheet.billing_no,
			timesheet.billing_item
    FROM timesheet  
   WHERE ( timesheet.book = :as_book ) AND  
         ( timesheet.cheque_no = :al_cheque )    
" update="timesheet" updatewhere=0 updatekeyinplace=yes arguments=(("as_book", string),("al_cheque", number)) )
