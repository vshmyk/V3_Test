 column=(type=decimal(2) updatewhereclause=yes name=cc_total dbname="cc_total" )
 retrieve="  SELECT 'I' as action,
         ~"pr_cheque_premium~".~"book~",   
         ~"pr_cheque_premium~".~"cheque_no~",   
         ~"pr_cheque_premium~".~"premium_type~",   
         ~"premium_type~".~"description~",   
         ~"pr_cheque_premium~".~"reg_earn~",   
         ~"pr_cheque_premium~".~"tah_earn~",   
         ~"pr_cheque_premium~".~"ovr_earn~",
  			~"pr_cheque_premium~".~"reg_earn~"+~"pr_cheque_premium~".~"tah_earn~"+~"pr_cheque_premium~".~"ovr_earn~" as cc_total
    FROM ~"pr_cheque_premium~" ,   
         ~"premium_type~"  
   WHERE ( ~"premium_type~".~"premium_type~" = ~"pr_cheque_premium~".~"premium_type~" )    
" )
