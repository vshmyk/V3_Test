<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AOtransactPostgreSQL</AssemblyName>
    <RootNamespace>AOtransactPostgreSQL</RootNamespace>
    <Version>2.0.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <EmbeddedResource Include="..\THIRD-PARTY-NOTICES.md"
                      LogicalName="AOtransactPostgreSQL.ThirdPartyNotices" />
    <EmbeddedResource Include="..\Capture-PostgreSQLLogicalBatch.ps1"
                      Link="Scripts\Capture-PostgreSQLLogicalBatch.ps1"
                      LogicalName="AOtransactPostgreSQL.Capture-PostgreSQLLogicalBatch.ps1" />
    <EmbeddedResource Include="..\Configure-AOtransactPostgreSQL.ps1"
                      Link="Scripts\Configure-AOtransactPostgreSQL.ps1"
                      LogicalName="AOtransactPostgreSQL.Configure-AOtransactPostgreSQL.ps1" />
  </ItemGroup>
</Project>
