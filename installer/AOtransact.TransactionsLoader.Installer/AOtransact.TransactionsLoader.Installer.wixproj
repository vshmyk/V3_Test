<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>AOtransact.TransactionsLoader.Installer</OutputName>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>PublishDir=$(MSBuildThisFileDirectory)..\..\artifacts\publish\transactions-loader;ToolsDir=$(MSBuildThisFileDirectory)..\..\tools\transactions-loader</DefineConstants>
  </PropertyGroup>
</Project>
